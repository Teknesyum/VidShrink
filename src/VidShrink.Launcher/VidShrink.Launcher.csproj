<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VidShrink</AssemblyName>
    <RootNamespace>VidShrink.Launcher</RootNamespace>
    <ApplicationIcon>..\VidShrink.App\Assets\VidShrink.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VidShrink.Core\VidShrink.Core.csproj" />
  </ItemGroup>

  <!-- Bekleme panelinin görüntüsü elle hazırlanmıyor: her derlemede Theme.axaml'dan
       üretiliyor. Tema değişince görüntü de değişir, sessizce eskimez. -->
  <PropertyGroup>
    <SplashTheme>$(MSBuildThisFileDirectory)..\VidShrink.App\Themes\Theme.axaml</SplashTheme>
    <SplashGenProject>$(MSBuildThisFileDirectory)..\..\tools\VidShrink.SplashGen\VidShrink.SplashGen.csproj</SplashGenProject>
    <SplashImage>$(BaseIntermediateOutputPath)splash.png</SplashImage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(SplashImage)" LogicalName="VidShrink.Launcher.splash.png" Visible="false" />
  </ItemGroup>

  <Target Name="GenerateSplashImage" BeforeTargets="BeforeBuild"
          Inputs="$(SplashTheme);$(MSBuildThisFileDirectory)..\..\tools\VidShrink.SplashGen\Program.cs"
          Outputs="$(SplashImage)">
    <!-- Restore önce, ayrı bir çağrı olarak. Çözüm derlenirken geri yükleme çözüm
         genelinden geliyordu ve bu adım gereksiz görünüyordu; kurulum betiği başlatıcıyı
         tek başına yayımlayınca SplashGen hiç geri yüklenmemiş oluyor ve derleme
         NETSDK1004 ile düşüyor. Kurulum bu yüzden bir tur bozuldu. -->
    <MSBuild Projects="$(SplashGenProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(SplashGenProject)" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="SplashGenAssembly" />
    </MSBuild>
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;%(SplashGenAssembly.FullPath)&quot; &quot;$(SplashTheme)&quot; &quot;$(SplashImage)&quot;" />
  </Target>

</Project>
