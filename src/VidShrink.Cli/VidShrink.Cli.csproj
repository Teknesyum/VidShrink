<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>vidshrink</AssemblyName>
    <RootNamespace>VidShrink.Cli</RootNamespace>
    <Description>VidShrink command line</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <AssemblyName>vidshrink-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Locales\*.json" LogicalName="VidShrink.Cli.Locales.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VidShrink.Core\VidShrink.Core.csproj" />
    <ProjectReference Include="..\VidShrink.Ffmpeg\VidShrink.Ffmpeg.csproj" />
  </ItemGroup>

</Project>
