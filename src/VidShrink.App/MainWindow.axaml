<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        x:Class="VidShrink.App.MainWindow"
        Title="VidShrink"
        Width="1560" Height="1060" MinWidth="1040" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}"
        Foreground="{StaticResource TextBody}">

  <Window.Styles>
    <Style Selector="Window.reduced-motion Button">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Border.enter">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Ellipse">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Path">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
  </Window.Styles>

  <Border x:Name="WindowShell"
          Background="{StaticResource WorkspaceBackground}"
          BorderBrush="{StaticResource NeonBlue}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusControl}"
          UseLayoutRounding="True">
    <Grid RowDefinitions="Auto,Auto,*">

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Height="{StaticResource TitleBarHeight}"
              Background="{StaticResource TitleBarBackground}"
              BorderBrush="{StaticResource NeonBlueBorderStrong}"
              BorderThickness="0,0,0,1">
        <Grid x:Name="TitleBarContent" Margin="16,0,12,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceXl}">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
            <Image x:Name="AppLogo" Width="24" Height="24" Stretch="Uniform" IsVisible="False"/>
            <TextBlock x:Name="TxtAppName" Theme="{StaticResource H2}" VerticalAlignment="Center">
              <Run Text="Vid"/><Run Text="Shrink" Foreground="{StaticResource PinkText}"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1"
                      x:Name="TaglineRow"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      ClipToBounds="True">
            <TextBlock x:Name="TaglineLead" Text="Target size media compression" Theme="{StaticResource ProductTagline}"/>
            <TextBlock x:Name="TaglineSeparator" Text=" &amp; " Theme="{StaticResource ProductTagline}" Foreground="{StaticResource TextBody}"/>
            <TextBlock x:Name="TaglineConverter" Text="Media converter" Theme="{StaticResource ProductTagline}" Foreground="{StaticResource NeonPink}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnSponsor" Theme="{StaticResource TitleBarSupportButton}" auto:AutomationProperties.Name="Buy Me a Coffee" Click="OnOpenSponsor">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <!-- The two empty MoveTo commands pin the icon's own 24x24 design box, so Uniform
                     scales that box instead of the ink. Without them the stretch centres the ink,
                     and because the steam sits above the cup the cup itself landed below the text.
                     Inside the box the drawing is raised so the cup body is what the box centres. -->
                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M 0 0 M 24 24 M 5 6.5 L 5 14.5 A 3 3 0 0 0 8 17.5 L 13 17.5 A 3 3 0 0 0 16 14.5 L 16 6.5 Z M 16 8.5 L 18 8.5 A 2.5 2.5 0 0 1 18 13.5 L 16 13.5 M 8 0.5 L 8 3.5 M 12 0.5 L 12 3.5"/>
                <TextBlock x:Name="TxtSponsor" Text="Buy Me a Coffee" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnGitHub" Theme="{StaticResource TitleBarLinkButton}" auto:AutomationProperties.Name="Teknesyum" Click="OnOpenGitHub">
              <TextBlock x:Name="TxtGitHub" Text="Teknesyum" VerticalAlignment="Center"/>
            </Button>
            <StackPanel x:Name="WindowButtons" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnMinimize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="Minimize" auto:AutomationProperties.Name="Minimize" Click="OnMinimize">
                <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{Binding $parent[Button].Foreground}"/>
              </Button>
              <Button x:Name="BtnMaximize" Content="□" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="Maximize" auto:AutomationProperties.Name="Maximize" Click="OnMaximizeRestore"/>
              <Button x:Name="BtnClose" Content="×" Theme="{StaticResource CloseWindowButton}" ToolTip.Tip="Close" auto:AutomationProperties.Name="Close" Click="OnClose"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="UpdateNotice"
              Grid.Row="1"
              Margin="24,12,24,0"
              IsVisible="False"
              Background="{StaticResource Surface}"
              BorderBrush="{StaticResource NeonPurpleBorder}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusControl}"
              BoxShadow="{StaticResource GlowPurple}"
              Padding="{StaticResource ButtonPaddingSm}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
          <TextBlock Grid.Column="0"
                     x:Name="TxtNoticeLead"
                     Text="A new version is available"
                     Theme="{StaticResource Body}"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1"
                     x:Name="TxtNoticeVersion"
                     Theme="{StaticResource MonoValue}"
                     Foreground="{StaticResource NeonPurple}"
                     VerticalAlignment="Center"/>
          <TextBox Grid.Column="2"
                   x:Name="TxtNoticeCommand"
                   IsReadOnly="True"
                   MaxLines="1"
                   FontFamily="{StaticResource FontMono}"
                   VerticalAlignment="Center"/>
          <Button Grid.Column="3"
                  x:Name="BtnNoticeCopy"
                  Content="Copy"
                  Theme="{StaticResource GhostButton}"
                  VerticalAlignment="Center"
                  Click="OnCopyUpdateCommand"/>
          <Button Grid.Column="4"
                  x:Name="BtnNoticeDismiss"
                  Content="×"
                  Theme="{StaticResource GhostButton}"
                  FontFamily="{StaticResource FontMono}"
                  VerticalAlignment="Center"
                  auto:AutomationProperties.Name="Close"
                  Click="OnDismissUpdateNotice"/>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="24,12,24,12">
        <StackPanel x:Name="LangSwitch"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ZIndex="1">
          <Button x:Name="BtnTr" Content="TR" Theme="{StaticResource LanguageButton}" auto:AutomationProperties.Name="TR" Click="OnTurkish"/>
          <Button x:Name="BtnEn" Content="EN" Theme="{StaticResource LanguageButton}" auto:AutomationProperties.Name="EN" Click="OnEnglish"/>
        </StackPanel>

        <TabControl Theme="{StaticResource NeonTabControl}">

        <TabItem Header="Shrink" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceMd}">

              <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="SourcePanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Source" Theme="{StaticResource H2}"/>

                    <Panel x:Name="DropZone" MinHeight="{StaticResource DropZoneMinHeight}">
                      <Rectangle x:Name="DropOutline"
                                 RadiusX="{StaticResource RadiusPanelScalar}"
                                 RadiusY="{StaticResource RadiusPanelScalar}"
                                 Stroke="{StaticResource NeonBlueBorderStrong}"
                                 StrokeThickness="{StaticResource DropOutlineThickness}"
                                 StrokeDashArray="4,4"
                                 Fill="{StaticResource NeonBlueFill}">
                        <Rectangle.Transitions>
                          <Transitions>
                            <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            <BrushTransition Property="Fill" Duration="{StaticResource MotionFast}"/>
                          </Transitions>
                        </Rectangle.Transitions>
                      </Rectangle>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource PanelPadding}">
                        <Path x:Name="DropIcon"
                              Width="{StaticResource DropIconSize}"
                              Height="{StaticResource DropIconSize}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Stroke="{StaticResource NeonBlue}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              RenderTransform="none"
                              Effect="drop-shadow(0 0 6 #FF00F3FF)"
                              Data="M 24 6 L 24 31 M 14 21 L 24 31 L 34 21 M 8 33 L 8 42 L 40 42 L 40 33">
                          <Path.Transitions>
                            <Transitions>
                              <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                              <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            </Transitions>
                          </Path.Transitions>
                        </Path>
                        <TextBlock x:Name="TxtDropTitle" Text="Drop a media file here" Theme="{StaticResource DropTitle}"/>
                        <TextBlock x:Name="TxtDropHint" Text="Any format ffmpeg can open" Theme="{StaticResource DropHint}"/>
                        <Button x:Name="BtnBrowseEmpty" Content="Browse" Theme="{StaticResource GhostButton}" HorizontalAlignment="Center" Click="OnBrowse"/>
                      </StackPanel>
                    </Panel>

                    <Grid x:Name="SourceCard" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock x:Name="TxtFileName" Text="Drop any media file here, or browse." Theme="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Browse" Theme="{StaticResource GhostButton}" Click="OnBrowse"/>
                    </Grid>

                    <TextBlock x:Name="TxtSourceStatus" Theme="{StaticResource StatusError}" IsVisible="False"/>

                    <UniformGrid x:Name="InfoGrid" Columns="4" Rows="2" IsVisible="False">
                      <StackPanel>
                        <TextBlock Text="Duration" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtDuration" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Size" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtSize" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Resolution" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtResolution" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="FPS" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtFps" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Video codec" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtVideoCodec" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Audio" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtAudio" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Bitrate" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtBitrate" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="HDR" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtHdr" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border x:Name="TargetPanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Target" Theme="{StaticResource H2}"/>
                      <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Target">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="• The target is a hard ceiling: VidShrink never hands you a file larger than this.&#10;• WhatsApp accepts files up to 2 GB, but it re-compresses any video you send in chat, and its own encoder is far weaker than this one.&#10;• Staying at or below 16 MB keeps VidShrink's quality instead of WhatsApp's.&#10;• 25 MB fits Discord and most e-mail, 8 MB fits older forums and chat apps."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <Slider x:Name="SliderTarget" Minimum="1" Maximum="500" Value="16" VerticalAlignment="Center"/>
                      <TextBox x:Name="TxtTarget" Grid.Column="1" Text="16" Width="96" MaxLines="1" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                      <TextBlock Grid.Column="2" Text="MB" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel>
                      <Button x:Name="ChipWhatsApp" Content="WhatsApp 16" Tag="16" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="• WhatsApp re-encodes in-chat video with its own low-bitrate encoder.&#10;• Under 16 MB it usually passes your file through with far less damage, so what the other side sees is VidShrink's quality, not WhatsApp's.&#10;• To bypass re-encoding entirely, send the result as a document instead of as a video."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="8" Tag="8" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="8 MB fits Discord without Nitro, older forums, and strict e-mail gateways."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="25" Tag="25" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="25 MB fits Gmail attachments, Discord Nitro Basic, and most ticket systems."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="100" Tag="100" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="100 MB suits archiving and uploads where quality matters more than transfer time."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="Half" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPresetHalf">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="• Half of the source size.&#10;• A mild request, so the engine usually keeps the original resolution and frame rate."/>
                        </ToolTip.Tip>
                      </Button>
                    </WrapPanel>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Intent" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Intent">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Intent sets how early the engine stops spending bits.&#10;• Archive stops only at visually lossless quality, so it can leave a lot of the target unused.&#10;• Sharing stops at the point where a normal viewer stops noticing — the right choice for WhatsApp.&#10;• Social media stops earlier still, because the platform will re-encode the file anyway."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbIntent" SelectedIndex="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Archive"/>
                        <ComboBoxItem Content="Sharing"/>
                        <ComboBoxItem Content="Social media"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Compression algorithm" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Compression algorithm">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• H.264 is universal: every phone made in the last fifteen years plays it, and WhatsApp never re-encodes it.&#10;• H.265 needs roughly a third fewer bits for the same picture, so it wins badly compressed targets — but some older Android phones and some web players refuse it.&#10;• Automatic picks H.264 for mild targets and H.265 once the target is tight enough that the quality gain outweighs the compatibility risk.&#10;• Speed is not chosen here any more: turn on fast shrink (GPU) below to let the graphics card encode."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbCodec" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Automatic"/>
                        <ComboBoxItem Content="H.264 (compatible)"/>
                        <ComboBoxItem Content="H.265 (smallest)"/>
                      </ComboBox>
                    </StackPanel>
                    <WrapPanel>
                      <StackPanel Orientation="Horizontal" Margin="{StaticResource WrapItemMargin}">
                        <CheckBox x:Name="ChkResolution" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="May lower resolution"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="May lower resolution">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• When the target is tight, fewer pixels encoded well beat many pixels encoded badly — blur is far less objectionable than blocking.&#10;• The engine measures how much this particular clip actually saves by scaling down, then picks the largest resolution the budget can still hold cleanly.&#10;• On a phone screen a well-encoded 720p is indistinguishable from 1080p; leaving this on is almost always the better trade."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="{StaticResource WrapItemMargin}">
                        <CheckBox x:Name="ChkFps" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="May lower frame rate"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="May lower frame rate">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Halving the frame rate frees bits for the remaining frames.&#10;• The engine only does this on hard targets and never drops below a level where motion starts to stutter.&#10;• Every phone plays reduced frame rates without trouble; the cost is smoothness, not compatibility."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="{StaticResource WrapItemMargin}">
                        <CheckBox x:Name="ChkFastGpu" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" Content="Fast shrink (GPU)"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Fast shrink (GPU)">
                          <ToolTip.Tip>
                            <TextBlock x:Name="TipFastGpu" Theme="{StaticResource TipText}" Text="• Graphics cards encode many times faster than the CPU.&#10;• VidShrink picks the best encoder your card offers; on a modern card the AV1 encoder reaches nearly the software encoder's quality at about seven times the speed.&#10;• On older cards the speed still arrives, but it costs some quality per megabyte."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                    </WrapPanel>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Fill policy" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Fill policy">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Fill target lands close to the target size and squeezes out the best quality the budget allows.&#10;• Stay at quality ceiling stops when quality stops improving: no padding, but the file can end up noticeably smaller."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbFillPolicy" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Fill target"/>
                        <ComboBoxItem Content="Stay at quality ceiling"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="HdrPolicyPanel" IsVisible="False">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HDR" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="HDR">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Preserving HDR keeps the source's wider color and brightness range, but the file is larger 10-bit and only recent devices and apps play it correctly.&#10;• Converting to SDR tone-maps the picture to the standard range — smaller, and safe on WhatsApp and any phone."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbHdrPolicy" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Preserve HDR"/>
                        <ComboBoxItem Content="Convert to SDR"/>
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>

              <Border x:Name="PlanPanel"
                      Grid.Column="1"
                      Theme="{StaticResource Panel}"
                      VerticalAlignment="Stretch"
                      MinHeight="{StaticResource PlanPanelMinHeight}">
                <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceMd}">
                  <TextBlock Grid.Row="0" Text="What it will do" Theme="{StaticResource H2}"/>
                  <ScrollViewer Grid.Row="1" x:Name="PlanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PlanBody" Spacing="{StaticResource SpaceMd}">
                      <TextBlock x:Name="TxtPlanEmpty" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="Load a file and every decision the engine makes is listed here."/>
                      <Grid x:Name="PlanFacts" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}"/>
                      <Border x:Name="PlanRule" Theme="{StaticResource PanelRule}" IsVisible="False"/>
                      <StackPanel x:Name="PlanReasons" Spacing="{StaticResource SpaceSm}"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>

              <StackPanel Grid.Column="2" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="OutputPanel" Theme="{StaticResource Panel}" MinHeight="{StaticResource PanelMinHeight}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Output" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="Progress" Maximum="1"/>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{StaticResource SpaceMd}"
                          RowSpacing="{StaticResource SpaceMd}">

                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="Stage" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtStage" Text="Idle" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="Current output size" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtOutSize" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="Remaining" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtRemaining" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="LblDuration" Text="Estimated time" Theme="{StaticResource OutFactLabel}"/>
                          <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Estimated time">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" Text="• VidShrink times the sample encodes it already ran on this clip, so the speed behind this figure comes from this machine and this file rather than from a table of presets.&#10;• Two-pass runs get a wide range because the first pass only analyses the picture and costs less than the second, and how much less is not measured.&#10;• When the plan moves to settings the samples were not encoded with, the time is left blank instead of guessed."/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <TextBlock x:Name="TxtDurationValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock x:Name="TxtDurationRange" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="{StaticResource SpaceXs}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="LblEstimate" Text="Estimated output" Theme="{StaticResource OutFactLabel}"/>
                          <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Estimated output">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" Text="• Before planning, VidShrink encodes short samples of this exact clip at two resolutions and measures how many bits it really needs — it does not guess from the source bitrate.&#10;• That is why the estimate is a measured number with a narrow range rather than a rule of thumb.&#10;• Two-pass runs land within a few percent; quality-capped runs come in under the target on purpose, because spending the rest would buy nothing you could see."/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <TextBlock x:Name="TxtEstimateValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock x:Name="TxtEstimateRange" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtEstimateNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Border x:Name="RetryAskPanel"
                            IsVisible="False"
                            Background="{StaticResource NeonPinkFill}"
                            BorderBrush="{StaticResource NeonPink}"
                            BorderThickness="{StaticResource BorderThin}"
                            CornerRadius="{StaticResource RadiusCell}"
                            Padding="{StaticResource PanelPadding}">
                      <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="Over the target" Theme="{StaticResource H3}"/>
                        <TextBlock x:Name="TxtRetryOutcome" Theme="{StaticResource PlanFactValue}"/>
                        <TextBlock x:Name="TxtRetryMeaning" Theme="{StaticResource PlanReasonText}"/>
                        <WrapPanel>
                          <Button x:Name="BtnRetryAgain" Content="Try again" Theme="{StaticResource PrimaryButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryAgain"/>
                          <Button x:Name="BtnRetryStop" Content="Leave it as is" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryStop"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Button x:Name="BtnReveal" Content="Show in folder" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>


                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnCancel" Content="Cancel" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel"/>
                  <Button x:Name="BtnStart" Content="Shrink" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnStart"/>
                </StackPanel>

              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Convert" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceXl}">

              <Border Grid.Column="0" Theme="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="Conversion" Theme="{StaticResource H2}"/>
                  <TextBlock x:Name="TxtConvertSource" Text="Load a source in Shrink or browse here." Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                  <Button Content="Browse source" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowse"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceLg}"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Container" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Container">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• The container is the file type.&#10;• MP4 is the safest general choice and the only one WhatsApp reliably sends as a playable video — every phone opens it.&#10;• MKV supports many stream types but WhatsApp and most phone galleries treat it as a document.&#10;• WebM is for browsers and is not a phone format.&#10;• MOV suits Apple workflows and plays on iPhone, but Android support is uneven.&#10;• AVI is for older software only.&#10;• MP3, M4A, and WAV create audio-only files."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbContainer" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="MP4" Tag="mp4"/>
                        <ComboBoxItem Content="MKV" Tag="mkv"/>
                        <ComboBoxItem Content="WebM" Tag="webm"/>
                        <ComboBoxItem Content="MOV" Tag="mov"/>
                        <ComboBoxItem Content="AVI" Tag="avi"/>
                        <ComboBoxItem Content="GIF" Tag="gif"/>
                        <ComboBoxItem Content="MP3" Tag="mp3"/>
                        <ComboBoxItem Content="M4A" Tag="m4a"/>
                        <ComboBoxItem Content="WAV" Tag="wav"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Video codec" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Video codec">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• H.264 plays on nearly every device ever made and is what WhatsApp expects; pick it when the file has to just work.&#10;• H.265 makes files roughly a third smaller at the same picture, and every phone since about 2016 decodes it in hardware — but older handsets, some smart TVs, and several web players will not open it, and WhatsApp may re-encode it.&#10;• VP9 is a browser and WebM format; phones play it in apps but rarely in the gallery.&#10;• AV1 compresses best and is the slowest to encode, and only recent phones decode it.&#10;• Copy keeps the original video untouched — no quality loss, no waiting — whenever the container accepts it."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertCodec" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="H.264" Tag="libx264"/>
                        <ComboBoxItem Content="H.265" Tag="libx265"/>
                        <ComboBoxItem Content="VP9" Tag="libvpx-vp9"/>
                        <ComboBoxItem Content="AV1" Tag="libsvtav1"/>
                        <ComboBoxItem Content="Copy" Tag="copy"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quality mode" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Quality mode">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• CRF targets visual quality, so final size can vary.&#10;• Fixed bitrate targets a data rate, so size stays predictable.&#10;• Use CRF for normal viewing quality and fixed bitrate when size or bandwidth matters more."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbQualityMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="CRF"/>
                        <ComboBoxItem Content="Fixed bitrate"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CRF quality / bitrate K" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="CRF quality / bitrate K">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• In CRF mode, a lower number means higher quality and a larger file; 23 is a common H.264 starting point.&#10;• In fixed bitrate mode, enter kilobits per second: a higher value gives more quality and a larger file."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                        <Slider x:Name="SliderQuality" Minimum="10" Maximum="45" Value="23" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQuality" Grid.Column="1" Text="23" Width="96" MaxLines="1" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NeonBlue}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Resolution" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Resolution">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Source keeps the original dimensions.&#10;• A numbered option limits output height while preserving aspect ratio.&#10;• Lower resolution reduces file size and processing demand.&#10;• Custom allows an exact width and height."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbResolution" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Source"/>
                        <ComboBoxItem Content="2160" Tag="2160"/>
                        <ComboBoxItem Content="1440" Tag="1440"/>
                        <ComboBoxItem Content="1080" Tag="1080"/>
                        <ComboBoxItem Content="720" Tag="720"/>
                        <ComboBoxItem Content="480" Tag="480"/>
                        <ComboBoxItem Content="Custom" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom width x height" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Custom width x height">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Used only when resolution is custom.&#10;• Enter width and height as 1280x720.&#10;• Even dimensions are safest for common video codecs."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomResolution" Text="1280x720" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Frame rate" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Frame rate">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Source preserves the original frame rate.&#10;• 60 is smoother but needs more data.&#10;• 30 suits most video.&#10;• 24 gives a cinema-like motion style.&#10;• Reducing frame rate can reduce file size."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertFps" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Source"/>
                        <ComboBoxItem Content="60" Tag="60"/>
                        <ComboBoxItem Content="30" Tag="30"/>
                        <ComboBoxItem Content="24" Tag="24"/>
                        <ComboBoxItem Content="Custom" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom FPS" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Custom FPS">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Used only when frame rate is custom.&#10;• Enter the desired frames per second, such as 25 or 29.97.&#10;• Values above the source frame rate usually add no real motion detail."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomFps" Text="25" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Audio">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• AAC is the safe pairing for MP4 and the only audio codec every phone and WhatsApp handle without complaint.&#10;• Opus sounds better at low bitrates but belongs in WebM; inside MP4 it will not play on many phones.&#10;• MP3 suits older players.&#10;• PCM is uncompressed and very large.&#10;• Copy preserves the original audio without re-encoding when the container supports it.&#10;• Drop removes audio completely, which is the right call when you are squeezing a silent clip."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertAudio" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="AAC" Tag="aac"/>
                        <ComboBoxItem Content="Opus" Tag="libopus"/>
                        <ComboBoxItem Content="MP3" Tag="libmp3lame"/>
                        <ComboBoxItem Content="PCM" Tag="pcm_s16le"/>
                        <ComboBoxItem Content="Copy" Tag="copy"/>
                        <ComboBoxItem Content="Drop"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio bitrate K" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Audio bitrate K">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Audio data rate in kilobits per second.&#10;• 128 is a compact general setting, 192 provides more detail, and 256 or 320 is useful for music.&#10;• This value is ignored for copy, drop, and raw PCM."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtAudioBitrate" Text="128" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Start (HH:MM:SS)" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Start">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Optional trim start time.&#10;• Leave empty to begin at the start of the source.&#10;• Use hours:minutes:seconds, for example 00:01:30."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimStart" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="End (HH:MM:SS)" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="End">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="• Optional trim end time.&#10;• Leave empty to continue to the end of the source.&#10;• The end time must be later than the start time."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimEnd" MaxLines="1"/>
                    </StackPanel>

                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceLg}">
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="FFmpeg command" Theme="{StaticResource H2}"/>
                    <TextBox x:Name="TxtConvertCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinLines="6" MaxLines="6"/>
                    <TextBlock x:Name="TxtConvertValidation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Progress" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="ConvertProgress" Maximum="1"/>
                    <TextBlock x:Name="TxtConvertStage" Text="Idle" Theme="{StaticResource MonoValue}">
                      <TextBlock.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                        </Transitions>
                      </TextBlock.Transitions>
                    </TextBlock>
                    <TextBlock x:Name="TxtConvertResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnConvertReveal" Content="Show in folder" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnConvertCancel" Content="Cancel" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel"/>
                  <Button x:Name="BtnConvert" Content="Convert" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnConvert"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="About" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Theme="{StaticResource Panel}" Margin="{StaticResource SectionMargin}">
              <StackPanel Spacing="{StaticResource SpaceMd}">
                <TextBlock Text="About VidShrink" Theme="{StaticResource H2}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• VidShrink is an offline tool for target-size video compression and format conversion.&#10;• Give it a file and a size ceiling; it works out the settings that lose the least of what a person can actually see, and never returns a file larger than you asked for."/>
                <TextBlock Text="How the engine thinks" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• Most size-target compressors apply a fixed table: this many megabytes per minute becomes that resolution.&#10;• That table is wrong for every clip that is not average.&#10;• VidShrink measures instead. It encodes short samples of your actual file at two resolutions and reads how many bits it really costs, and how much of that cost disappears when the picture is scaled down.&#10;• Those two measurements make the plan specific to this clip rather than to video in general."/>
                <TextBlock Text="Measured, not assumed" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource MonoValue}" FontWeight="Normal" Text="complexity      measured from your file, not its bitrate&#x0a;detail falloff  measured; decides if scaling down is worth it&#x0a;resolution      continuous search, not a fixed ladder&#x0a;frame rate      searched alongside resolution, not after it&#x0a;codec           chosen from how hard the target actually is&#x0a;audio           share of budget shrinks as the target tightens&#x0a;estimate        a measured number with a range, shown up front"/>
                <TextBlock Text="Where the loss goes" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• Below a certain bit budget something has to give.&#10;• The engine spends the loss where the eye is least sensitive: softness before blocking, fewer pixels before broken pixels, mono audio before a starved picture.&#10;• It also knows when to stop — once quality reaches the point where more bits buy nothing you could see, it hands back a smaller file instead of padding it to the target."/>
                <TextBlock Text="Scenario awareness" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• A 1.2x reduction and a 600x reduction are not the same problem, so they do not get the same treatment.&#10;• Light targets keep everything and simply spend the budget.&#10;• Balanced targets allow scaling.&#10;• Aggressive and extreme targets unlock frame-rate reduction, move to H.265, and cut the audio share — and the app tells you what it changed and why, in plain language, before you press start."/>
                <TextBlock Text="AI mode" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• AI mode only creates a prompt and validates pasted JSON.&#10;• No AI is embedded, so VidShrink works offline, asks for no API key, and falls back to the complete automatic engine when an answer is malformed or incompatible."/>
                <TextBlock Text="Codecs" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="• H.264 offers the broadest compatibility.&#10;• H.265 compresses more efficiently.&#10;• VP9 is a strong WebM choice.&#10;• AV1 maximizes modern compression at higher CPU cost.&#10;• Stream copy is fastest and lossless when the destination supports the source streams."/>
                <TextBlock Text="System status" Theme="{StaticResource H3}"/>
                <TextBlock x:Name="TxtSystemStatus" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"/>
                <TextBlock Text="Updates" Theme="{StaticResource H3}"/>
                <StackPanel x:Name="AutoUpdateRow" Orientation="Horizontal">
                  <CheckBox x:Name="ChkAutoUpdate" Theme="{StaticResource CheckStyle}" Content="Update automatically"/>
                </StackPanel>
                <TextBlock x:Name="TxtAutoUpdateEffect"
                           Theme="{StaticResource Hint}"
                           TextWrapping="Wrap"
                           Text="When this is off, VidShrink does not update itself: it only tells you that a new version exists and shows the command that installs it."/>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>

          <TabItem Header="Advanced" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource SectionMargin}" Spacing="{StaticResource SpaceLg}">

              <Border x:Name="CommandPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <TextBlock Grid.Column="0" Text="FFmpeg command" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="BtnCommandExpand"
                            Content="▾"
                            Theme="{StaticResource GhostButton}"
                            FontFamily="{StaticResource FontMono}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="FFmpeg command"
                            Click="OnToggleCommand"/>
                  </Grid>
                  <TextBox x:Name="TxtCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinLines="1" MaxLines="1"/>
                </StackPanel>
              </Border>

              <Border x:Name="AiPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <TextBlock Grid.Column="0" Text="AI settings" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="TxtAiHint"
                               Text="{StaticResource AiHintText}"
                               Theme="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                      <ToolTip.Tip>
                        <TextBlock Theme="{StaticResource TipText}" Text="{StaticResource AiHintText}"/>
                      </ToolTip.Tip>
                    </TextBlock>
                    <Button Grid.Column="2"
                            x:Name="BtnAiDetails"
                            Content="▾"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontMono}"
                            auto:AutomationProperties.Name="AI settings"
                            Click="OnToggleAiDetails"/>
                  </Grid>
                  <StackPanel x:Name="AiDetails" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{StaticResource AiHintText}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="Copy prompt" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnCopyPrompt"/>
                      <Button Content="Apply pasted JSON" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnApplyJson"/>
                      <Button x:Name="BtnRevert" Content="Back to automatic" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnRevertAuto"/>
                    </WrapPanel>
                    <TextBox x:Name="TxtAiJson" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="4"/>
                    <TextBlock x:Name="TxtAiStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      </Grid>
    </Grid>
  </Border>
</Window>
