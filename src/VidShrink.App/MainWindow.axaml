<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        x:Class="VidShrink.App.MainWindow"
        Title="VidShrink"
        Width="1220" Height="900" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}"
        Foreground="{StaticResource TextBody}">

  <Border x:Name="WindowShell"
          Background="{StaticResource WorkspaceBackground}"
          BorderBrush="{StaticResource NeonBlue}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusCell}"
          UseLayoutRounding="True">
    <Grid RowDefinitions="Auto,Auto,*">

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Height="{StaticResource TitleBarHeight}"
              Background="{StaticResource TitleBarBackground}"
              BorderBrush="{StaticResource NeonBlueBorderStrong}"
              BorderThickness="0,0,0,1">
        <Grid x:Name="TitleBarContent" Margin="16,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
            <Image x:Name="AppLogo" Width="24" Height="24" Stretch="Uniform" IsVisible="False"/>
            <TextBlock Text="VidShrink" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="BtnMinimize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="Minimize" auto:AutomationProperties.Name="Minimize" Click="OnMinimize">
              <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{Binding $parent[Button].Foreground}"/>
            </Button>
            <Button x:Name="BtnMaximize" Content="□" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="Maximize" auto:AutomationProperties.Name="Maximize" Click="OnMaximizeRestore"/>
            <Button x:Name="BtnClose" Content="×" Theme="{StaticResource CloseWindowButton}" ToolTip.Tip="Close" auto:AutomationProperties.Name="Close" Click="OnClose"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="24,12,24,12">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TaglineLead" Text="Target size media compression" Theme="{StaticResource ProductTagline}"/>
          <TextBlock x:Name="TaglineSeparator" Text=" &amp; " Theme="{StaticResource ProductTagline}" Foreground="{StaticResource TextBody}"/>
          <TextBlock x:Name="TaglineConverter" Text="Media converter" Theme="{StaticResource ProductTagline}" Foreground="{StaticResource NeonPink}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnTr" Content="TR" Theme="{StaticResource ChipButton}" Click="OnTurkish"/>
          <Button x:Name="BtnEn" Content="EN" Theme="{StaticResource ChipButton}" Click="OnEnglish"/>
        </StackPanel>
      </Grid>

      <TabControl Grid.Row="2" Margin="24,0,24,24" Theme="{StaticResource NeonTabControl}">

        <TabItem Header="Shrink" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceXl}">

              <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceLg}">

                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Source" Theme="{StaticResource H2}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock x:Name="TxtFileName" Text="Drop any media file here, or browse." Theme="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Browse" Theme="{StaticResource GhostButton}" Click="OnBrowse"/>
                    </Grid>
                    <TextBlock x:Name="TxtSourceStatus" Theme="{StaticResource StatusError}" IsVisible="False"/>
                    <UniformGrid x:Name="InfoGrid" Columns="4" Rows="2" IsVisible="False">
                      <StackPanel>
                        <TextBlock Text="Duration" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtDuration" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Size" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtSize" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Resolution" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtResolution" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="FPS" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtFps" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Video codec" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtVideoCodec" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Audio" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtAudio" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Bitrate" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtBitrate" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="HDR" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtHdr" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border x:Name="TargetPanel" Theme="{StaticResource Panel}" MinHeight="256">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Target" Theme="{StaticResource H2}"/>
                      <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Target">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="The target is a hard ceiling: VidShrink never hands you a file larger than this. WhatsApp accepts files up to 2 GB, but it re-compresses any video you send in chat, and its own encoder is far weaker than this one. Staying at or below 16 MB keeps VidShrink's quality instead of WhatsApp's. 25 MB fits Discord and most e-mail, 8 MB fits older forums and chat apps."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <Slider x:Name="SliderTarget" Minimum="1" Maximum="500" Value="16" VerticalAlignment="Center"/>
                      <TextBox x:Name="TxtTarget" Grid.Column="1" Text="16" Width="96" MaxLines="1" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                      <TextBlock Grid.Column="2" Text="MB" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ChipWhatsApp" Content="WhatsApp 16" Tag="16" Theme="{StaticResource ChipButton}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="WhatsApp re-encodes in-chat video with its own low-bitrate encoder. Under 16 MB it usually passes your file through with far less damage, so what the other side sees is VidShrink's quality, not WhatsApp's. To bypass re-encoding entirely, send the result as a document instead of as a video."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="8" Tag="8" Theme="{StaticResource ChipButton}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="8 MB fits Discord without Nitro, older forums, and strict e-mail gateways."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="25" Tag="25" Theme="{StaticResource ChipButton}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="25 MB fits Gmail attachments, Discord Nitro Basic, and most ticket systems."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="100" Tag="100" Theme="{StaticResource ChipButton}" Click="OnPreset">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="100 MB suits archiving and uploads where quality matters more than transfer time."/>
                        </ToolTip.Tip>
                      </Button>
                      <Button Content="Half" Theme="{StaticResource ChipButton}" Click="OnPresetHalf">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="Half of the source size. A mild request, so the engine usually keeps the original resolution and frame rate."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}">
                      <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Intent" Theme="{StaticResource Label}"/>
                          <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Intent">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" Text="Intent sets how early the engine stops spending bits. Archive stops only at visually lossless quality, so it can leave a lot of the target unused. Sharing stops at the point where a normal viewer stops noticing — the right choice for WhatsApp. Social media stops earlier still, because the platform will re-encode the file anyway."/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <ComboBox x:Name="CmbIntent" SelectedIndex="1" HorizontalAlignment="Stretch">
                          <ComboBoxItem Content="Archive"/>
                          <ComboBoxItem Content="Sharing"/>
                          <ComboBoxItem Content="Social media"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Compression algorithm" Theme="{StaticResource Label}"/>
                          <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Compression algorithm">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" Text="H.264 is the universal one: every phone made in the last fifteen years plays it, and WhatsApp never has to re-encode it. H.265 needs roughly a third fewer bits for the same picture, so it wins badly compressed targets — but some older Android phones and some web players refuse it. Automatic picks H.264 for mild targets and H.265 once the target is tight enough that the quality gain outweighs the compatibility risk. Speed is not chosen here any more: turn on fast shrink (GPU) below when you want the graphics card to do the encoding."/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <ComboBox x:Name="CmbCodec" SelectedIndex="0" HorizontalAlignment="Stretch">
                          <ComboBoxItem Content="Automatic - engine decides"/>
                          <ComboBoxItem Content="Compatible - H.264"/>
                          <ComboBoxItem Content="Max compression - H.265"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="ChkResolution" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="May lower resolution"/>
                      <Button Theme="{StaticResource InfoButton}" Margin="0,0,24,0" auto:AutomationProperties.Name="May lower resolution">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="When the target is tight, fewer pixels encoded well beat many pixels encoded badly — blur is far less objectionable than blocking. The engine measures how much this particular clip actually saves by scaling down, then picks the largest resolution the budget can still hold cleanly. On a phone screen a well-encoded 720p is indistinguishable from 1080p; leaving this on is almost always the better trade."/>
                        </ToolTip.Tip>
                      </Button>
                      <CheckBox x:Name="ChkFps" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="May lower frame rate"/>
                      <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="May lower frame rate">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="Halving the frame rate frees bits for the frames that remain. The engine only does this on hard targets and never drops below a level where motion starts to stutter. Every phone plays reduced frame rates without trouble; the cost is smoothness, not compatibility."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="ChkFastGpu" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" Content="Fast shrink (GPU)"/>
                      <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Fast shrink (GPU)">
                        <ToolTip.Tip>
                          <TextBlock x:Name="TipFastGpu" Theme="{StaticResource TipText}" Text="The graphics card encodes many times faster than the processor. VidShrink picks the best encoder your card offers, and on a modern card the AV1 encoder reaches nearly the same quality as the software encoder at about seven times the speed. On older cards the speed still arrives, but it costs some quality per megabyte."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <TextBlock Text="Fill policy" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <Button Theme="{StaticResource InfoButton}" Margin="0" auto:AutomationProperties.Name="Fill policy">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="Fill target lands close to the target size and squeezes out the best quality the budget allows. Stay at quality ceiling stops once quality stops improving, which avoids padding the file but can leave it noticeably smaller."/>
                        </ToolTip.Tip>
                      </Button>
                      <ComboBox x:Name="CmbFillPolicy" Width="240" SelectedIndex="0">
                        <ComboBoxItem Content="Fill target"/>
                        <ComboBoxItem Content="Stay at quality ceiling"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="HdrPolicyPanel" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" IsVisible="False">
                      <TextBlock Text="HDR" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <ComboBox x:Name="CmbHdrPolicy" Width="216" SelectedIndex="0">
                        <ComboBoxItem Content="Preserve HDR"/>
                        <ComboBoxItem Content="Convert to SDR"/>
                      </ComboBox>
                      <Button Theme="{StaticResource InfoButton}" Margin="0" auto:AutomationProperties.Name="HDR">
                        <ToolTip.Tip>
                          <TextBlock Theme="{StaticResource TipText}" Text="Preserving HDR keeps the source's wider color and brightness range, but the file is larger 10-bit and only recent devices and apps play it correctly. Converting to SDR tone-maps the picture down to the standard range — smaller, and safe for WhatsApp and any phone."/>
                        </ToolTip.Tip>
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="What it will do" Theme="{StaticResource H2}"/>
                    <TextBlock x:Name="TxtPlanSummary" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPlanReason" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock Text="FFmpeg command" Theme="{StaticResource Label}" Margin="0"/>
                    <TextBox x:Name="TxtCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxLines="4"/>
                  </StackPanel>
                </Border>

              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceLg}">

                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="AI settings" Theme="{StaticResource H2}"/>
                    <TextBlock Text="Optional. Copy a prompt to any chat AI, then paste and validate its JSON answer." Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <Button Content="Copy prompt" Theme="{StaticResource GhostButton}" Click="OnCopyPrompt"/>
                      <Button Content="Apply pasted JSON" Theme="{StaticResource GhostButton}" Click="OnApplyJson"/>
                    </StackPanel>
                    <TextBox x:Name="TxtAiJson" AcceptsReturn="True" TextWrapping="Wrap" MinLines="6" MaxLines="6"/>
                    <TextBlock x:Name="TxtAiStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnRevert" Content="Back to automatic" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnRevertAuto"/>
                  </StackPanel>
                </Border>

                <Border Theme="{StaticResource Panel}" MinHeight="256">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Output" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="Progress" Maximum="1"/>
                    <UniformGrid Columns="2">
                      <StackPanel>
                        <TextBlock Text="Stage" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtStage" Text="Idle" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="Remaining" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtRemaining" Text="-" Theme="{StaticResource MonoValue}"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                      <StackPanel>
                        <TextBlock Text="Current output size" Theme="{StaticResource Label}"/>
                        <TextBlock x:Name="TxtOutSize" Text="-" Theme="{StaticResource HeroValue}"/>
                      </StackPanel>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="LblEstimate" Text="Estimated output" Theme="{StaticResource Label}"/>
                          <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Estimated output">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" Text="Before planning, VidShrink encodes short samples of this exact clip at two resolutions and measures how many bits it really needs — it does not guess from the source bitrate. That is why the estimate is a measured number with a narrow range rather than a rule of thumb. Two-pass runs land within a few percent; quality-capped runs come in under the target on purpose, because spending the rest would buy nothing you could see."/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <TextBlock x:Name="TxtEstimateValue" Text="-" Theme="{StaticResource HeroValue}"/>
                        <TextBlock x:Name="TxtEstimateRange" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="TxtEstimateNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtStrategyNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnReveal" Content="Show in folder" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnCancel" Content="Cancel" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel"/>
                  <Button x:Name="BtnStart" Content="Shrink" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnStart"/>
                </StackPanel>

              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Convert" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceXl}">

              <Border Grid.Column="0" Theme="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="Conversion" Theme="{StaticResource H2}"/>
                  <TextBlock x:Name="TxtConvertSource" Text="Load a source in Shrink or browse here." Theme="{StaticResource Body}"/>
                  <Button Content="Browse source" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowse"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceLg}"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Container" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Container">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="The container is the file type. MP4 is the safest general choice and the only one WhatsApp reliably sends as a playable video — every phone opens it. MKV supports many stream types but WhatsApp and most phone galleries treat it as a document. WebM is for browsers and is not a phone format. MOV suits Apple workflows and plays on iPhone, but Android support is uneven. AVI is for older software only. MP3, M4A, and WAV create audio-only files."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbContainer" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="MP4" Tag="mp4"/>
                        <ComboBoxItem Content="MKV" Tag="mkv"/>
                        <ComboBoxItem Content="WebM" Tag="webm"/>
                        <ComboBoxItem Content="MOV" Tag="mov"/>
                        <ComboBoxItem Content="AVI" Tag="avi"/>
                        <ComboBoxItem Content="GIF" Tag="gif"/>
                        <ComboBoxItem Content="MP3" Tag="mp3"/>
                        <ComboBoxItem Content="M4A" Tag="m4a"/>
                        <ComboBoxItem Content="WAV" Tag="wav"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Video codec" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Video codec">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="H.264 plays on essentially every device ever made and is what WhatsApp expects; pick it when the file has to just work. H.265 makes files roughly a third smaller at the same picture, and every phone since about 2016 decodes it in hardware — but older handsets, some smart TVs, and several web players will not open it, and WhatsApp may re-encode it. VP9 is a browser and WebM format; phones play it in apps but rarely in the gallery. AV1 compresses best and is the slowest to encode, and only recent phones decode it. Copy keeps the original video untouched with no quality loss and no waiting, whenever the chosen container accepts it."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertCodec" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="H.264" Tag="libx264"/>
                        <ComboBoxItem Content="H.265" Tag="libx265"/>
                        <ComboBoxItem Content="VP9" Tag="libvpx-vp9"/>
                        <ComboBoxItem Content="AV1" Tag="libsvtav1"/>
                        <ComboBoxItem Content="Copy" Tag="copy"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quality mode" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Quality mode">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="CRF targets visual quality, so final size can vary. Fixed bitrate targets a data rate, making file size more predictable. Use CRF for normal viewing quality and fixed bitrate when size or bandwidth matters more."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbQualityMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="CRF"/>
                        <ComboBoxItem Content="Fixed bitrate"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CRF quality / bitrate K" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="CRF quality / bitrate K">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="In CRF mode, a lower number means higher quality and a larger file; 23 is a common H.264 starting point. In fixed bitrate mode, enter kilobits per second: a higher value gives more quality and a larger file."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                        <Slider x:Name="SliderQuality" Minimum="10" Maximum="45" Value="23" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQuality" Grid.Column="1" Text="23" Width="96" MaxLines="1" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NeonBlue}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Resolution" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Resolution">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Source keeps the original dimensions. A numbered option limits output height while preserving aspect ratio. Lower resolution reduces file size and processing demand. Custom allows an exact width and height."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbResolution" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Source"/>
                        <ComboBoxItem Content="2160" Tag="2160"/>
                        <ComboBoxItem Content="1440" Tag="1440"/>
                        <ComboBoxItem Content="1080" Tag="1080"/>
                        <ComboBoxItem Content="720" Tag="720"/>
                        <ComboBoxItem Content="480" Tag="480"/>
                        <ComboBoxItem Content="Custom" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom width x height" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Custom width x height">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Used only when resolution is custom. Enter width and height as 1280x720. Even dimensions are the safest choice for common video codecs."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomResolution" Text="1280x720" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Frame rate" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Frame rate">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Source preserves the original frame rate. 60 is smoother but needs more data. 30 suits most video. 24 gives a cinema-like motion style. Reducing frame rate can reduce file size."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertFps" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Source"/>
                        <ComboBoxItem Content="60" Tag="60"/>
                        <ComboBoxItem Content="30" Tag="30"/>
                        <ComboBoxItem Content="24" Tag="24"/>
                        <ComboBoxItem Content="Custom" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Custom FPS" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Custom FPS">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Used only when frame rate is custom. Enter the desired frames per second, such as 25 or 29.97. Values above the source frame rate usually add no real motion detail."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomFps" Text="25" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Audio">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="AAC is the safe pairing for MP4 and the only audio codec every phone and WhatsApp handle without complaint. Opus sounds better at low bitrates but belongs in WebM; inside MP4 it will not play on many phones. MP3 suits older players. PCM is uncompressed and very large. Copy preserves the original audio without re-encoding when the container supports it. Drop removes audio completely, which is the right call when you are squeezing a silent clip."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertAudio" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="AAC" Tag="aac"/>
                        <ComboBoxItem Content="Opus" Tag="libopus"/>
                        <ComboBoxItem Content="MP3" Tag="libmp3lame"/>
                        <ComboBoxItem Content="PCM" Tag="pcm_s16le"/>
                        <ComboBoxItem Content="Copy" Tag="copy"/>
                        <ComboBoxItem Content="Drop"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Audio bitrate K" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Audio bitrate K">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Audio data rate in kilobits per second. 128 is a compact general setting, 192 provides more detail, and 256 or 320 is useful for music. This value is ignored for copy, drop, and uncompressed PCM."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtAudioBitrate" Text="128" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Start (HH:MM:SS)" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="Start">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Optional trim start time. Leave empty to begin at the start of the source. Use hours:minutes:seconds, for example 00:01:30."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimStart" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="End (HH:MM:SS)" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="End">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" Text="Optional trim end time. Leave empty to continue to the end of the source. The end time must be later than the start time."/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimEnd" MaxLines="1"/>
                    </StackPanel>

                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceLg}">
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="FFmpeg command" Theme="{StaticResource H2}"/>
                    <TextBox x:Name="TxtConvertCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinLines="6" MaxLines="6"/>
                    <TextBlock x:Name="TxtConvertValidation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="Progress" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="ConvertProgress" Maximum="1"/>
                    <TextBlock x:Name="TxtConvertStage" Text="Idle" Theme="{StaticResource MonoValue}"/>
                    <TextBlock x:Name="TxtConvertResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnConvertReveal" Content="Show in folder" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnConvertCancel" Content="Cancel" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel"/>
                  <Button x:Name="BtnConvert" Content="Convert" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnConvert"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="About" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Theme="{StaticResource Panel}" Margin="{StaticResource SectionMargin}">
              <StackPanel Spacing="{StaticResource SpaceMd}">
                <TextBlock Text="About VidShrink" Theme="{StaticResource H2}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="VidShrink is an offline tool for target-size video compression and format conversion. Give it a file and a size ceiling; it works out the settings that lose the least of what a person can actually see, and never returns a file larger than you asked for."/>
                <TextBlock Text="How the engine thinks" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="Most size-target compressors apply a fixed table: this many megabytes per minute becomes that resolution. That table is wrong for every clip that is not average. VidShrink measures instead. It encodes short samples of your actual file at two resolutions and reads how many bits it really costs, and how much of that cost disappears when the picture is scaled down. Those two measurements make the plan specific to this clip rather than to video in general."/>
                <TextBlock Text="Measured, not assumed" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource MonoValue}" FontWeight="Normal" Text="complexity      measured from your file, not its bitrate&#x0a;detail falloff  measured; decides if scaling down is worth it&#x0a;resolution      continuous search, not a fixed ladder&#x0a;frame rate      searched alongside resolution, not after it&#x0a;codec           chosen from how hard the target actually is&#x0a;audio           share of budget shrinks as the target tightens&#x0a;estimate        a measured number with a range, shown up front"/>
                <TextBlock Text="Where the loss goes" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="Below a certain bit budget something has to give. The engine spends the loss where the eye is least sensitive: softness before blocking, fewer pixels before broken pixels, mono audio before a starved picture. It also knows when to stop — once quality reaches the point where more bits buy nothing you could see, it hands back a smaller file instead of padding it to the target."/>
                <TextBlock Text="Scenario awareness" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="A 1.2x reduction and a 600x reduction are not the same problem, so they do not get the same treatment. Light targets keep everything and simply spend the budget. Balanced targets allow scaling. Aggressive and extreme targets unlock frame-rate reduction, move to H.265, and cut the audio share — and the app tells you what it changed and why, in plain language, before you press start."/>
                <TextBlock Text="AI mode" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="AI mode only creates a prompt and validates pasted JSON. No AI is embedded, so VidShrink works offline, asks for no API key, and falls back to the complete automatic engine when an answer is malformed or incompatible."/>
                <TextBlock Text="Codecs" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource Body}" TextWrapping="Wrap" Text="H.264 offers the broadest compatibility. H.265 compresses more efficiently. VP9 is a strong WebM choice. AV1 maximizes modern compression at higher CPU cost. Stream copy is fastest and lossless when the destination supports the source streams."/>
                <TextBlock Text="System status" Theme="{StaticResource H3}"/>
                <TextBlock x:Name="TxtSystemStatus" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"/>
                <StackPanel HorizontalAlignment="Right" Margin="{StaticResource SectionMargin}" Spacing="{StaticResource SpaceXs}">
                  <Button x:Name="BtnGitHub" Content="GitHub / Teknesyum" Theme="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="OnOpenGitHub"/>
                  <Button x:Name="BtnSponsor" Content="Buy me a coffee" Theme="{StaticResource SupportButton}" Click="OnOpenSponsor"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      <TextBlock x:Name="TxtStatusBar" Grid.Row="2" IsVisible="False"/>
    </Grid>
  </Border>
</Window>
