<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:playback="using:VidShrink.App.Playback"
        xmlns:recorder="using:VidShrink.App.Recorder"
        xmlns:loc="using:VidShrink.App.Localization"
        xmlns:izi="using:VidShrink.App"
        x:Class="VidShrink.App.MainWindow"
        Title="VidShrink"
        Width="1560" Height="1060" MinWidth="1136" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkspaceGradient}"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}"
        Foreground="{StaticResource TextBody}">

  <Window.Styles>
    <Style Selector="Window.reduced-motion Button">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Border.enter">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Ellipse">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Path">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <!--
      Ust serit bir katman: icerik zaten tam yukseklikte duruyor, serit onun ustunde
      goruntuleniyor. Gizlenip acilirken icerik yer degistirmiyor.
    -->
    <Style Selector="Window.chrome-hidden Border#TitleBar">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.chrome-hidden Border#TitleBarLayer">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.chrome-hidden TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </Window.Styles>

  <Border x:Name="WindowShell"
          Background="{StaticResource WorkspaceGradient}"
          BorderBrush="{StaticResource NeonBlue}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusControl}"
          UseLayoutRounding="True">
    <Grid Background="{StaticResource WorkspaceBackground}">

      <Border x:Name="TitleBar"
              VerticalAlignment="Top"
              Height="{StaticResource TitleBarHeight}"
              Background="{StaticResource TitleBarBackground}"
              BorderBrush="{StaticResource NeonBlueBorderStrong}"
              BorderThickness="0,0,0,1"/>


        <TabControl x:Name="Tabs" Theme="{StaticResource NeonTabControl}" SelectedIndex="1" izi:AcilisIsareti.Ad="xaml-sekmeler">
        <TabControl.Tag>
        <StackPanel>
          <Border x:Name="AppliedNotice"
                  Margin="{StaticResource NoticeMargin}"
                  IsVisible="False"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource NeonBlueBorder}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusControl}"
                  BoxShadow="{DynamicResource GlowBlue}"
                  Padding="{StaticResource ButtonPaddingSm}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
              <TextBlock Grid.Column="0"
                         x:Name="TxtAppliedLead"
                         Text="{loc:Text main.update.applied}"
                         Theme="{StaticResource Body}"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         x:Name="TxtAppliedVersion"
                         Theme="{StaticResource MonoValue}"
                         Foreground="{StaticResource NeonBlue}"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="3"
                      x:Name="BtnAppliedDismiss"
                      Content="×"
                      Theme="{StaticResource GhostButton}"
                      FontFamily="{StaticResource FontMono}"
                      VerticalAlignment="Center"
                      auto:AutomationProperties.Name="{loc:Text main.window.close}"
                      Click="OnDismissAppliedNotice"/>
            </Grid>
          </Border>

          <Border x:Name="UpdateNotice"
                  Margin="{StaticResource NoticeMargin}"
                  IsVisible="False"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource NeonPurpleBorder}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusControl}"
                  BoxShadow="{DynamicResource GlowPurple}"
                  Padding="{StaticResource ButtonPaddingSm}">
            <StackPanel Spacing="{StaticResource SpaceMd}">
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                <Image Grid.Column="0"
                       x:Name="UpdateNoticeIcon"
                       Width="{StaticResource IconSizeLg}"
                       Height="{StaticResource IconSizeLg}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="TxtNoticeLead"
                           Text="{loc:Text main.update.available}"
                           Theme="{StaticResource Body}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           x:Name="TxtNoticeVersion"
                           Theme="{StaticResource MonoValue}"
                           Foreground="{StaticResource NeonPurple}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="4"
                        x:Name="BtnNoticeInstall"
                        Content="{loc:Text main.action.download}"
                        Theme="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="OnInstallUpdate"/>
                <Button Grid.Column="5"
                        x:Name="BtnNoticeDismiss"
                        Content="×"
                        Theme="{StaticResource GhostButton}"
                        FontFamily="{StaticResource FontMono}"
                        VerticalAlignment="Center"
                        auto:AutomationProperties.Name="{loc:Text main.window.close}"
                        Click="OnDismissUpdateNotice"/>
              </Grid>
              <Border x:Name="UpdateLogArea"
                      IsVisible="False"
                      ClipToBounds="True"
                      Background="{StaticResource AppBg}"
                      CornerRadius="{StaticResource RadiusChip}">
                <Panel>
                  <izi:MatrixRain x:Name="UpdateRain" Foreground="{StaticResource NeonSuccess}" Opacity="{StaticResource BorderDecorativeOpacity}"/>
                  <StackPanel x:Name="UpdateLogLines"
                              VerticalAlignment="Bottom"
                              Margin="{StaticResource ChipPadding}"/>
                </Panel>
              </Border>
              <Border x:Name="UpdateBarTrack"
                      IsVisible="False"
                      Height="{StaticResource ProgressBarHeight}"
                      CornerRadius="{StaticResource RadiusChip}"
                      Background="{StaticResource AppBg}"
                      ClipToBounds="True">
                <Border x:Name="UpdateBarFill"
                        HorizontalAlignment="Left"
                        CornerRadius="{StaticResource RadiusChip}"
                        Background="{StaticResource EmberBlaze}"/>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        </TabControl.Tag>
        <TabItem x:Name="TabPlayer" izi:AcilisIsareti.Ad="xaml-oynatici" Header="{loc:Text main.tab.player}" Tag="{StaticResource IconPlayer}" Theme="{StaticResource NeonTabItem}">
          <playback:PlayerView x:Name="Player"/>
        </TabItem>


        <TabItem x:Name="TabShrink" izi:AcilisIsareti.Ad="xaml-kucultme" Header="{loc:Text main.tab.shrink}" Tag="{StaticResource IconShrink}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageShrink" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceMd}">

              <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="SourcePanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{loc:Text main.source.title}" Theme="{StaticResource H2}"/>

                    <Panel x:Name="DropZone" MinHeight="{StaticResource DropZoneMinHeight}">
                      <Rectangle x:Name="DropOutline"
                                 RadiusX="{StaticResource RadiusPanelScalar}"
                                 RadiusY="{StaticResource RadiusPanelScalar}"
                                 Stroke="{StaticResource NeonBlueBorderStrong}"
                                 StrokeThickness="{StaticResource DropOutlineThickness}"
                                 StrokeDashArray="4,4"
                                 Fill="{StaticResource NeonBlueFill}">
                        <Rectangle.Transitions>
                          <Transitions>
                            <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            <BrushTransition Property="Fill" Duration="{StaticResource MotionFast}"/>
                          </Transitions>
                        </Rectangle.Transitions>
                      </Rectangle>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource DropZonePadding}">
                        <Path x:Name="DropIcon"
                              Width="{StaticResource DropIconSize}"
                              Height="{StaticResource DropIconSize}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Stroke="{StaticResource NeonBlue}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              RenderTransform="none"
                              Data="M 24 6 L 24 31 M 14 21 L 24 31 L 34 21 M 8 33 L 8 42 L 40 42 L 40 33">
                          <Path.Effect>
                            <DropShadowEffect OffsetX="0" OffsetY="0"
                                              BlurRadius="{StaticResource DropIconGlowRadius}"
                                              Color="{StaticResource NeonBlueColor}"/>
                          </Path.Effect>
                          <Path.Transitions>
                            <Transitions>
                              <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                              <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            </Transitions>
                          </Path.Transitions>
                        </Path>
                        <TextBlock x:Name="TxtDropTitle" Theme="{StaticResource DropTitle}"/>
                        <TextBlock x:Name="TxtDropHint" Theme="{StaticResource DropHint}"/>
                        <Button x:Name="BtnBrowseEmpty" Content="{loc:Text main.action.browse}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Center" Click="OnBrowse"/>
                      </StackPanel>
                    </Panel>

                    <Grid x:Name="SourceCard" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock x:Name="TxtFileName" Theme="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding $self.Text}"/>
                      <Button Grid.Column="1" Content="{loc:Text main.action.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowse"/>
                    </Grid>

                    <TextBlock x:Name="TxtSourceStatus" Theme="{StaticResource StatusError}" IsVisible="False"/>

                    <Grid x:Name="TitleRow" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock Text="{loc:Text main.title.label}" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="CmbTitle" HorizontalAlignment="Stretch" SelectionChanged="OnTitleChanged"/>
                    </Grid>

                    <UniformGrid x:Name="InfoGrid" Columns="4" Rows="2" IsVisible="False">
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.duration}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtDuration" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.size}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtSize" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.resolution}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtResolution" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.fps}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtFps" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.video-codec}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtVideoCodec" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.audio}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtAudio" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.bitrate}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtBitrate" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{loc:Text main.info.hdr}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBlock x:Name="TxtHdr" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border x:Name="TargetPanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{loc:Text main.target.title}" Theme="{StaticResource H2}"/>
                    </StackPanel>
                    <!--
                      T61: hedef ve kalite tek Grid'de. İkinci sayı kutusunun genişliği
                      birinciyle aynı sütundan gelir; yeni bir piksel sayısı yazılmadı.
                    -->
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceMd}">
                      <Slider x:Name="SliderTarget" Minimum="1" Maximum="500" Value="16" VerticalAlignment="Center"/>
                      <TextBox x:Name="TxtTarget" Grid.Column="1" Text="16" Width="96" MaxLines="1" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                      <TextBlock Grid.Column="2" Text="{loc:Text main.unit.mb}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    <!--
                      T46/K1: yonga yalnız sayıyı gösterir. Açıklamanın tek yeri balondur ve
                      balonun ilk satırı yonganın eski etiketidir — etiket ekrandan kalktı,
                      bilgi kalkmadı.
                    -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="{StaticResource SpaceMd}">
                    <TextBlock x:Name="TxtTargetCrfLockedNotice"
                               Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"
                               Text="{loc:Text main.target.crf-locked}"/>
                    <WrapPanel x:Name="ChipStrip">
                      <Button x:Name="ChipArchive" Content="{loc:Text main.intent.archive}" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPresetArchive">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.archive.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip8" Content="8" Tag="8" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.8.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="ChipWhatsApp" Content="16" Tag="16" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <TextBlock Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.whatsapp.label}"/>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.whatsapp.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip25" Content="25" Tag="25" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.25.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip100" Content="100" Tag="100" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.100.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip128" Content="128" Tag="128" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <TextBlock Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.128.label}"/>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.128.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip180" Content="180" Tag="180" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <TextBlock Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.180.label}"/>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.180.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="ChipHalf" Content="{loc:Text main.chip.half}" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPresetHalf">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.half.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <!--
                        Kullanıcının kendi ön ayarları gömülü sekizin ardında, ince bir
                        ayırıcının arkasında duruyor; en son eleman her zaman "+". Ayırıcı
                        kullanıcı ön ayarı yokken görünmüyor.
                      -->
                      <Border x:Name="ChipUserSeparator" Width="1" IsVisible="False"
                              VerticalAlignment="Stretch"
                              Margin="{StaticResource WrapItemMargin}"
                              Background="{StaticResource NeonBlueBorder}"/>
                      <Button x:Name="ChipAddPreset" Content="+" Theme="{StaticResource ChipButton}" Classes="eylem"
                              Margin="{StaticResource WrapItemMargin}"
                              AutomationProperties.Name="{loc:Text main.preset.add.name}">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.preset.add.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="{StaticResource SpaceSm}" MinWidth="220">
                              <TextBlock Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.preset.name.label}"/>
                              <TextBox x:Name="TxtPresetName" MaxLength="60"/>
                              <TextBlock x:Name="TxtPresetNotice" Theme="{StaticResource Hint}"
                                         TextWrapping="Wrap" IsVisible="False"/>
                              <Button x:Name="BtnPresetSave" Content="{loc:Text main.preset.save}" Click="OnPresetSave"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </WrapPanel>
                    <TextBlock x:Name="TxtChipDerivation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <!--
                      Silme onay penceresi istemiyor: yonga kalkıyor, bu satır beliriyor ve
                      geri alma silinen ön ayarı geri yazıyor.
                    -->
                    <StackPanel x:Name="PresetUndoBar" Orientation="Horizontal" IsVisible="False"
                                Spacing="{StaticResource SpaceSm}">
                      <TextBlock x:Name="TxtPresetUndo" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <Button x:Name="BtnPresetUndo" Content="{loc:Text main.preset.undo}"
                              Theme="{StaticResource ChipButton}" Click="OnPresetUndo"/>
                    </StackPanel>
                    </StackPanel>

                      <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{loc:Text main.quality.title}" Theme="{StaticResource H2}"/>
                      <Slider x:Name="SliderQualityTarget" Grid.Row="3" Minimum="1" Maximum="100" Value="60" VerticalAlignment="Center"/>
                      <TextBox x:Name="TxtQualityTarget" Grid.Row="3" Grid.Column="1" Text="60" MaxLines="1" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                      <TextBlock Grid.Row="3" Grid.Column="2" Text="{loc:Text main.unit.score-suffix}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtQualityTargetNotice" Grid.Row="4" Grid.ColumnSpan="3" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    </Grid>
                    <Border Theme="{StaticResource PanelRule}"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock Grid.Column="0" Text="{loc:Text main.section.outcome}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" x:Name="TxtOutcomeSummary" Theme="{StaticResource MonoValue}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="SecQuality">
                      <Button x:Name="BtnQualityToggle"
                              Click="OnToggleQuality"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.quality}">
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphQuality" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text main.section.quality}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtQualitySummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="QualitySectionBody" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <!-- Kullanıcı 09-04: WhatsApp uyumu işaretlenirse eski kodek (H.264) kullanılır, kodek seçimi kilitlenir. -->
                        <CheckBox x:Name="ChkWhatsAppCompatible" Theme="{StaticResource CheckStyle}" IsChecked="False" HorizontalAlignment="Left" Content="{loc:Text main.whatsapp-compatible}"/>
                        <Grid x:Name="CodecChoiceRow" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <ToolTip.Tip>
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <TextBlock x:Name="TxtCodecTip" Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.codec.tip}"/>
                            </StackPanel>
                          </ToolTip.Tip>
                          <TextBlock Grid.Column="0" Text="{loc:Text main.codec.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                            <RadioButton x:Name="RbCodecAuto" GroupName="ShrinkCodec" IsChecked="True" Content="{loc:Text main.codec.automatic}"/>
                            <RadioButton x:Name="RbCodecCompatible" GroupName="ShrinkCodec" Content="{loc:Text main.codec.compatible}"/>
                            <RadioButton x:Name="RbCodecSmallest" GroupName="ShrinkCodec" Content="{loc:Text main.codec.smallest}"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.fill.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                            <RadioButton x:Name="RbFillTarget" GroupName="ShrinkFill" IsChecked="True" Content="{loc:Text main.fill.target}"/>
                            <RadioButton x:Name="RbFillCeiling" GroupName="ShrinkFill" Content="{loc:Text main.fill.ceiling}"/>
                          </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ChkFastGpu" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" HorizontalAlignment="Left" Content="{loc:Text main.fast-gpu}">
                          <ToolTip.Tip>
                            <TextBlock x:Name="TipFastGpu" Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.fast-gpu.tip}"/>
                          </ToolTip.Tip>
                        </CheckBox>
                        <StackPanel x:Name="HdrPolicyPanel" IsVisible="False">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                            <TextBlock Grid.Column="0" Text="{loc:Text main.hdr.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                              <RadioButton x:Name="RbHdrPreserve" GroupName="ShrinkHdr" IsChecked="True" Content="{loc:Text main.hdr.preserve}"/>
                              <RadioButton x:Name="RbHdrSdr" GroupName="ShrinkHdr" Content="{loc:Text main.hdr.sdr}"/>
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecAudio">
                      <Button x:Name="BtnAudioToggle"
                              Click="OnToggleAudio"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.audio}">
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphAudio" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text main.section.audio}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtAudioSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="AudioBody" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.audio-kbps.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvAudioKbps" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvAudioKbpsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.audio-channels.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvAudioChannels" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvAudioChannelsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ChkAdvKeepTracks" Theme="{StaticResource CheckStyle}" IsChecked="False" Content="{loc:Text main.advanced.keep-tracks.label}"/>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecFrame">
                      <Button x:Name="BtnFrameToggle"
                              Click="OnToggleFrame"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.frame}">
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphFrame" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text main.section.frame}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtFrameSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="FrameBody" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceLg}">
                          <CheckBox x:Name="ChkResolution" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="{loc:Text main.allow.resolution}"/>
                          <CheckBox x:Name="ChkFps" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="{loc:Text main.allow.fps}"/>
                        </StackPanel>
                        <!-- Kullanıcı 09-04: dinamik çözünürlük varsayılan; kutu kalkınca kullanıcı sabit boyu seçer. -->
                        <Grid x:Name="FixedResolutionRow" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}" IsVisible="False">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.fixed-resolution.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                            <RadioButton x:Name="RbFixedSource" GroupName="ShrinkFixedResolution" IsChecked="True" Content="{loc:Text main.fixed-resolution.source}"/>
                            <RadioButton x:Name="RbFixed1080" GroupName="ShrinkFixedResolution"/>
                            <RadioButton x:Name="RbFixed720" GroupName="ShrinkFixedResolution"/>
                            <RadioButton x:Name="RbFixed480" GroupName="ShrinkFixedResolution"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.min-resolution.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvMinResolution" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvMinResolutionNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.min-fps.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvMinFps" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvMinFpsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecAdvanced">
                      <Button x:Name="BtnAdvancedToggle"
                              Click="OnToggleAdvanced"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.advanced.title}">
                        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphAdvanced" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{loc:Text main.advanced.title}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtAdvancedSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="AdvancedBody" Spacing="{StaticResource SpaceMd}" IsVisible="False" Margin="{StaticResource RowMargin}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.mode.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}" VerticalAlignment="Center">
                              <RadioButton x:Name="RbAdvModeAuto" GroupName="AdvMode" IsChecked="True" Content="{loc:Text main.plan.automatic}"/>
                              <RadioButton x:Name="RbAdvModeCrf" GroupName="AdvMode" Content="{loc:Text main.advanced.mode.crf}"/>
                              <RadioButton x:Name="RbAdvModeTwoPass" GroupName="AdvMode" Content="{loc:Text main.advanced.mode.two-pass}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAdvModeNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.crf.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvCrf" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvCrfNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.preset.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvPreset" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvPresetNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.tune.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvTune" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvTuneNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.modulus.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvModulus" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Text main.advanced.modulus.hint}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.encoder-path.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}" VerticalAlignment="Center">
                              <RadioButton x:Name="RbAdvPathAuto" GroupName="AdvEncoderPath" IsChecked="True" Content="{loc:Text main.plan.automatic}"/>
                              <RadioButton x:Name="RbAdvPathSoftware" GroupName="AdvEncoderPath" Content="{loc:Text main.advanced.encoder-path.software}"/>
                              <RadioButton x:Name="RbAdvPathHardware" GroupName="AdvEncoderPath" Content="{loc:Text main.advanced.encoder-path.hardware}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAdvEncoderPathNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.codec-lock.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceMd}">
                            <ComboBox x:Name="CmbAdvCodecLock" SelectedIndex="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAdvCodecLockNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                          <TextBlock Grid.Column="0" Text="{loc:Text main.advanced.filters.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" HorizontalAlignment="Left" Spacing="{StaticResource SpaceXs}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}">
                              <TextBox x:Name="TxtAdvFilters" Width="280" VerticalAlignment="Center"
                                       auto:AutomationProperties.Name="{loc:Text main.advanced.filters.label}"/>
                              <TextBlock x:Name="TxtAdvFiltersNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Text main.advanced.filters.hint}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtAdvancedError" Theme="{StaticResource Hint}" Foreground="{StaticResource NeonPink}" TextWrapping="Wrap" IsVisible="False"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>

              <!--
                Orta sütun iki katmandır: üstte karşılaştırma paneli, altında yapılacak
                işlem paneli. Üç sütunlu düzen bozulmuyor — panel kendi sütununu almıyor,
                ortadaki sütunun başına giriyor (T43/K1).
              -->
              <!--
                T54/K4: artan yer önizlemeye gider. Önizleme esneyen satırdadır, plan
                paneli varsayılan olarak içeriği kadar büyür — istediği kadarını alır,
                kalanını önizlemeye bırakır. Eski düzende esneyen satır MaxHeight'lı plan
                panelindeydi ve artan yer kimseye gitmiyordu.

                T74/K1: "Preview" başlığı ve onu taşıyan Auto satır kaldırıldı. Yan
                sütunlar panelle başlıyor, orta sütun başlıkla başlıyordu; başlık gidince
                üç sütunun tepesi de aynı hizaya oturuyor.

                T163/K3: kullanıcının sürüklediği yer artık kalıcı. İkinci satırdaki
                GridSplitter üçüncü satırın (plan paneli) yüksekliğini değiştirir; hiç
                sürüklenmemişse satır Auto kalır ve K1/K2'nin ölçtüğü içerik-güdümlü
                boy geçerli olmaya devam eder — eski ölçüm burada bozulmuyor. Sürüklenince
                satır piksele döner, taban ve tavan PlanPanelRow üzerinde durur (GridSplitter
                onlara bakar), konum ApplySplitterSettings/OnSplitterMoved ile diske yazılır.
              -->
              <Grid Grid.Column="1" x:Name="PreviewPlanGrid" RowSpacing="{StaticResource SpaceMd}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"
                                 MinHeight="{StaticResource PlanPanelMinHeight}"
                                 MaxHeight="{StaticResource PlanPanelMaxHeight}"/>
                </Grid.RowDefinitions>

                <playback:ComparisonPanel Grid.Row="0" x:Name="Preview" VerticalAlignment="Stretch"/>

                <GridSplitter Grid.Row="1" x:Name="PlanSplitter" Theme="{StaticResource PlanSplitter}"
                              HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              auto:AutomationProperties.Name="{loc:Text main.plan.splitter}"/>

              <Border x:Name="PlanPanel"
                      Grid.Row="2"
                      Theme="{StaticResource Panel}"
                      MinHeight="{StaticResource PlanPanelMinHeight}"
                      MaxHeight="{StaticResource PlanPanelMaxHeight}">
                <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceMd}">
                  <TextBlock Grid.Row="0" Text="{loc:Text main.plan.title}" Theme="{StaticResource H2}"/>
                  <ScrollViewer Grid.Row="1" x:Name="PlanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <StackPanel x:Name="PlanBody" Spacing="{StaticResource SpaceMd}">
                      <TextBlock x:Name="TxtPlanEmpty" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text main.plan.empty}"/>
                      <Grid x:Name="PlanFacts" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}"/>
                      <Border x:Name="PlanRule" Theme="{StaticResource PanelRule}" IsVisible="False"/>
                      <!--
                        T46/K6: gerekçeler katlanır. Metin kısalmıyor, yalnız katlanıyor —
                        panelin varsayılan hâli planın net özeti (olgular), gerekçeler bir
                        tıkla açılıyor. Ölçüm: gerekçeler açıkken içerik görüş alanını
                        aşıyordu, katlıyken sığıyor.
                      -->
                      <Grid x:Name="PlanReasonsHead"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{StaticResource SpaceMd}"
                            IsVisible="False">
                        <TextBlock Grid.Column="0"
                                   x:Name="TxtPlanReasonsHead"
                                   Theme="{StaticResource H3}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="BtnPlanReasons"
                                Theme="{StaticResource GhostButton}"
                                VerticalAlignment="Center"
                                auto:AutomationProperties.Name="{loc:Text main.plan.reasons}"
                                Click="OnTogglePlanReasons">
                                  <Path x:Name="GlyphPlanReasons" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                                </Button>
                      </Grid>
                      <StackPanel x:Name="PlanReasons" Spacing="{StaticResource SpaceSm}" IsVisible="False"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>

              </Grid>

              <StackPanel Grid.Column="2" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="OutputPanel" Theme="{StaticResource Panel}" MinHeight="{StaticResource PanelMinHeight}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{loc:Text main.output.title}" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="Progress" Maximum="1"/>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="{StaticResource SpaceMd}"
                          RowSpacing="{StaticResource SpaceMd}">

                      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="{loc:Text main.output.stage}" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtStage" Text="{loc:Text main.output.idle}" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Grid.Row="0" Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="{loc:Text main.output.current-size}" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtOutSize" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="{loc:Text main.output.remaining}" Theme="{StaticResource OutFactLabel}"/>
                        <TextBlock x:Name="TxtRemaining" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" x:Name="LblDuration" Text="{loc:Text main.output.estimated-time}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Theme="{StaticResource InfoButton}" VerticalAlignment="Center" auto:AutomationProperties.Name="{loc:Text main.output.estimated-time}">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.output.estimated-time.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                        </Grid>
                        <TextBlock x:Name="TxtDurationValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock x:Name="TxtDurationRange" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="{StaticResource SpaceXs}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" x:Name="LblEstimate" Text="{loc:Text main.output.estimated-output}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Theme="{StaticResource InfoButton}" VerticalAlignment="Center" auto:AutomationProperties.Name="{loc:Text main.output.estimated-output}">
                            <ToolTip.Tip>
                              <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.output.estimated-output.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                        </Grid>
                        <TextBlock x:Name="TxtEstimateValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <TextBlock.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </TextBlock.Transitions>
                        </TextBlock>
                        <TextBlock x:Name="TxtEstimateRange" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtEstimateNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Border x:Name="RetryAskPanel"
                            IsVisible="False"
                            Background="{StaticResource NeonPinkFill}"
                            BorderBrush="{StaticResource NeonPink}"
                            BorderThickness="{StaticResource BorderThin}"
                            CornerRadius="{StaticResource RadiusCell}"
                            Padding="{StaticResource PanelPadding}">
                      <StackPanel Spacing="{StaticResource SpaceSm}">
                        <TextBlock Text="{loc:Text main.retry.title}" Theme="{StaticResource H3}"/>
                        <TextBlock x:Name="TxtRetryOutcome" Theme="{StaticResource PlanFactValue}"/>
                        <WrapPanel>
                          <Button x:Name="BtnRetryAgain" Content="{loc:Text main.retry.again}" Theme="{StaticResource PrimaryButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryAgain"/>
                          <Button x:Name="BtnRetryTrim" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryTrim"/>
                          <Button x:Name="BtnRetryAccept" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryAccept"/>
                          <Button x:Name="BtnRetryStop" Content="{loc:Text main.retry.stop}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryStop"/>
                        </WrapPanel>
                        <StackPanel x:Name="RetryTrimPanel" IsVisible="False" Spacing="{StaticResource SpaceSm}">
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                            <RadioButton x:Name="RbTrimEnd" GroupName="OvershootTrim" IsChecked="True" Content="{loc:Text main.retry.trim.end}"/>
                            <RadioButton x:Name="RbTrimStart" GroupName="OvershootTrim" Content="{loc:Text main.retry.trim.start}"/>
                            <RadioButton x:Name="RbTrimBoth" GroupName="OvershootTrim" Content="{loc:Text main.retry.trim.both}"/>
                          </StackPanel>
                          <TextBlock x:Name="TxtTrimRange" Theme="{StaticResource PlanFactValue}" TextWrapping="Wrap"/>
                          <Button x:Name="BtnTrimConfirm" Content="{loc:Text main.retry.trim.confirm}" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnTrimConfirm"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRetryMeaning" Theme="{StaticResource PlanReasonText}"/>
                      </StackPanel>
                    </Border>
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                      <WrapPanel>
                        <Button x:Name="BtnReveal" Content="{loc:Text main.action.show-in-folder}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnReveal"/>
                        <Button x:Name="BtnShare" Content="{loc:Text main.action.share}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnShare"/>
                        <Button x:Name="BtnShareCancel" Content="{loc:Text main.action.cancel-upload}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnShareCancel"/>
                        <Button x:Name="BtnShareRetry" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False"/>
                      </WrapPanel>
                      <ProgressBar x:Name="ShareProgress" Maximum="1" IsVisible="False"/>
                      <Grid x:Name="ShareLinkRow"
                            IsVisible="False"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{StaticResource SpaceMd}">
                        <TextBox Grid.Column="0"
                                 x:Name="TxtShareLink"
                                 IsReadOnly="True"
                                 MaxLines="1"
                                 FontFamily="{StaticResource FontMono}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="BtnShareCopy"
                                Content="{loc:Text main.action.copy}"
                                Theme="{StaticResource GhostButton}"
                                VerticalAlignment="Center"
                                Click="OnCopyShareLink"/>
                      </Grid>
                      <TextBlock x:Name="TxtShareStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </Border>


                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnCancel" Content="{loc:Text main.action.cancel}" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.cancel.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button x:Name="BtnStart" Content="{loc:Text main.action.shrink}" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnStart">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.shrink.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                </StackPanel>

              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Text main.tab.convert}" izi:AcilisIsareti.Ad="xaml-donusturme" Tag="{StaticResource IconConvert}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageConvert" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <Grid Margin="{StaticResource SectionMargin}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceXl}">

              <Border Grid.Column="0" Theme="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="{loc:Text main.convert.title}" Theme="{StaticResource H2}"/>
                  <TextBlock x:Name="TxtConvertSource" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                  <Button Content="{loc:Text main.convert.browse}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowse"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceLg}"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.container}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.container}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.container.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbContainer" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="MP4" Tag="mp4"/>
                        <ComboBoxItem Content="MKV" Tag="mkv"/>
                        <ComboBoxItem Content="WebM" Tag="webm"/>
                        <ComboBoxItem Content="MOV" Tag="mov"/>
                        <ComboBoxItem Content="AVI" Tag="avi"/>
                        <ComboBoxItem Content="GIF" Tag="gif"/>
                        <ComboBoxItem Content="MP3" Tag="mp3"/>
                        <ComboBoxItem Content="M4A" Tag="m4a"/>
                        <ComboBoxItem Content="WAV" Tag="wav"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.video-codec}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.video-codec}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.video-codec.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertCodec" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="H.264" Tag="libx264"/>
                        <ComboBoxItem Content="H.265" Tag="libx265"/>
                        <ComboBoxItem Content="VP9" Tag="libvpx-vp9"/>
                        <ComboBoxItem Content="AV1" Tag="libsvtav1"/>
                        <ComboBoxItem Content="{loc:Text main.convert.copy}" Tag="copy"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.quality-mode}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.quality-mode}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.quality-mode.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbQualityMode" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.advanced.mode.crf}"/>
                        <ComboBoxItem Content="{loc:Text main.convert.fixed-bitrate}"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.crf-label}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.crf-label}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.crf-label.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                        <Slider x:Name="SliderQuality" Minimum="10" Maximum="45" Value="23" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQuality" Grid.Column="1" Text="23" Width="96" MaxLines="1" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NeonBlue}"/>
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.resolution}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.resolution}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.resolution.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbResolution" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                        <ComboBoxItem Content="2160" Tag="2160"/>
                        <ComboBoxItem Content="1440" Tag="1440"/>
                        <ComboBoxItem Content="1080" Tag="1080"/>
                        <ComboBoxItem Content="720" Tag="720"/>
                        <ComboBoxItem Content="480" Tag="480"/>
                        <ComboBoxItem Content="{loc:Text main.convert.custom}" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.custom-resolution}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.custom-resolution}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.custom-resolution.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomResolution" Text="1280x720" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.frame-rate}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.frame-rate}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.frame-rate.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertFps" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                        <ComboBoxItem Content="60" Tag="60"/>
                        <ComboBoxItem Content="30" Tag="30"/>
                        <ComboBoxItem Content="24" Tag="24"/>
                        <ComboBoxItem Content="{loc:Text main.convert.custom}" Tag="custom"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.custom-fps}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.custom-fps}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.custom-fps.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtCustomFps" Text="25" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.audio}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.audio}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.audio.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <ComboBox x:Name="CmbConvertAudio" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="AAC" Tag="aac"/>
                        <ComboBoxItem Content="Opus" Tag="libopus"/>
                        <ComboBoxItem Content="MP3" Tag="libmp3lame"/>
                        <ComboBoxItem Content="PCM" Tag="pcm_s16le"/>
                        <ComboBoxItem Content="{loc:Text main.convert.copy}" Tag="copy"/>
                        <ComboBoxItem Content="{loc:Text main.convert.drop}"/>
                      </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.audio-bitrate}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.audio-bitrate}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.audio-bitrate.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtAudioBitrate" Text="128" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.trim-start}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.trim-start}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.trim-start.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimStart" MaxLines="1"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text main.convert.trim-end}" Theme="{StaticResource Label}"/>
                        <Button Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.trim-end}">
                          <ToolTip.Tip>
                            <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.trim-end.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </StackPanel>
                      <TextBox x:Name="TxtTrimEnd" MaxLines="1"/>
                    </StackPanel>

                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceLg}">
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{loc:Text main.convert.command}" Theme="{StaticResource H2}"/>
                    <TextBox x:Name="TxtConvertCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinLines="6" MaxLines="6"/>
                    <TextBlock x:Name="TxtConvertValidation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{loc:Text main.convert.progress}" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="ConvertProgress" Maximum="1"/>
                    <TextBlock x:Name="TxtConvertStage" Text="{loc:Text main.output.idle}" Theme="{StaticResource MonoValue}">
                      <TextBlock.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                        </Transitions>
                      </TextBlock.Transitions>
                    </TextBlock>
                    <TextBlock x:Name="TxtConvertResult" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnConvertReveal" Content="{loc:Text main.action.show-in-folder}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnConvertCancel" Content="{loc:Text main.action.cancel}" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.cancel.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button x:Name="BtnConvert" Content="{loc:Text main.action.convert}" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnConvert">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.convert.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Text main.tab.about}" izi:AcilisIsareti.Ad="xaml-hakkinda" Tag="{StaticResource IconAbout}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <Border Theme="{StaticResource Panel}" Margin="{StaticResource SectionMargin}">
              <StackPanel Spacing="{StaticResource SpaceMd}">
                <TextBlock Text="{loc:Text main.about.title}" Theme="{StaticResource H2}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.intro}"/>
                <TextBlock Text="{loc:Text main.about.engine.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.engine.body}"/>
                <TextBlock Text="{loc:Text main.about.measured.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource MonoValue}" FontWeight="Normal" Text="{loc:Text main.about.measured.table}"/>
                <TextBlock Text="{loc:Text main.about.loss.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.loss.body}"/>
                <TextBlock Text="{loc:Text main.about.scenario.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.scenario.body}"/>
                <TextBlock Text="{loc:Text main.about.ai.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.ai.body}"/>
                <TextBlock Text="{loc:Text main.about.codecs.title}" Theme="{StaticResource H3}"/>
                <TextBlock Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.codecs.body}"/>
                <TextBlock Text="{loc:Text main.about.status.title}" Theme="{StaticResource H3}"/>
                <TextBlock x:Name="TxtSystemStatus" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"
                           Cursor="Hand" PointerPressed="OnSystemStatusTapped"/>
                <TextBlock Text="{loc:Text main.about.platforms.title}" Theme="{StaticResource H3}"/>
                <TextBlock x:Name="TxtPlatforms" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </TabItem>

          <TabItem Header="{loc:Text main.tab.recorder}" izi:AcilisIsareti.Ad="xaml-kaydedici" x:Name="TabRecorder" Tag="{StaticResource IconRecorder}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageRecorder" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          </ScrollViewer>
        </TabItem>

          <TabItem x:Name="TabAdvanced" IsVisible="False" izi:AcilisIsareti.Ad="xaml-gelismis" Header="{loc:Text main.tab.advanced}" Tag="{StaticResource IconAdvanced}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageAdvanced" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <StackPanel Margin="{StaticResource SectionMargin}" Spacing="{StaticResource SpaceLg}">

              <Button x:Name="BtnHideAdvanced" Theme="{StaticResource GhostButton}"
                      HorizontalAlignment="Right"
                      Content="{loc:Text main.window.close}"
                      Click="OnHideAdvanced"/>

              <Border x:Name="CommandPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <TextBlock Grid.Column="0" Text="{loc:Text main.command.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="BtnCommandExpand"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="{loc:Text main.command.title}"
                            Click="OnToggleCommand">
                              <Path x:Name="GlyphCommand" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                  </Grid>
                  <TextBox x:Name="TxtCommand" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinLines="1" MaxLines="1"/>
                </StackPanel>
              </Border>

              <Border x:Name="AiPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <TextBlock Grid.Column="0" Text="{loc:Text main.ai.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="TxtAiHint"
                               Text="{loc:Text main.ai.tip}"
                               Theme="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                      <ToolTip.Tip>
                        <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.ai.tip}"/>
                      </ToolTip.Tip>
                    </TextBlock>
                    <Button Grid.Column="2"
                            x:Name="BtnAiDetails"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="{loc:Text main.ai.title}"
                            Click="OnToggleAiDetails">
                              <Path x:Name="GlyphAiDetails" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                  </Grid>
                  <StackPanel x:Name="AiDetails" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <TextBlock Text="{loc:Text main.ai.tip}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="{loc:Text main.ai.copy-prompt}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnCopyPrompt"/>
                      <Button Content="{loc:Text main.ai.apply-json}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnApplyJson"/>
                      <Button x:Name="BtnRevert" Content="{loc:Text main.ai.revert}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnRevertAuto"/>
                    </WrapPanel>
                    <TextBox x:Name="TxtAiJson" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="4"/>
                    <TextBlock x:Name="TxtAiStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="PerformancePanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <TextBlock Grid.Column="0" Text="{loc:Text performance.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="BtnPerformanceExpand"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="{loc:Text performance.title}"
                            Click="OnTogglePerformance">
                              <Path x:Name="GlyphPerformance" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                  </Grid>
                  <StackPanel x:Name="PerformanceDetails" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <WrapPanel>
                      <Button x:Name="BtnPerformanceRun"
                              Content="{loc:Text performance.run}"
                              Theme="{StaticResource GhostButton}"
                              Margin="{StaticResource WrapItemMargin}"
                              Click="OnRunPerformanceCheck"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtPerformanceStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PerformanceFacts" Spacing="{StaticResource SpaceMd}"/>
                    <StackPanel x:Name="PerformanceLines" Spacing="{StaticResource SpaceMd}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Text main.tab.settings}" izi:AcilisIsareti.Ad="xaml-ayarlar" x:Name="TabSettings" Tag="{StaticResource IconSettings}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <StackPanel Margin="{StaticResource SectionMargin}" Spacing="{StaticResource SpaceLg}">

              <Border x:Name="GeneralSettingsPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="{loc:Text settings-tab.general.title}" Theme="{StaticResource H2}"/>

                  <!--
                    Kullanıcı 09-07: ayarlar derli toplu olsun, iki seçenekli açılır liste olmasın.
                    Dil ve tema yan yana; çıktı klasörü ve ffmpeg yolu iki seçenekli radyo şeridi.
                  -->
                  <Grid x:Name="LanguageThemeRow" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceSm}">
                      <TextBlock Text="{loc:Text settings-tab.language.label}" Theme="{StaticResource Label}"/>
                      <ComboBox x:Name="CmbLanguage" HorizontalAlignment="Stretch"/>
                      <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.language.hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <TextBlock Text="{loc:Text settings-tab.theme.label}" Theme="{StaticResource Label}"/>
                      <ComboBox x:Name="CmbTheme" HorizontalAlignment="Stretch"/>
                      <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.theme.hint}"/>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceSm}">
                      <TextBlock Text="{loc:Text settings-tab.default-target.label}" Theme="{StaticResource Label}"/>
                      <TextBox x:Name="TxtDefaultTargetMb" Width="120" HorizontalAlignment="Left" MaxLines="1" TextAlignment="Center"/>
                      <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.default-target.hint}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <CheckBox x:Name="ChkAdvancedDefaultOpen" Theme="{StaticResource CheckStyle}" Content="{loc:Text settings-tab.advanced-default-open.label}"/>
                      <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.advanced-default-open.hint}"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <CheckBox x:Name="ChkFollowRecording" Theme="{StaticResource CheckStyle}" Content="{loc:Text settings-tab.follow-recording.label}"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.follow-recording.hint}"/>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock Grid.Column="0" Text="{loc:Text settings-tab.output-folder.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                        <RadioButton x:Name="RbOutputBesideSource" GroupName="OutputFolderMode" IsChecked="True" Content="{loc:Text settings-tab.output-folder.beside-source}"/>
                        <RadioButton x:Name="RbOutputFixed" GroupName="OutputFolderMode" Content="{loc:Text settings-tab.output-folder.fixed}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel x:Name="OutputFolderPickerRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" IsVisible="False">
                      <TextBox x:Name="TxtOutputFolder" Width="360" MaxLines="1" IsReadOnly="True"/>
                      <Button x:Name="BtnBrowseOutputFolder" Content="{loc:Text settings-tab.output-folder.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowseOutputFolder"/>
                    </StackPanel>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.output-folder.hint}"/>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock Grid.Column="0" Text="{loc:Text settings-tab.output-name.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceSm}">
                        <TextBox x:Name="TxtOutputName" Width="360" MaxLines="1"/>
                        <Button x:Name="BtnResetOutputName" Content="{loc:Text settings-tab.output-name.reset}" Theme="{StaticResource GhostButton}" Click="OnResetOutputName"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LblOutputNamePreview" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.output-name.hint}"/>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <TextBlock Grid.Column="0" Text="{loc:Text settings-tab.ffmpeg-path.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">
                        <RadioButton x:Name="RbFfmpegAuto" GroupName="FfmpegPathMode" IsChecked="True" Content="{loc:Text settings-tab.ffmpeg-path.auto}"/>
                        <RadioButton x:Name="RbFfmpegManual" GroupName="FfmpegPathMode" Content="{loc:Text settings-tab.ffmpeg-path.manual}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel x:Name="FfmpegPathPickerRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" IsVisible="False">
                      <TextBox x:Name="TxtFfmpegPath" Width="360" MaxLines="1"/>
                      <Button x:Name="BtnBrowseFfmpegPath" Content="{loc:Text settings-tab.ffmpeg-path.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowseFfmpegPath"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtFfmpegPathError" Theme="{StaticResource Hint}" Foreground="{StaticResource NeonPink}" TextWrapping="Wrap" IsVisible="False"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.ffmpeg-path.hint}"/>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Text="{loc:Text settings-tab.opensubtitles.label}" Theme="{StaticResource Label}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <TextBox x:Name="TxtOpenSubtitlesKey" Width="360" MaxLines="1" PasswordChar="*"/>
                      <Button x:Name="BtnOpenSubtitlesKey" Content="{loc:Text settings-tab.opensubtitles.get}" Theme="{StaticResource GhostButton}" Click="OnOpenSubtitlesKeyPage"/>
                    </StackPanel>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.opensubtitles.hint}"/>

                    <TextBlock Text="{loc:Text settings-tab.opensubtitles.account}" Theme="{StaticResource Label}" Margin="0"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="{loc:Text settings-tab.opensubtitles.user}" Theme="{StaticResource Label}" Margin="0"/>
                        <TextBox x:Name="TxtOpenSubtitlesUser" Width="180" MaxLines="1"
                                 auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.user}"/>
                      </StackPanel>
                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <TextBlock Text="{loc:Text settings-tab.opensubtitles.password}" Theme="{StaticResource Label}" Margin="0"/>
                        <TextBox x:Name="TxtOpenSubtitlesPassword" Width="180" MaxLines="1" PasswordChar="*"
                                 auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.password}"/>
                      </StackPanel>
                      <Button x:Name="BtnOpenSubtitlesSignIn" Content="{loc:Text settings-tab.opensubtitles.signin}" Theme="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="OnOpenSubtitlesSignIn"/>
                      <Button x:Name="BtnOpenSubtitlesSignOut" Content="{loc:Text settings-tab.opensubtitles.signout}" Theme="{StaticResource GhostButton}" VerticalAlignment="Bottom" Click="OnOpenSubtitlesSignOut"/>
                    </StackPanel>
                    <TextBlock x:Name="LblOpenSubtitlesStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.opensubtitles.signedout}"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.opensubtitles.accounthint}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="ShellMenuPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="{loc:Text settings-tab.shell-menu.title}" Theme="{StaticResource H2}"/>
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.shell-menu.label}"/>
                    <CheckBox x:Name="ChkShellMenuOpen" Theme="{StaticResource CheckStyle}" Content="{loc:Text shell.menu.open}"/>
                    <CheckBox x:Name="ChkShellMenuShrink" Theme="{StaticResource CheckStyle}" Content="{loc:Text shell.menu.shrink}"/>
                    <TextBlock Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.shell-menu.hint}"/>
                    <TextBlock x:Name="TxtShellMenuStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="SharePanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Text settings.share.title}" Theme="{StaticResource H2}"/>
                    <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="{loc:Text settings.share.title}">
                      <ToolTip.Tip>
                        <TextBlock Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings.share.tip}"/>
                      </ToolTip.Tip>
                    </Button>
                  </StackPanel>

                  <WrapPanel x:Name="ShareTargetStrip" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}"/>

                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="{StaticResource SpaceMd}"
                        RowSpacing="{StaticResource SpaceSm}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text settings.share.ceiling}" Theme="{StaticResource PlanFactLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtShareCeiling" Theme="{StaticResource PlanFactValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text settings.share.lifetime}" Theme="{StaticResource PlanFactLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <ComboBox x:Name="CmbShareRetention" HorizontalAlignment="Left"/>
                      <TextBlock x:Name="TxtShareRetentionFixed" Theme="{StaticResource PlanFactValue}" IsVisible="False"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Text settings.share.deletion}" Theme="{StaticResource PlanFactLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnShareDelete"
                              Content="{loc:Text settings.share.delete}"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Left"
                              IsEnabled="False"
                              Click="OnShareDelete">
                        <Button.Styles>
                          <Style Selector="Button:disabled">
                            <Setter Property="ToolTip.Tip" Value="{loc:Text settings.share.delete.disabled-tip}"/>
                          </Style>
                        </Button.Styles>
                      </Button>
                      <TextBlock x:Name="TxtShareDeleteNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border x:Name="UpdatePanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <TextBlock Text="{loc:Text settings.update.title}" Theme="{StaticResource H2}"/>
                  <StackPanel x:Name="AutoUpdateRow" Orientation="Horizontal">
                    <CheckBox x:Name="ChkAutoUpdate" Theme="{StaticResource CheckStyle}" Content="{loc:Text settings.update.auto}"/>
                  </StackPanel>
                  <TextBlock x:Name="TxtAutoUpdateEffect"
                             Theme="{StaticResource Hint}"
                             TextWrapping="Wrap"
                             Text="{loc:Text settings.update.auto-effect}"/>
                </StackPanel>
              </Border>

              <playback:PlayerShortcutsPanel x:Name="PlayerShortcutsPanel"/>

              <playback:PlayerAdvancedPanel x:Name="PlayerAdvancedPanel"/>

              <Border x:Name="DiagnosticLogPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                  <TextBlock Text="{loc:Text settings.log.title}" Theme="{StaticResource Subtitle}"/>
                  <TextBlock Text="{loc:Text settings.log.hint}" Theme="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <Button x:Name="BtnOpenLog"
                          Content="{loc:Text settings.log.open}"
                          Theme="{StaticResource GhostButton}"
                          HorizontalAlignment="Left"
                          Click="OnOpenLog"/>
                </StackPanel>
              </Border>

              <Border x:Name="ResetSettingsPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Button x:Name="BtnResetSettings"
                          Content="{loc:Text settings.reset-all}"
                          Theme="{StaticResource GhostButton}"
                          HorizontalAlignment="Left"
                          Click="OnResetSettings"/>
                  <StackPanel x:Name="ResetSettingsConfirm" IsVisible="False" Spacing="{StaticResource SpaceSm}">
                    <TextBlock x:Name="TxtResetSettingsConfirm" Text="{loc:Text settings.reset-confirm}" Theme="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnConfirmResetSettings" Content="{loc:Text settings.reset-confirm-button}" Theme="{StaticResource GhostButton}" Click="OnConfirmResetSettings"/>
                      <Button x:Name="BtnCancelResetSettings" Content="{loc:Text settings.reset-cancel}" Theme="{StaticResource GhostButton}" Click="OnCancelResetSettings"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>



      </TabControl>

      <Border x:Name="TitleBarLayer" izi:AcilisIsareti.Ad="xaml-sekmeler-bitti"
              VerticalAlignment="Top"
              Height="{StaticResource TitleBarHeight}">
        <!--
          Sağda boşluk yok: kapatma düğmesi pencerenin sağ kenarına dayanır. Ekranın köşesi
          işaretçiyle vurulması en kolay hedeftir ve fare orada durur; araya konan her piksel
          o kazancı siler. Soldaki 16 px başlık için duruyor.
        -->
        <Grid x:Name="TitleBarContent" Margin="{StaticResource TitleBarContentMargin}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceXl}">
          <StackPanel Grid.Column="0" x:Name="TitleBrand" IsHitTestVisible="False" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
            <Image x:Name="AppLogo" Width="24" Height="24" Stretch="Uniform" IsVisible="False"/>
            <TextBlock x:Name="TxtAppName" Theme="{StaticResource H2}" VerticalAlignment="Center">
              <Run Text="Vid"/><Run Text="Shrink" Foreground="{StaticResource PinkText}"/>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" x:Name="TitleBarRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="BtnUpdateBadge" Theme="{StaticResource TitleBarLinkButton}" IsVisible="False"
                    ToolTip.Tip="{loc:Text main.update.checking}" Click="OnUpdateBadgeClicked">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Ellipse x:Name="UpdateBadgeDot" Width="{StaticResource BadgeDotSize}" Height="{StaticResource BadgeDotSize}"
                         VerticalAlignment="Center" Fill="{StaticResource TextDisabled}"/>
                <TextBlock x:Name="TxtUpdateBadge" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource WindowButtonMargin}">
              <StackPanel x:Name="LangSwitch" Orientation="Horizontal"/>
            </StackPanel>
            <Button x:Name="BtnSponsor" Theme="{StaticResource TitleBarSupportButton}" auto:AutomationProperties.Name="Buy Me a Coffee" Click="OnOpenSponsor">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" VerticalAlignment="Center"
                      Data="{StaticResource IconCoffee}" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock x:Name="TxtSponsor" Text="Buy Me a Coffee" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnGitHub" Theme="{StaticResource TitleBarLinkButton}" auto:AutomationProperties.Name="Teknesyum" Click="OnOpenGitHub">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" VerticalAlignment="Center"
                      Data="{StaticResource IconCode}" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock x:Name="TxtGitHub" Text="Teknesyum" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <!--
              Üç düğme Windows'taki gibi bitişik dikdörtgen: aralarında boşluk yok, başlık
              çubuğu boyunca tam yükseklikte. Soldaki tek boşluk imza bloğundan ayırmak için.
            -->
            <StackPanel x:Name="WindowButtons" Orientation="Horizontal" VerticalAlignment="Stretch"
                        Margin="{StaticResource WindowButtonMargin}">
              <Button x:Name="BtnMinimize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="{loc:Text main.window.minimize}" auto:AutomationProperties.Name="{loc:Text main.window.minimize}" Click="OnMinimize">
                <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                      Data="{StaticResource IconMinimize}" Fill="{Binding $parent[Button].Foreground}"/>
              </Button>
              <Button x:Name="BtnMaximize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="{loc:Text main.window.maximize}" auto:AutomationProperties.Name="{loc:Text main.window.maximize}" Click="OnMaximizeRestore">
                <Path x:Name="MaximizeGlyph" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                      Data="{StaticResource IconMaximize}" Fill="{Binding $parent[Button].Foreground}"/>
              </Button>
              <Button x:Name="BtnClose" Theme="{StaticResource CloseWindowButton}" ToolTip.Tip="{loc:Text main.window.close}" auto:AutomationProperties.Name="{loc:Text main.window.close}" Click="OnClose">
                <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                      Data="{StaticResource IconClose}" Fill="{Binding $parent[Button].Foreground}"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
