     <Border x:Name="TargetPanel" Style="{StaticResource Panel}" Margin="0,16,0,0" MinHeight="260">
<StackPanel>
<StackPanel Orientation="Horizontal">
<TextBlock Text="Target" Style="{StaticResource H2}"/>
<Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="The target is a hard ceiling: VidShrink never hands you a file larger than this. WhatsApp accepts files up to 2 GB, but it re-compresses any video you send in chat, and its own encoder is far weaker than this one. Staying at or below 16 MB keeps VidShrink's quality instead of WhatsApp's. 25 MB fits Discord and most e-mail, 8 MB fits older forums and chat apps."/></Button.ToolTip></Button>
</StackPanel>
<Grid Margin="0,14,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="12"/>
<ColumnDefinition Width="82"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<Slider x:Name="SliderTarget" Minimum="1" Maximum="500" Value="16" ValueChanged="OnTargetSliderChanged" VerticalAlignment="Center"/>
<TextBox x:Name="TxtTarget" Grid.Column="2" Text="16" Foreground="{StaticResource NeonBlue}" FontWeight="Bold" TextChanged="OnTargetTextChanged"/>
<TextBlock Grid.Column="4" Text="MB" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
</Grid>
<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
<Button x:Name="ChipWhatsApp" Content="WhatsApp 16" Tag="16" Style="{StaticResource ChipButton}" Click="OnPreset"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="WhatsApp re-encodes in-chat video with its own low-bitrate encoder. Under 16 MB it usually passes your file through with far less damage, so what the other side sees is VidShrink's quality, not WhatsApp's. To bypass re-encoding entirely, send the result as a document instead of as a video."/></Button.ToolTip></Button>
<Button Content="8" Tag="8" Style="{StaticResource ChipButton}" Click="OnPreset"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="8 MB fits Discord without Nitro, older forums, and strict e-mail gateways."/></Button.ToolTip></Button>
<Button Content="25" Tag="25" Style="{StaticResource ChipButton}" Click="OnPreset"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="25 MB fits Gmail attachments, Discord Nitro Basic, and most ticket systems."/></Button.ToolTip></Button>
<Button Content="100" Tag="100" Style="{StaticResource ChipButton}" Click="OnPreset"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="100 MB suits archiving and uploads where quality matters more than transfer time."/></Button.ToolTip></Button>
<Button Content="Half" Style="{StaticResource ChipButton}" Click="OnPresetHalf"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="Half of the source size. A mild request, so the engine usually keeps the original resolution and frame rate."/></Button.ToolTip></Button>
</StackPanel>
<Grid Margin="0,16,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="16"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<StackPanel>
<StackPanel Orientation="Horizontal">
<TextBlock Text="Intent" Style="{StaticResource Label}"/>
<Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="Intent sets how early the engine stops spending bits. Archive stops only at visually lossless quality, so it can leave a lot of the target unused. Sharing stops at the point where a normal viewer stops noticing — the right choice for WhatsApp. Social Media stops earlier still, because the platform will re-encode the file anyway."/></Button.ToolTip></Button>
</StackPanel>
<ComboBox x:Name="CmbIntent" Margin="0,4,0,0" SelectedIndex="1" SelectionChanged="OnOptionChanged">
<ComboBoxItem Content="Archive"/>
<ComboBoxItem Content="Sharing"/>
<ComboBoxItem Content="Social Media"/>
</ComboBox>
</StackPanel>
<StackPanel Grid.Column="2">
<StackPanel Orientation="Horizontal">
<TextBlock Text="Compression Algorithm" Style="{StaticResource Label}"/>
<Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="H.264 is the universal one: every phone made in the last fifteen years plays it, and WhatsApp never has to re-encode it. H.265 needs roughly a third fewer bits for the same picture, so it wins badly compressed targets — but some older Android phones and some web players refuse it. NVENC runs on the graphics card and is many times faster, at the cost of noticeably worse quality per megabyte; use it for long files you are not squeezing hard. Automatic picks H.264 for mild targets and H.265 once the target is tight enough that the quality gain outweighs the compatibility risk."/></Button.ToolTip></Button>
</StackPanel>
<ComboBox x:Name="CmbCodec" Margin="0,4,0,0" SelectedIndex="0" SelectionChanged="OnOptionChanged">
<ComboBoxItem Content="Automatic - Engine Decides"/>
<ComboBoxItem Content="Compatible - H.264"/>
<ComboBoxItem Content="Max Compression - H.265"/>
<ComboBoxItem Content="Fast - NVENC"/>
</ComboBox>
</StackPanel>
</Grid>
<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
<CheckBox x:Name="ChkResolution" Style="{StaticResource CheckStyle}" IsChecked="True" Content="May Lower Resolution" Click="OnOptionChanged"/>
<Button Content="?" Style="{StaticResource InfoButton}" Margin="6,-2,24,0"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="When the target is tight, fewer pixels encoded well beat many pixels encoded badly — blur is far less objectionable than blocking. The engine measures how much this particular clip actually saves by scaling down, then picks the largest resolution the budget can still hold cleanly. On a phone screen a well-encoded 720p is indistinguishable from 1080p; leaving this on is almost always the better trade."/></Button.ToolTip></Button>
<CheckBox x:Name="ChkFps" Style="{StaticResource CheckStyle}" IsChecked="True" Content="May Lower Frame Rate" Click="OnOptionChanged"/>
<Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="Halving the frame rate frees bits for the frames that remain. The engine only does this on hard targets and never drops below a level where motion starts to stutter. Every phone plays reduced frame rates without trouble; the cost is smoothness, not compatibility."/></Button.ToolTip></Button>
</StackPanel>
<StackPanel x:Name="HdrPolicyPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
<TextBlock Text="HDR" Style="{StaticResource Label}" VerticalAlignment="Center"/>
<ComboBox x:Name="CmbHdrPolicy" Width="170" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="OnOptionChanged">
<ComboBoxItem Content="Preserve HDR"/>
<ComboBoxItem Content="Convert to SDR"/>
</ComboBox>
<Button Content="?" Style="{StaticResource InfoButton}" Margin="6,-2,0,0"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="Preserving HDR keeps the source's wider color and brightness range, but the file is larger 10-bit and only recent devices and apps play it correctly. Converting to SDR tone-maps the picture down to the standard range — smaller, and safe for WhatsApp and any phone."/></Button.ToolTip></Button>
</StackPanel>
</StackPanel>
</Border>
     <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
<StackPanel>
<TextBlock Text="What It Will Do" Style="{StaticResource H2}"/>
<TextBlock x:Name="TxtPlanSummary" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,12,0,0"/>
<TextBlock x:Name="TxtPlanReason" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
<TextBlock Text="FFmpeg Command" Style="{StaticResource Label}" Margin="0,12,0,4"/>
<TextBox x:Name="TxtCommand" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100"/>
</StackPanel>
</Border>
</StackPanel>
    <StackPanel Grid.Column="2">
<Border Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="AI Settings" Style="{StaticResource H2}"/>
<TextBlock Text="Optional. Copy a prompt to any chat AI, then paste and validate its JSON answer." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0"/>
<StackPanel Orientation="Horizontal" Margin="0,14,0,0">
<Button Content="Copy Prompt" Style="{StaticResource GhostButton}" Click="OnCopyPrompt"/>
<Button Content="Apply Pasted JSON" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnApplyJson"/>
</StackPanel>
<TextBox x:Name="TxtAiJson" Height="150" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap"/>
<TextBlock x:Name="TxtAiStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
<Button x:Name="BtnRevert" Content="Back To Automatic" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnRevertAuto"/>
</StackPanel>
</Border>
<Border Style="{StaticResource Panel}" Margin="0,16,0,0" MinHeight="254">
<StackPanel>
<TextBlock Text="Output" Style="{StaticResource H2}" Foreground="{StaticResource NeonBlue}"/>
<ProgressBar x:Name="Progress" Height="5" Maximum="1" Margin="0,14,0,0"/>
<UniformGrid Columns="2" Margin="0,12,0,0">
<StackPanel>
<TextBlock Text="Stage" Style="{StaticResource Label}" Foreground="{StaticResource NeonBlue}"/>
<TextBlock x:Name="TxtStage" Text="Idle" Style="{StaticResource MonoValue}"/>
</StackPanel>
<StackPanel>
<TextBlock Text="Remaining" Style="{StaticResource Label}" Foreground="{StaticResource NeonBlue}"/>
<TextBlock x:Name="TxtRemaining" Text="-" Style="{StaticResource MonoValue}"/>
</StackPanel>
</UniformGrid>
<UniformGrid Columns="2" Margin="0,12,0,0">
<StackPanel>
<TextBlock Text="Current Output Size" Style="{StaticResource Label}" Foreground="{StaticResource NeonBlue}"/>
<TextBlock x:Name="TxtOutSize" Text="-" Style="{StaticResource MonoValue}" FontSize="24"/>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal">
<TextBlock x:Name="LblEstimate" Text="Estimated Output" Style="{StaticResource Label}" Foreground="{StaticResource NeonBlue}"/>
<Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="Before planning, VidShrink encodes short samples of this exact clip at two resolutions and measures how many bits it really needs — it does not guess from the source bitrate. That is why the estimate is a measured number with a narrow range rather than a rule of thumb. Two-pass runs land within a few percent; quality-capped runs come in under the target on purpose, because spending the rest would buy nothing you could see."/></Button.ToolTip></Button>
</StackPanel>
<TextBlock x:Name="TxtEstimateValue" Style="{StaticResource MonoValue}" FontSize="24" Text="-"/>
<TextBlock x:Name="TxtEstimateRange" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
</StackPanel>
</UniformGrid>
<TextBlock x:Name="TxtEstimateNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TextBlock x:Name="TxtStrategyNote" Foreground="{StaticResource NeonBlue}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
<TextBlock x:Name="TxtResult" Style="{StaticResource Body}" TextWrapping="Wrap"/>
<Button x:Name="BtnReveal" Content="Show In Folder" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnReveal"/>
</StackPanel>
</Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
<Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel"/>
<Button x:Name="BtnStart" Content="Shrink" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" IsEnabled="False" Click="OnStart"/>
</StackPanel>
</StackPanel>
   </Grid>
</ScrollViewer>
</TabItem>
   <TabItem Header="Convert" Style="{StaticResource NeonTabItem}">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<Grid Margin="0,16,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="20"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
<Border Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="Conversion" Style="{StaticResource H2}"/>
<TextBlock x:Name="TxtConvertSource" Text="Load a source in Shrink or browse here." Style="{StaticResource Body}" Margin="0,10,0,10"/>
<Button Content="Browse Source" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowse"/>
<UniformGrid Columns="2" Margin="-8,16,-8,0">
<UniformGrid.Resources>
<Style TargetType="StackPanel"><Setter Property="Margin" Value="8,0,8,18"/></Style>
</UniformGrid.Resources>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Container" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="The container is the file type. MP4 is the safest general choice and the only one WhatsApp reliably sends as a playable video — every phone opens it. MKV supports many stream types but WhatsApp and most phone galleries treat it as a document. WebM is for browsers and is not a phone format. MOV suits Apple workflows and plays on iPhone, but Android support is uneven. AVI is for older software only. MP3, M4A, and WAV create audio-only files."/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbContainer" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="MP4"/>
<ComboBoxItem Content="MKV"/>
<ComboBoxItem Content="WebM"/>
<ComboBoxItem Content="MOV"/>
<ComboBoxItem Content="AVI"/>
<ComboBoxItem Content="GIF"/>
<ComboBoxItem Content="MP3"/>
<ComboBoxItem Content="M4A"/>
<ComboBoxItem Content="WAV"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Video Codec" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="H.264 plays on essentially every device ever made and is what WhatsApp expects; pick it when the file has to just work. H.265 makes files roughly a third smaller at the same picture, and every phone since about 2016 decodes it in hardware — but older handsets, some smart TVs, and several web players will not open it, and WhatsApp may re-encode it. VP9 is a browser and WebM format; phones play it in apps but rarely in the gallery. AV1 compresses best and is the slowest to encode, and only recent phones decode it. Copy keeps the original video untouched with no quality loss and no waiting, whenever the chosen container accepts it."/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbConvertCodec" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="H.264"/>
<ComboBoxItem Content="H.265"/>
<ComboBoxItem Content="VP9"/>
<ComboBoxItem Content="AV1"/>
<ComboBoxItem Content="Copy"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Quality Mode" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="CRF targets visual quality, so final size can vary. Fixed Bitrate targets a data rate, making file size more predictable. Use CRF for normal viewing quality and Fixed Bitrate when size or bandwidth matters more." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbQualityMode" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="CRF"/>
<ComboBoxItem Content="Fixed Bitrate"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="CRF Quality / Bitrate K" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="In CRF mode, a lower number means higher quality and a larger file; 23 is a common H.264 starting point. In Fixed Bitrate mode, enter kilobits per second: a higher value gives more quality and a larger file." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<Grid Height="42">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="12"/>
<ColumnDefinition Width="72"/>
</Grid.ColumnDefinitions>
<Slider x:Name="SliderQuality" Minimum="0" Maximum="51" Value="23" ValueChanged="OnQualitySliderChanged" VerticalAlignment="Center"/>
<TextBox x:Name="TxtQuality" Grid.Column="2" Height="42" Text="23" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NeonBlue}" Padding="8,4" TextChanged="OnQualityTextChanged"/>
</Grid>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Resolution" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Source keeps the original dimensions. A numbered option limits output height while preserving aspect ratio. Lower resolution reduces file size and processing demand. Custom allows an exact width and height." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbResolution" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="Source"/>
<ComboBoxItem Content="2160"/>
<ComboBoxItem Content="1440"/>
<ComboBoxItem Content="1080"/>
<ComboBoxItem Content="720"/>
<ComboBoxItem Content="480"/>
<ComboBoxItem Content="Custom"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Custom Width x Height" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Used only when Resolution is Custom. Enter width and height as 1280x720. Even dimensions are the safest choice for common video codecs." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<TextBox x:Name="TxtCustomResolution" Text="1280x720" TextChanged="OnConvertChanged"/>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Frame Rate" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Source preserves the original frame rate. 60 is smoother but needs more data. 30 suits most video. 24 gives a cinema-like motion style. Reducing frame rate can reduce file size." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbConvertFps" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="Source"/>
<ComboBoxItem Content="60"/>
<ComboBoxItem Content="30"/>
<ComboBoxItem Content="24"/>
<ComboBoxItem Content="Custom"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Custom FPS" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Used only when Frame Rate is Custom. Enter the desired frames per second, such as 25 or 29.97. Values above the source frame rate usually add no real motion detail." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<TextBox x:Name="TxtCustomFps" Text="25" TextChanged="OnConvertChanged"/>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Audio" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Style="{StaticResource TipText}" Text="AAC is the safe pairing for MP4 and the only audio codec every phone and WhatsApp handle without complaint. Opus sounds better at low bitrates but belongs in WebM; inside MP4 it will not play on many phones. MP3 suits older players. PCM is uncompressed and very large. Copy preserves the original audio without re-encoding when the container supports it. Drop removes audio completely, which is the right call when you are squeezing a silent clip."/></Button.ToolTip></Button></StackPanel>
<ComboBox x:Name="CmbConvertAudio" SelectedIndex="0" SelectionChanged="OnConvertChanged">
<ComboBoxItem Content="AAC"/>
<ComboBoxItem Content="Opus"/>
<ComboBoxItem Content="MP3"/>
<ComboBoxItem Content="PCM"/>
<ComboBoxItem Content="Copy"/>
<ComboBoxItem Content="Drop"/>
</ComboBox>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Audio Bitrate K" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Audio data rate in kilobits per second. 128 is a compact general setting, 192 provides more detail, and 256 or 320 is useful for music. This value is ignored for Copy, Drop, and uncompressed PCM." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<TextBox x:Name="TxtAudioBitrate" Text="128" TextChanged="OnConvertChanged"/>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="Start (HH:MM:SS)" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Optional trim start time. Leave empty to begin at the start of the source. Use hours:minutes:seconds, for example 00:01:30." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<TextBox x:Name="TxtTrimStart" TextChanged="OnConvertChanged"/>
</StackPanel>
<StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="End (HH:MM:SS)" Style="{StaticResource Label}"/><Button Content="?" Style="{StaticResource InfoButton}"><Button.ToolTip><TextBlock Text="Optional trim end time. Leave empty to continue to the end of the source. The end time must be later than the start time." TextWrapping="Wrap"/></Button.ToolTip></Button></StackPanel>
<TextBox x:Name="TxtTrimEnd" TextChanged="OnConvertChanged"/>
</StackPanel>
</UniformGrid>
</StackPanel>
</Border>
    <StackPanel Grid.Column="2">
<Border Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="FFmpeg Command" Style="{StaticResource H2}"/>
<TextBox x:Name="TxtConvertCommand" Height="150" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"/>
<TextBlock x:Name="TxtConvertValidation" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
</StackPanel>
</Border>
<Border Style="{StaticResource Panel}" Margin="0,16,0,0">
<StackPanel>
<TextBlock Text="Progress" Style="{StaticResource H2}"/>
<ProgressBar x:Name="ConvertProgress" Height="8" Maximum="1" Margin="0,12,0,0"/>
<TextBlock x:Name="TxtConvertStage" Text="Idle" Style="{StaticResource MonoValue}" Margin="0,12,0,0"/>
<TextBlock x:Name="TxtConvertResult" Style="{StaticResource Body}" TextWrapping="Wrap"/>
<Button x:Name="BtnConvertReveal" Content="Show In Folder" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnReveal"/>
</StackPanel>
