<Window x:Class="VidShrink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VidShrink" Height="820" Width="1180" MinHeight="700" MinWidth="1000"
        Background="{StaticResource AppBg}" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
            <TextBlock Text="VIDSHRINK" Style="{StaticResource H2}" FontSize="24" FontWeight="Black"/>
            <TextBlock Text="Hit a target file size with the least quality loss." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- LEFT -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Panel}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                    <StackPanel>
                        <TextBlock Text="SOURCE" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtFileName" Grid.Column="0" Style="{StaticResource Body}"
                                       Text="Drop a video here, or browse." TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="BROWSE" Style="{StaticResource GhostButton}" Click="OnBrowse"/>
                        </Grid>

                        <UniformGrid x:Name="InfoGrid" Columns="4" Rows="2" Margin="0,20,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="DURATION" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtDuration" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="SIZE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtSize" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="RESOLUTION" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtResolution" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="FPS" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtFps" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="VIDEO CODEC" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtVideoCodec" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="AUDIO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtAudio" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="BITRATE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtBitrate" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="HDR" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtHdr" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="TARGET" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderTarget" Grid.Column="0" Minimum="1" Maximum="500" Value="25"
                                    VerticalAlignment="Center" Foreground="{StaticResource NeonBlue}"
                                    ValueChanged="OnTargetSliderChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                <TextBox x:Name="TxtTarget" Width="80" Text="25" TextAlignment="Center"
                                         TextChanged="OnTargetTextChanged"/>
                                <TextBlock Text="MB" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="8" Style="{StaticResource ChipButton}" Click="OnPreset" Tag="8"/>
                            <Button Content="25" Style="{StaticResource ChipButton}" Click="OnPreset" Tag="25"/>
                            <Button Content="50" Style="{StaticResource ChipButton}" Click="OnPreset" Tag="50"/>
                            <Button Content="100" Style="{StaticResource ChipButton}" Click="OnPreset" Tag="100"/>
                            <Button Content="HALF" Style="{StaticResource ChipButton}" Click="OnPresetHalf"/>
                        </StackPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="INTENT" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbIntent" SelectedIndex="1" SelectionChanged="OnOptionChanged">
                                    <ComboBoxItem Content="Archive — keep every detail"/>
                                    <ComboBoxItem Content="Sharing — balanced"/>
                                    <ComboBoxItem Content="Social media — smallest"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CODEC" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbCodec" SelectedIndex="0" SelectionChanged="OnOptionChanged">
                                    <ComboBoxItem Content="Compatible — H.264"/>
                                    <ComboBoxItem Content="Max compression — H.265"/>
                                    <ComboBoxItem Content="Fast — GPU (NVENC)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox x:Name="ChkResolution" Style="{StaticResource CheckStyle}" IsChecked="True"
                                      Content="May lower resolution" Click="OnOptionChanged"/>
                            <CheckBox x:Name="ChkFps" Style="{StaticResource CheckStyle}" IsChecked="True"
                                      Content="May lower frame rate" Click="OnOptionChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="WHAT IT WILL DO" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <TextBlock x:Name="TxtPlanSummary" Style="{StaticResource Body}" TextWrapping="Wrap" Text="-"/>
                        <TextBlock x:Name="TxtPlanReason" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="FFMPEG COMMAND" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <TextBox x:Name="TxtCommand" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                 Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="AI SETTINGS" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Optional. Copy the prompt into any chat AI, paste its JSON answer back. Leave this alone and the built-in engine decides."/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="COPY PROMPT" Style="{StaticResource GhostButton}" Click="OnCopyPrompt" Margin="0,0,8,0"/>
                            <Button Content="APPLY PASTED JSON" Style="{StaticResource GhostButton}" Click="OnApplyJson"/>
                        </StackPanel>
                        <TextBox x:Name="TxtAiJson" Margin="0,12,0,0" Height="150" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                        <TextBlock x:Name="TxtAiStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button x:Name="BtnRevert" Content="BACK TO AUTOMATIC" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed" Click="OnRevertAuto"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Value="0"
                                     Background="#1400F3FF" Foreground="{StaticResource NeonBlue}" BorderThickness="0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STAGE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtStage" Style="{StaticResource MonoValue}" Text="idle"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="REMAINING" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtRemaining" Style="{StaticResource MonoValue}" Text="-"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="CURRENT OUTPUT SIZE" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="TxtOutSize" Style="{StaticResource MonoValue}" FontSize="24" Text="-"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtResult" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <Button x:Name="BtnReveal" Content="SHOW IN FOLDER" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed" Click="OnReveal"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnCancel" Content="CANCEL" Style="{StaticResource GhostButton}"
                            Margin="0,0,12,0" IsEnabled="False" Click="OnCancel"/>
                    <Button x:Name="BtnStart" Content="SHRINK" Style="{StaticResource PrimaryButton}"
                            IsEnabled="False" Click="OnStart"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                        <Hyperlink NavigateUri="https://github.com/Teknesyum" TextDecorations="None"
                                   Foreground="#FF6B7280" RequestNavigate="OnSignatureNavigate">
                            <TextBlock Text="BY TEKNESYUM" FontSize="10" FontWeight="Bold"/>
                        </Hyperlink>
                    </TextBlock>
                    <Border Background="Transparent" BorderBrush="#80B026FF" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <Border.Effect>
                            <DropShadowEffect Color="#B026FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Stroke="#FFB026FF" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M2 4.5 H8.5 V8 A2 2 0 0 1 6.5 10 H4 A2 2 0 0 1 2 8 Z
                                            M8.5 5.5 H9.25 A1.25 1.25 0 0 1 9.25 8 H8.5
                                            M4 1.25 V2.25 M6 1.25 V2.25"/>
                            </Canvas>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://github.com/sponsors/Teknesyum" TextDecorations="None"
                                           Foreground="#FFB026FF" RequestNavigate="OnSignatureNavigate">
                                    <TextBlock Text="BUY ME A COFFEE" FontSize="10" FontWeight="Bold"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TxtStatusBar" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Hint}"
                   Margin="0,16,0,0" Text="ffmpeg: checking..."/>
    </Grid>
</Window>
