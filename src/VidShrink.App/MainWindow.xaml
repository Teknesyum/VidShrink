<Window x:Class="VidShrink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VidShrink" Height="900" Width="1220" MinHeight="720" MinWidth="1040" Background="{StaticResource AppBg}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" WindowStartupLocation="CenterScreen">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="38" ResizeBorderThickness="8" CornerRadius="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Border Background="{StaticResource AppBg}" BorderBrush="{StaticResource NeonBlue}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
 <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<Border Height="38" Background="{StaticResource TitleBarBackground}" BorderBrush="#6600F3FF" BorderThickness="0,0,0,1" CornerRadius="6" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
<Grid Margin="18,0,12,0">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<Image Source="Assets/VidShrink.png" Width="26" Height="26" Stretch="Uniform" Margin="0,0,10,0"/>
<TextBlock Text="VidShrink" Style="{StaticResource H2}" FontSize="18" VerticalAlignment="Center"/>
</StackPanel>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
<TextBlock Margin="0,0,18,0" VerticalAlignment="Center"><Hyperlink NavigateUri="https://github.com/sponsors/Teknesyum" Style="{StaticResource TitleBarLink}" RequestNavigate="OnSignatureNavigate">Buy Me A Coffee</Hyperlink></TextBlock>
<TextBlock Margin="0,0,18,0" VerticalAlignment="Center"><Hyperlink NavigateUri="https://github.com/Teknesyum/vidshrink" Style="{StaticResource TitleBarLink}" RequestNavigate="OnSignatureNavigate">GitHub / By Teknesyum</Hyperlink></TextBlock>
<Button Style="{StaticResource WindowControlButton}" ToolTip="Minimize" Click="OnMinimize"><Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
<Button x:Name="BtnMaximize" Content="□" Style="{StaticResource WindowControlButton}" ToolTip="Maximize" Click="OnMaximizeRestore"/>
<Button Content="×" Style="{StaticResource CloseWindowButton}" ToolTip="Close" Click="OnClose"/>
</StackPanel>
</Grid>
</Border>
<Border Grid.Row="1" Background="{StaticResource SecondaryBarBackground}">
<Grid Margin="24,14,24,14">
<TextBlock Text="Target Size Media Compression &amp; Media Converter" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="BtnTr" Content="TR" Style="{StaticResource ChipButton}" Click="OnTurkish"/><Button x:Name="BtnEn" Content="EN" Style="{StaticResource ChipButton}" Click="OnEnglish"/></StackPanel>
</Grid>
</Border>
  <TabControl Grid.Row="2" Margin="24,0,24,24" Style="{StaticResource NeonTabControl}">
   <TabItem Header="Shrink" Style="{StaticResource NeonTabItem}">
<ScrollViewer VerticalScrollBarVisibility="Auto">
<Grid Margin="0,16,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="20"/>
<ColumnDefinition/>
</Grid.ColumnDefinitions>
    <StackPanel x:Name="ShrinkLeftColumn">
<Border Style="{StaticResource Panel}">
<StackPanel>
<TextBlock Text="Source" Style="{StaticResource H2}"/>
<Grid Margin="0,14,0,0">
<Grid.ColumnDefinitions>
<ColumnDefinition/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<TextBlock x:Name="TxtFileName" Text="Drop any media file here, or browse." Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"/>
<Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}" Click="OnBrowse"/>
