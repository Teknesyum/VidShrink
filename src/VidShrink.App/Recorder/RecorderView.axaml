<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:izi="using:VidShrink.App"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:share="using:VidShrink.App.Share"
             x:Class="VidShrink.App.Recorder.RecorderView"
             auto:AutomationProperties.Name="{loc:Text recorder.pane.title}">

  <!--
    Sayfa başlığı yok: sekmenin adı zaten "Kaydedici". Kartlar üç sütunda; Basit kipte
    hedef, ses ve kamera yan yana, Gelişmiş kipte ilk sütun o üçü alt alta taşır, öteki
    iki sütuna seçenekler ve gelişmiş ayarlar gelir. Kart taban boyu yok: içeriği kadar.
  -->
  <StackPanel Spacing="{StaticResource SpaceMd}">

    <StackPanel x:Name="RowLevel" Orientation="Horizontal" Spacing="{StaticResource SpaceLg}">
      <RadioButton x:Name="RadSimple"
                   GroupName="RecorderLevel"
                   Content="{loc:Text recorder.level.simple}"
                   ToolTip.Tip="{loc:Text recorder.level.simple-hint}"
                   auto:AutomationProperties.Name="{loc:Text recorder.level.simple}"/>
      <RadioButton x:Name="RadAdvanced"
                   GroupName="RecorderLevel"
                   Content="{loc:Text recorder.level.advanced}"
                   ToolTip.Tip="{loc:Text recorder.level.advanced-hint}"
                   auto:AutomationProperties.Name="{loc:Text recorder.level.advanced}"/>
    </StackPanel>

    <!--
      Denetim şeridi. Şeridin okuduğu iki sayı geçen süre ve kare sayısıdır; yazılan
      boyut kayıt sürerken akmıyor (gdigrab yakalamasında total_size son bloğa kadar
      sıfır kalıyor), o yüzden boyut ancak kayıt bitince sonuçtan geliyor. Sebebi
      okumanın ipucunda yazılı.

      Düğmeler duruma göre IsEnabled değil IsVisible ile sürülüyor: devre dışı düğme
      kendi başına bir açıklama borcu doğuruyor, görünmeyen düğme doğurmuyor.
    -->
    <Border x:Name="Strip"
            Theme="{StaticResource Panel}"
            Padding="{StaticResource RecorderStripPadding}"
            auto:AutomationProperties.Name="{loc:Text recorder.strip.title}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="{StaticResource RecorderStripGap}">

        <Ellipse Grid.Column="0"
                 x:Name="LiveDot"
                 Width="{StaticResource RecorderDotSize}"
                 Height="{StaticResource RecorderDotSize}"
                 Fill="{StaticResource NeonEmber}"
                 IsVisible="False"
                 VerticalAlignment="Center"/>

        <TextBlock Grid.Column="1"
                   x:Name="TxtState"
                   Theme="{StaticResource MonoValue}"
                   VerticalAlignment="Center"/>

        <izi:SutunIzgara Grid.Column="2"
              x:Name="StripStats"
              Margin="{StaticResource RecorderStatsInset}"
              MaxColumns="3"
              Fill="False"
              HorizontalAlignment="Left"
              ColumnSpacing="{StaticResource SpaceXl}"
              RowSpacing="{StaticResource SpaceSm}"
              VerticalAlignment="Center"
              ToolTip.Tip="{loc:Text recorder.strip.size-hint}">

          <StackPanel>
            <TextBlock Text="{loc:Text recorder.strip.elapsed}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtElapsed" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="{loc:Text recorder.strip.frames}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtFrames" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="{loc:Text recorder.strip.dropped}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtDropped" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>
        </izi:SutunIzgara>

        <Button Grid.Column="3"
                x:Name="BtnStart"
                Height="{StaticResource RecorderButtonSize}"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource PrimaryButton}"
                Content="{loc:Text recorder.strip.start}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.start}"
                Click="OnStart"/>

        <Button Grid.Column="3"
                x:Name="BtnCountdownCancel"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.countdown.cancel}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.countdown.cancel}"
                Click="OnCountdownCancel"/>

        <Button Grid.Column="4"
                x:Name="BtnAutoWizard"
                Height="{StaticResource RecorderButtonSize}"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.wizard.open}"
                ToolTip.Tip="{loc:Text recorder.wizard.open-hint}"
                auto:AutomationProperties.Name="{loc:Text recorder.wizard.open}"
                Click="OnWizardOpen"/>

        <Button Grid.Column="4"
                x:Name="BtnPause"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.pause}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.pause}"
                Click="OnPause"/>

        <Button Grid.Column="5"
                x:Name="BtnResume"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.resume}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.resume}"
                Click="OnResume"/>

        <Button Grid.Column="6"
                x:Name="BtnSnapshot"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.snapshot}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.snapshot}"
                Click="OnSnapshot"/>

        <Button Grid.Column="7"
                x:Name="BtnStop"
                Height="{StaticResource RecorderButtonSize}"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource PrimaryButton}"
                Content="{loc:Text recorder.strip.stop}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.stop}"
                Click="OnStop"/>

        <!-- Geçiş ayar kutusunda değil şeritte: bulunamayan bir kip hiç kullanılmıyor. -->
        <Button Grid.Column="8"
                x:Name="BtnMini"
                Height="{StaticResource RecorderButtonSize}"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource AccentButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.mini.offer}"
                ToolTip.Tip="{loc:Text recorder.mini.shrink}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Path Width="{StaticResource IconSizeLg}"
                  Height="{StaticResource IconSizeLg}"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Data="{StaticResource IconRestore}"
                  Fill="{StaticResource NeonBlue}"/>
            <TextBlock Text="{loc:Text recorder.mini.offer}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Image x:Name="ImgPreview"
           Width="{StaticResource RecorderPreviewWidth}"
           Stretch="Uniform"
           HorizontalAlignment="Left"
           IsVisible="False"
           auto:AutomationProperties.Name="{loc:Text recorder.strip.preview}"/>

    <!-- Kayıt bittiğinde teslim edilen dosya. Yol her zaman görünür; yarım dosya da
         gizlenmiyor, kendi satırıyla bildiriliyor. -->
    <Border x:Name="ResultPanel" Classes="reveal-panel" Theme="{StaticResource Panel}" IsVisible="False">
      <StackPanel Spacing="{StaticResource SpaceMd}">
        <TextBlock x:Name="TxtResult" Theme="{StaticResource StatusSuccess}" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtResultPath"
                 IsReadOnly="True"
                 FontFamily="{StaticResource FontMono}"
                 auto:AutomationProperties.Name="{loc:Text recorder.output.title}"/>
        <Grid x:Name="WarningRow" Classes="reveal" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="False">
          <Path x:Name="WarningGlyph"
                Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                Stretch="Uniform" VerticalAlignment="Top"
                Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
          <TextBlock x:Name="TxtWarning" Grid.Column="1"
                     Theme="{StaticResource StatusWarning}"
                     TextWrapping="Wrap"/>
        </Grid>
        <WrapPanel>
          <Button x:Name="BtnToShrink"
                  Theme="{StaticResource PrimaryButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.to-shrink}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-shrink}"
                  Click="OnToShrink"/>
          <Button x:Name="BtnReveal"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.reveal}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.reveal}"
                  Click="OnReveal"/>
          <Button x:Name="BtnToPlayer"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.to-player}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-player}"
                  Click="OnToPlayer"/>
          <Button x:Name="BtnToEditor"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsEnabled="{Binding #BtnToPlayer.IsEnabled}"
                  Content="{loc:Text recorder.output.to-editor}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-editor}"
                  Click="OnToEditor"/>
          <Button x:Name="BtnToMp4"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.to-mp4}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-mp4}"
                  Click="OnToMp4"/>
          <Button x:Name="BtnTrimIdle"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.trim-idle}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.trim-idle}"
                  Click="OnTrimIdle"/>
          <Button x:Name="BtnRecShare"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text main.action.share}"
                  auto:AutomationProperties.Name="{loc:Text main.action.share}"
                  Click="OnShare"/>
          <Button x:Name="BtnRecShareCancel"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text main.action.cancel-upload}"
                  auto:AutomationProperties.Name="{loc:Text main.action.cancel-upload}"
                  Click="OnShareCancel"/>
          <Button x:Name="BtnRecShareRetry"
                  auto:AutomationProperties.Name="{loc:Text settings.share.retry}"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"/>
        </WrapPanel>

        <ProgressBar x:Name="RecShareProgress" Maximum="1" IsVisible="False"/>

        <Grid x:Name="RecShareLinkRow"
              IsVisible="False"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="{StaticResource SpaceMd}"
              RowSpacing="{StaticResource SpaceMd}">
          <TextBox Grid.Column="0"
                   x:Name="TxtRecShareLink"
                   IsReadOnly="True"
                   FontFamily="{StaticResource FontMono}"
                   VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  x:Name="BtnRecShareCopy"
                  Theme="{StaticResource GhostButton}"
                  VerticalAlignment="Center"
                  Content="{loc:Text main.action.copy}"
                  auto:AutomationProperties.Name="{loc:Text main.action.copy}"
                  Click="OnCopyShareLink"/>
          <Grid Grid.Row="1"
                Grid.ColumnSpan="2"
                RowDefinitions="Auto,Auto"
                RowSpacing="{StaticResource SpaceSm}"
                IsVisible="{Binding #QrRecShare.IsVisible}">
            <share:ShareQrCode HorizontalAlignment="Left"
                               x:Name="QrRecShare"
                               Link="{Binding #TxtRecShareLink.Text}"
                               ModuleSize="{StaticResource ShareQrModuleSize}"
                               auto:AutomationProperties.Name="{loc:Text main.share.qr}"
                               auto:AutomationProperties.HelpText="{loc:Text main.share.qr-hint}"/>
            <TextBlock Grid.Row="1"
                       Theme="{StaticResource Hint}"
                       Text="{loc:Text main.share.qr-hint}"
                       TextWrapping="Wrap"/>
          </Grid>
        </Grid>

        <TextBlock x:Name="TxtRecShareStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="TxtError" Classes="reveal"
               Theme="{StaticResource StatusError}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <TextBlock x:Name="TxtNotice" Classes="reveal"
               Theme="{StaticResource StatusSuccess}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <TextBlock x:Name="TxtWizardSummary"
               Theme="{StaticResource Hint}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <Border x:Name="PanelWizard"
            Theme="{StaticResource Panel}"
            HorizontalAlignment="Left"
            IsVisible="False"
            auto:AutomationProperties.Name="{loc:Text recorder.wizard.open}">
      <StackPanel Spacing="{StaticResource SpaceMd}">
        <TextBlock x:Name="TxtWizardStep" Theme="{StaticResource Hint}"/>
        <TextBlock x:Name="TxtWizardQuestion" Theme="{StaticResource H2}" TextWrapping="Wrap"/>

        <WrapPanel x:Name="RowWizardOptions"
                   ItemSpacing="{StaticResource SpaceMd}"
                   LineSpacing="{StaticResource SpaceMd}">
          <Button x:Name="BtnWizardOpt0"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="0"
                  Click="OnWizardOption">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt1"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="1"
                  Click="OnWizardOption">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt2"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="2"
                  Click="OnWizardOption">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt3"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="3"
                  Click="OnWizardOption">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
        </WrapPanel>

        <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
          <Button x:Name="BtnWizardSame"
                  Theme="{StaticResource PrimaryButton}"
                  IsVisible="False"
                  Click="OnWizardSame"/>
          <Button x:Name="BtnWizardCancel"
                  Theme="{StaticResource GhostButton}"
                  Content="{loc:Text recorder.wizard.cancel}"
                  auto:AutomationProperties.Name="{loc:Text recorder.wizard.cancel}"
                  Click="OnWizardCancel"/>
        </WrapPanel>
      </StackPanel>
    </Border>


    <izi:KartDuvari x:Name="RecorderCards"
                    MinColumnWidth="{StaticResource FieldWidth}"
                    ColumnSpacing="{StaticResource SpaceMd}"
                    RowSpacing="{StaticResource SpaceMd}">

      <StackPanel x:Name="CardsLeft" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelTarget" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.target.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.what}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbTarget"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.what}"/>
              </StackPanel>

              <StackPanel x:Name="RowScreen" IsVisible="False">
                <TextBlock Text="{loc:Text recorder.target.screen-pick}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbScreen"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.screen-pick}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <StackPanel x:Name="RowWindow" IsVisible="False" Spacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.window-pick}" Theme="{StaticResource Label}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                  <ComboBox x:Name="CmbWindow"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.window-pick}"/>
                  <Button x:Name="BtnWindowRefresh"
                          Grid.Column="1"
                          Theme="{StaticResource GhostButton}"
                          Content="{loc:Text recorder.target.window-refresh}"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.window-refresh}"/>
                </Grid>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.window-title}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtWindowTitle"
                         ToolTip.Tip="{loc:Text recorder.target.window-title-hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.target.window-title}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RowRegionTools" IsVisible="False" Spacing="{StaticResource SpaceMd}">
              <Button x:Name="BtnDrawRegion"
                      Theme="{StaticResource PrimaryButton}"
                      Content="{loc:Text recorder.target.region-draw}"
                      ToolTip.Tip="{loc:Text recorder.target.region-draw-hint}"
                      auto:AutomationProperties.Name="{loc:Text recorder.target.region-draw}"/>
              <izi:SutunIzgara MaxColumns="2" Uniform="True"
                               ColumnSpacing="{StaticResource SpaceMd}"
                               RowSpacing="{StaticResource SpaceMd}">
                <StackPanel>
                  <TextBlock Text="{loc:Text recorder.target.aspect}" Theme="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbAspect"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.aspect}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{loc:Text recorder.target.size}" Theme="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbRegionSize"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.size}"/>
                </StackPanel>
              </izi:SutunIzgara>
            </StackPanel>

            <izi:SutunIzgara x:Name="RowRegion"
                             IsVisible="False"
                             MaxColumns="4"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceSm}"
                             RowSpacing="{StaticResource SpaceSm}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.region-x}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionX" auto:AutomationProperties.Name="{loc:Text recorder.target.region-x}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.region-y}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionY" auto:AutomationProperties.Name="{loc:Text recorder.target.region-y}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.region-width}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionWidth" auto:AutomationProperties.Name="{loc:Text recorder.target.region-width}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.target.region-height}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionHeight" auto:AutomationProperties.Name="{loc:Text recorder.target.region-height}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <TextBlock Text="{loc:Text recorder.target.region-hint}"
                       Theme="{StaticResource Hint}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding #RowRegion.IsVisible}"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.countdown.title}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbCountdown"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="{loc:Text recorder.countdown.hint}"
                          auto:AutomationProperties.Name="{loc:Text recorder.countdown.title}"/>
              </StackPanel>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsMiddle" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelOptions" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.option.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara x:Name="RecorderEncodingChoice" MaxColumns="2"
                             ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceSm}">
              <RadioButton x:Name="RadAuto"
                           GroupName="RecorderEncoding"
                           Content="{loc:Text recorder.auto.automatic}"
                           ToolTip.Tip="{loc:Text recorder.auto.automatic-hint}"
                           auto:AutomationProperties.Name="{loc:Text recorder.auto.automatic}"/>
              <RadioButton x:Name="RadManual"
                           GroupName="RecorderEncoding"
                           Content="{loc:Text recorder.auto.manual}"
                           ToolTip.Tip="{loc:Text recorder.auto.manual-hint}"
                           auto:AutomationProperties.Name="{loc:Text recorder.auto.manual}"/>
            </izi:SutunIzgara>

            <StackPanel x:Name="PanelAutoResult" Spacing="{StaticResource SpaceSm}">
              <TextBlock x:Name="TxtAutoSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
              <Button x:Name="BtnAutoMeasure"
                      HorizontalAlignment="Left"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.auto.measure}"
                      auto:AutomationProperties.Name="{loc:Text recorder.auto.measure}"
                      Click="OnAutoMeasure"/>
            </StackPanel>

            <izi:SutunIzgara x:Name="PanelManualOptions"
                             MaxColumns="2"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.option.fps}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtFps" auto:AutomationProperties.Name="{loc:Text recorder.option.fps}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.option.quality}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtQuality"
                         ToolTip.Tip="{loc:Text recorder.option.quality-hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.option.quality}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.option.codec}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbCodec"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.codec}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.option.preset}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbPreset"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.preset}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.budget.seconds}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtTargetSeconds"
                         PlaceholderText="{loc:Text recorder.budget.optional}"
                         ToolTip.Tip="{loc:Text recorder.budget.hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.budget.seconds}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.budget.megabytes}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtTargetMegabytes"
                         PlaceholderText="{loc:Text recorder.budget.optional}"
                         ToolTip.Tip="{loc:Text recorder.budget.hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.budget.megabytes}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <TextBlock x:Name="TxtBudgetNote" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceSm}">
              <CheckBox x:Name="ChkCursor"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.cursor}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.cursor}"/>
              <CheckBox x:Name="ChkShowClicks"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.show-clicks}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.show-clicks}"/>
              <CheckBox x:Name="ChkClickSound"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.click-sound}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.click-sound}"/>
              <CheckBox x:Name="ChkShowKeys"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.show-keys}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.show-keys}"/>
              <CheckBox x:Name="ChkMagnifier"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.magnifier}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.magnifier}"/>
              <CheckBox x:Name="ChkLivePreview"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.live-preview}"
                        ToolTip.Tip="{loc:Text recorder.option.live-preview-hint}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.live-preview}"/>
            </izi:SutunIzgara>

            <StackPanel>
              <TextBlock Text="{loc:Text recorder.output.title}" Theme="{StaticResource Label}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <TextBox Grid.Column="0"
                         x:Name="TxtOutputFolder"
                         ToolTip.Tip="{Binding $self.Text}"
                         auto:AutomationProperties.Name="{loc:Text recorder.output.title}"/>
                <Button Grid.Column="1"
                        x:Name="BtnBrowse"
                        Theme="{StaticResource GhostButton}"
                        Content="{loc:Text recorder.output.browse}"
                        auto:AutomationProperties.Name="{loc:Text recorder.output.browse}"
                        Click="OnBrowse"/>
              </Grid>
            </StackPanel>

            <CheckBox x:Name="ChkOpenFolder"
                      Theme="{StaticResource CheckStyle}"
                      Content="{loc:Text recorder.output.open-when-done}"
                      auto:AutomationProperties.Name="{loc:Text recorder.output.open-when-done}"/>
          </StackPanel>
        </Border>

        <!-- Ses girdisi. Liste ffmpeg'in kendisinden geliyor; cihazsız makinede kutular
             yalnız "sessiz" öğesiyle açılıyor ve kayıt sessiz sürüyor. -->
        <Border x:Name="PanelAudio" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.audio.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.audio.microphone}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbMicrophone"
                          ToolTip.Tip="{loc:Text recorder.audio.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.audio.microphone}"/>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="{loc:Text recorder.audio.system}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbSystemAudio"
                          ToolTip.Tip="{loc:Text recorder.audio.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.audio.system}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <Button x:Name="BtnAudioRefresh"
                    HorizontalAlignment="Left"
                    Theme="{StaticResource GhostButton}"
                    Content="{loc:Text recorder.audio.refresh}"
                    auto:AutomationProperties.Name="{loc:Text recorder.audio.refresh}"
                    Click="OnAudioRefresh"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsRight" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelAdvanced" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <StackPanel Spacing="{StaticResource SpaceXs}">
              <TextBlock Text="{loc:Text recorder.advanced.title}" Theme="{StaticResource H2}"/>
              <TextBlock Text="{loc:Text recorder.advanced.optional}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>

            <izi:SutunIzgara MaxColumns="3" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.container}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbContainer" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.container}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.max-duration}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtMaxDuration" auto:AutomationProperties.Name="{loc:Text recorder.advanced.max-duration}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.split-seconds}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtSplitSeconds" auto:AutomationProperties.Name="{loc:Text recorder.advanced.split-seconds}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.split-megabytes}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtSplitMegabytes" auto:AutomationProperties.Name="{loc:Text recorder.advanced.split-megabytes}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.audio-layout}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbAudioLayout" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.audio-layout}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.audio-gain}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtAudioGain" auto:AutomationProperties.Name="{loc:Text recorder.advanced.audio-gain}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceSm}">
              <CheckBox x:Name="ChkNoiseGate"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.noise-gate}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.noise-gate}"/>
              <CheckBox x:Name="ChkNoiseSuppression"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.noise-suppression}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.noise-suppression}"/>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>

        <Border x:Name="PanelReplay" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.replay.label}" Theme="{StaticResource H2}"/>

            <StackPanel>
              <TextBlock Text="{loc:Text recorder.replay.seconds}" Theme="{StaticResource Label}" TextWrapping="Wrap"/>
              <ComboBox x:Name="CmbReplaySeconds"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="{loc:Text recorder.replay.hint}"
                        auto:AutomationProperties.Name="{loc:Text recorder.replay.seconds}"/>
            </StackPanel>

            <WrapPanel>
              <Button x:Name="BtnReplay"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Margin="{StaticResource WrapItemMargin}"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.replay.start}"
                      ToolTip.Tip="{loc:Text recorder.replay.hint}"
                      auto:AutomationProperties.Name="{loc:Text recorder.replay.start}"
                      Click="OnReplayToggle"/>

              <Button x:Name="BtnReplaySave"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Margin="{StaticResource WrapItemMargin}"
                      Theme="{StaticResource GhostButton}"
                      IsVisible="False"
                      auto:AutomationProperties.Name="{loc:Text recorder.replay.save}"
                      Click="OnReplaySave"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsExtra" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelWebcam" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.webcam.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.webcam.device}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcam"
                          ToolTip.Tip="{loc:Text recorder.webcam.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.device}"/>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="{loc:Text recorder.webcam.size}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcamSize"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.size}"/>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="{loc:Text recorder.webcam.corner}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcamCorner"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.corner}"/>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="{loc:Text recorder.webcam.background.label}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcamBackground"
                          ToolTip.Tip="{loc:Text recorder.webcam.background.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.background.label}"/>
              </StackPanel>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>

        <Border x:Name="PanelEncoding" Theme="{StaticResource Panel}" IsVisible="{Binding #PanelAdvancedEncoding.IsVisible}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <TextBlock Text="{loc:Text recorder.advanced.encoder-title}" Theme="{StaticResource H2}"/>
            <izi:SutunIzgara x:Name="PanelAdvancedEncoding"
                             MaxColumns="3"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.scale-width}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtScaleWidth" ToolTip.Tip="{loc:Text recorder.advanced.scale-hint}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.scale-width}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.scale-height}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtScaleHeight" ToolTip.Tip="{loc:Text recorder.advanced.scale-hint}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.scale-height}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.keyframe}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtKeyframe" auto:AutomationProperties.Name="{loc:Text recorder.advanced.keyframe}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.pixel-format}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbPixelFormat" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.pixel-format}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.profile}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbProfile" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.profile}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.tune}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbTune" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.tune}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.color-space}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbColorSpace" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.color-space}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.color-range}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbColorRange" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.color-range}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.rate}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbRateControl" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.rate}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.bitrate}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtBitrate" auto:AutomationProperties.Name="{loc:Text recorder.advanced.bitrate}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.max-bitrate}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtMaxBitrate" auto:AutomationProperties.Name="{loc:Text recorder.advanced.max-bitrate}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{loc:Text recorder.advanced.buffer}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtBuffer" auto:AutomationProperties.Name="{loc:Text recorder.advanced.buffer}"/>
              </StackPanel>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>
      </StackPanel>
    </izi:KartDuvari>
  </StackPanel>
</UserControl>
