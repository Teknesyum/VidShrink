<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VidShrink.App.Recorder.RecorderRegionPicker"
        Title="VidShrink" FontSize="{StaticResource FontSizeMd}" FontFamily="{StaticResource FontSans}"
        WindowDecorations="None"
        CanResize="False" CanMaximize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Canvas x:Name="Surface" Background="Transparent">
    <Border x:Name="Scrim"
            Background="{StaticResource PlaybackScrim}"
            Opacity="{StaticResource RecorderPickerScrimOpacity}"
            IsHitTestVisible="False"/>
    <Border x:Name="Selection"
            BorderBrush="{StaticResource NeonEmber}"
            BorderThickness="{StaticResource RecorderFrameBorder}"
            IsVisible="False"
            IsHitTestVisible="False"/>
    <Border x:Name="SnapX" Classes="snap" IsVisible="False" IsHitTestVisible="False"/>
    <Border x:Name="SnapY" Classes="snap" IsVisible="False" IsHitTestVisible="False"/>
    <Border x:Name="SizeTag"
            Theme="{StaticResource Panel}"
            Padding="{StaticResource RecorderStripPadding}"
            IsVisible="False"
            IsHitTestVisible="False">
      <TextBlock x:Name="TxtSize" Theme="{StaticResource MonoValue}"/>
    </Border>
  </Canvas>
  <Window.Styles>
    <Style Selector="Border.snap">
      <Setter Property="Background" Value="{DynamicResource NeonBlue}"/>
    </Style>
  </Window.Styles>
</Window>
