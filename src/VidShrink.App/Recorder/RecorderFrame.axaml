<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VidShrink.App.Recorder.RecorderFrame"
        Title="VidShrink"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Border x:Name="FrameEdge"
          BorderBrush="{StaticResource NeonEmber}"
          BorderThickness="{StaticResource RecorderFrameBorder}"
          Background="Transparent"
          IsHitTestVisible="False"/>
</Window>
