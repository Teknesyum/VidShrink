<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VidShrink.App.Recorder.RecorderClickRing"
        Title="VidShrink"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="{StaticResource RecorderClickRingSize}"
        Height="{StaticResource RecorderClickRingSize}">
  <Ellipse x:Name="Ring"
           Stroke="{StaticResource NeonEmber}"
           StrokeThickness="{StaticResource RecorderClickRingThickness}"
           IsHitTestVisible="False"/>
</Window>
