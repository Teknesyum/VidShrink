<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        x:Class="VidShrink.App.Recorder.RecorderRegionEditor"
        Title="VidShrink"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        auto:AutomationProperties.Name="{loc:Text recorder.region.title}">
  <Canvas x:Name="Surface" Background="Transparent">
    <Border x:Name="Edge"
            BorderBrush="{StaticResource NeonEmber}"
            BorderThickness="{StaticResource RecorderFrameBorder}"
            IsHitTestVisible="False"/>
    <Border x:Name="HandleTopLeft" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleTop" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleTopRight" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleRight" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleBottomRight" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleBottom" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleBottomLeft" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="HandleLeft" Classes="grip" IsHitTestVisible="False"/>
    <Border x:Name="Toolbar"
            Theme="{StaticResource Panel}"
            Padding="{StaticResource RecorderRegionToolbarPadding}">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnStart"
                Classes="tool"
                Theme="{StaticResource PrimaryButton}"
                ToolTip.Tip="{loc:Text recorder.region.start}"
                auto:AutomationProperties.Name="{loc:Text recorder.region.start}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconRecorder}"
                Fill="{StaticResource OnNeon}"/>
        </Button>
        <Button x:Name="BtnSettings"
                Classes="tool"
                Theme="{StaticResource GhostButton}"
                ToolTip.Tip="{loc:Text recorder.region.settings}"
                auto:AutomationProperties.Name="{loc:Text recorder.region.settings}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconSettings}"
                Fill="{StaticResource TextBody}"/>
        </Button>
        <Button x:Name="BtnPause"
                Classes="tool"
                Theme="{StaticResource GhostButton}"
                IsVisible="False"
                ToolTip.Tip="{loc:Text recorder.strip.pause}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.pause}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconPause}"
                Fill="{StaticResource TextBody}"/>
        </Button>
        <Button x:Name="BtnResume"
                Classes="tool"
                Theme="{StaticResource GhostButton}"
                IsVisible="False"
                ToolTip.Tip="{loc:Text recorder.strip.resume}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.resume}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconPlay}"
                Fill="{StaticResource TextBody}"/>
        </Button>
        <Button x:Name="BtnStop"
                Classes="tool"
                Theme="{StaticResource PrimaryButton}"
                IsVisible="False"
                ToolTip.Tip="{loc:Text recorder.strip.stop}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.stop}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconStop}"
                Fill="{StaticResource OnNeon}"/>
        </Button>
        <Button x:Name="BtnClose"
                Classes="tool"
                Theme="{StaticResource GhostButton}"
                ToolTip.Tip="{loc:Text recorder.region.close}"
                auto:AutomationProperties.Name="{loc:Text recorder.region.close}">
          <Path Width="{StaticResource IconSizeSm}"
                Height="{StaticResource IconSizeSm}"
                Stretch="Uniform"
                Data="{StaticResource IconClose}"
                Fill="{StaticResource TextBody}"/>
        </Button>
      </StackPanel>
    </Border>
  </Canvas>
  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="{StaticResource RecorderRegionButtonSize}"/>
      <Setter Property="Height" Value="{StaticResource RecorderRegionButtonSize}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.grip">
      <Setter Property="Width" Value="{StaticResource RecorderRegionHandle}"/>
      <Setter Property="Height" Value="{StaticResource RecorderRegionHandle}"/>
      <Setter Property="Background" Value="{StaticResource NeonEmber}"/>
    </Style>
  </Window.Styles>
</Window>
