<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VidShrink.App.Recorder.RecorderKeyCaption"
        Title="VidShrink"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SizeToContent="WidthAndHeight">
  <Border Theme="{StaticResource Panel}"
          Padding="{StaticResource RecorderStripPadding}"
          IsHitTestVisible="False">
    <TextBlock x:Name="TxtKeys" Theme="{StaticResource MonoValue}"/>
  </Border>
</Window>
