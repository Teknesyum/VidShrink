<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        xmlns:core="using:VidShrink.Core"
        x:Class="VidShrink.App.Recorder.RecorderResultCard"
        Title="{x:Static core:AppIdentity.Name}" FontSize="{StaticResource FontSizeMd}" FontFamily="{StaticResource FontSans}"
        WindowDecorations="None"
        CanResize="False" CanMaximize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SizeToContent="WidthAndHeight">
  <Border x:Name="Card"
          Theme="{StaticResource Panel}"
          Padding="{StaticResource RecorderStripPadding}"
          Cursor="Hand"
          ToolTip.Tip="{loc:Text recorder.card.drag-hint}"
          auto:AutomationProperties.Name="{loc:Text recorder.card.drag-hint}">
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource RecorderStripGap}">
      <Image x:Name="ImgThumb"
             Width="{StaticResource RecorderResultCardThumbWidth}"
             Height="{StaticResource RecorderResultCardThumbHeight}"
             Stretch="Uniform"/>
      <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
        <SarilanMetin x:Name="TxtName"
                   Theme="{StaticResource Body}"
                   MaxWidth="{StaticResource FieldWidthSm}"
                   TextTrimming="CharacterEllipsis"/>
        <SarilanMetin Text="{loc:Text recorder.card.drag-hint}"
                   Theme="{StaticResource Hint}"
                   MaxWidth="{StaticResource FieldWidthSm}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
          <Button x:Name="BtnNeverAgain"
                  Theme="{StaticResource LinkButton}"
                  Content="{loc:Text recorder.card.never}"
                  auto:AutomationProperties.Name="{loc:Text recorder.card.never}"/>
          <Button x:Name="BtnCloseCard"
                  Theme="{StaticResource LinkButton}"
                  Content="{loc:Text recorder.card.close}"
                  auto:AutomationProperties.Name="{loc:Text recorder.card.close}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
