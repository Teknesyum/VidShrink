<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:playback="using:VidShrink.App.Playback"
             x:Class="VidShrink.App.Playback.ComparisonPanel">

  <!--
    Kök ızgara iki şey taşır: terfi sırasında bandında kalan yer tutucu ve panelin
    kendisi. Terfi edince Shell bu ızgaradan çıkıp kök katmana taşınır, yer tutucu
    aynı boyutta görünür kalır — altındaki düzen zıplamaz (K4).
  -->
  <Grid x:Name="Root">

    <Border x:Name="Placeholder"
            Theme="{StaticResource PlaybackPlaceholder}"
            IsVisible="False">
      <TextBlock x:Name="PlaceholderText"
                 Theme="{StaticResource Hint}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
    </Border>

    <Border x:Name="Shell"
            Theme="{StaticResource Panel}"
            Padding="0"
            ClipToBounds="True"
            Focusable="True"
            MinHeight="{StaticResource PlaybackStageMinHeight}">

      <Grid x:Name="Stage"
            Background="{StaticResource AppBg}"
            ClipToBounds="True">

        <playback:ComparisonSurface x:Name="Surface"/>

        <!--
          K2 dürüstlük perdesi: işlenmiş dosya yokken sağ taraf gerçek bir çıktı değildir,
          bu yüzden görüntü hiç gösterilmez — perde ayırıcıdan sağa uzanır ve sebebini
          söyler. Genişlik kod tarafında ayırıcının konumundan gelir; Margin kullanılmaz,
          Margin ölçüme girip panoyu şişirir.
        -->
        <Border x:Name="RightCurtain"
                Background="{StaticResource AppBg}"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                IsVisible="False">
          <TextBlock x:Name="RightCurtainText"
                     Theme="{StaticResource Hint}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="{StaticResource PlaybackBadgeMargin}"/>
        </Border>

        <!-- K1: hiç kare yokken boş durum. İki dilde, dil geçidi kod tarafında. -->
        <StackPanel x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock x:Name="EmptyTitle"
                     Theme="{StaticResource Label}"
                     HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHint"
                     Theme="{StaticResource Hint}"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Solda orijinal, sağda işlenmiş. Etiket yonganın içinde, çerçevesi neon. -->
        <Border x:Name="LeftBadge"
                Theme="{StaticResource PlaybackBadge}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="{StaticResource PlaybackBadgeMargin}">
          <TextBlock x:Name="LeftBadgeText" Theme="{StaticResource PlaybackBadgeText}"/>
        </Border>

        <!--
          T49: sağ yarının iki işareti alt alta. Üstteki taraf etiketi, altındaki
          yaklaşıklık rozeti — ikisi de sağ üstte, yani işaret ettikleri şey sağ yarı.
          Rozet ikinci bir tasarım değil, yan etiketle aynı yonga.
        -->
        <StackPanel x:Name="RightBadges"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="{StaticResource PlaybackBadgeGap}"
                    Margin="{StaticResource PlaybackBadgeMargin}">

          <Border x:Name="RightBadge"
                  Theme="{StaticResource PlaybackBadge}"
                  HorizontalAlignment="Right">
            <TextBlock x:Name="RightBadgeText" Theme="{StaticResource PlaybackBadgeText}"/>
          </Border>

          <!--
            T49/K3: rozet tıklanabilir değil. Fare olaylarına saydam olmazsa panelin
            kendiliğinden inişi kullanıcı rozetin üstünden geçerken dururdu.
            T49/K4: sığmayan metin üç noktayla kırpılır; genişlik tavanı sağ yarının
            kendi ölçüsünden geliyor ve kod tarafında yazılıyor.
          -->
          <Border x:Name="ApproxBadge"
                  Theme="{StaticResource PlaybackBadge}"
                  HorizontalAlignment="Right"
                  IsHitTestVisible="False"
                  IsVisible="False">
            <TextBlock x:Name="ApproxBadgeText"
                       Theme="{StaticResource PlaybackBadgeText}"
                       IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
        </StackPanel>

<!--
          T40: yakınlaştırma okuması ile denetim şeridi alt kenarı paylaşıyor. Yığın
          ikisini üst üste değil alt alta koyar — şerit belirdiğinde okuma kaybolmaz.
        -->
        <StackPanel VerticalAlignment="Bottom">
          <!--
            T46/K3: yakınlaştırma okumasının yanında iki tıklama düğmesi. İkisi de
            tekerleğin sürdüğü tek jest parametresini bir çentik oynatır; ayrı bir
            yakınlaştırma durumu yoktur.
          -->
          <StackPanel x:Name="ZoomRow"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Spacing="{StaticResource PlaybackZoomButtonGap}"
                      Margin="{StaticResource PlaybackBadgeMargin}">
            <Button x:Name="BtnZoomOut" Content="-" Theme="{StaticResource PlaybackZoomButton}"/>
            <Button x:Name="BtnZoomIn" Content="+" Theme="{StaticResource PlaybackZoomButton}"/>
            <Border x:Name="ZoomBadge" Theme="{StaticResource PlaybackBadge}" VerticalAlignment="Center">
              <TextBlock x:Name="ZoomText" Theme="{StaticResource PlaybackBadgeText}"/>
            </Border>
          </StackPanel>

          <!-- Denetim şeridi. Yüzeyin üstünde, panelin alt kenarında durur. -->
          <playback:ControlStrip x:Name="Strip"/>
        </StackPanel>

        <!--
          T73: bekleme göstergesi. Fare panele girince belirir, halkası PlaybackPanelRiseDelay
          boyunca kapanır, süre dolunca kaybolur ve panel büyür. Üstte ve ortada: yonganın
          hizasında ama ayırıcı tutamacının üstünde değil. İsabet testine kapalı — göstergenin
          kendisi farenin panelde durmasını bozarsa saydığı şeyi bozmuş olurdu.
        -->
        <Border x:Name="RiseCountdown"
                Theme="{StaticResource PlaybackCountdown}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="{StaticResource PlaybackBadgeMargin}"
                IsVisible="False">
          <playback:CountdownRing x:Name="RiseRing"
                                  Thickness="{StaticResource PlaybackCountdownStroke}"
                                  Track="{StaticResource NeonBlueBorder}"
                                  Stroke="{StaticResource NeonBlue}"/>
        </Border>

        <!--
          K2: ayırıcı. Tutma şeridi çizgiden geniştir ki fare ile yakalamak kolay olsun;
          görünen çizgi tutamacın ortasındadır. Şerit odaklanabilir — sol/sağ ok küçük
          adım, Home/End uçlar.
        -->
        <Border x:Name="SeparatorGrip"
                Width="{StaticResource PlaybackHandleWidth}"
                Background="Transparent"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Focusable="True"
                Cursor="SizeWestEast">
          <Grid>
            <Border x:Name="SeparatorLine"
                    Theme="{StaticResource PlaybackSeparator}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"/>
            <Border x:Name="SeparatorHandle"
                    Theme="{StaticResource PlaybackHandle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
