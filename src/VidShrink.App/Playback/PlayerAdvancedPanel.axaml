<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             x:Class="VidShrink.App.Playback.PlayerAdvancedPanel">
  <Border x:Name="Root" Theme="{StaticResource Panel}" Classes="enter">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{StaticResource MotionBase}" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionBase}" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <StackPanel Spacing="{StaticResource SpaceMd}">
      <Button x:Name="BtnToggle"
              Click="OnToggle"
              Theme="{StaticResource PanelHeaderToggle}"
              auto:AutomationProperties.Name="{loc:Text player.advanced.title}">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
          <Path x:Name="Glyph" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{loc:Text player.advanced.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" x:Name="TxtSummary" Theme="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
        </Grid>
      </Button>
      <StackPanel x:Name="Body" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}">
        <TextBlock Text="{loc:Text player.advanced.hint}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
        <Grid x:Name="Rows"
              ColumnDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="{StaticResource SpaceMd}"
              RowSpacing="{StaticResource SpaceXs}"/>
        <StackPanel x:Name="Switches" Spacing="{StaticResource SpaceXs}"/>
        <Button x:Name="BtnReset"
                Content="{loc:Text player.advanced.reset}"
                Theme="{StaticResource GhostButton}"
                HorizontalAlignment="Left"
                Click="OnReset"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
