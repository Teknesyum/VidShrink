<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        x:Class="VidShrink.App.Playback.HistoryWindow"
        Title="{loc:Text player.history.title}"
        FontSize="{StaticResource FontSizeMd}" FontFamily="{StaticResource FontSans}"
        Width="{StaticResource HistoryWindowWidth}" Height="{StaticResource HistoryWindowHeight}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBg}"
        auto:AutomationProperties.Name="{loc:Text player.history.title}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{StaticResource SpaceSm}" Margin="{StaticResource WorkspaceMargin}">
    <TextBlock Text="{loc:Text player.history.search}" Theme="{StaticResource Hint}"/>
    <TextBox Grid.Row="1" x:Name="SearchBox" auto:AutomationProperties.Name="{loc:Text player.history.search}"/>
    <ListBox Grid.Row="2" x:Name="Rows" SelectionMode="Single" auto:AutomationProperties.Name="{loc:Text player.history.title}"/>
    <TextBlock Grid.Row="2" x:Name="TxtEmpty" Text="{loc:Text player.history.empty}" Theme="{StaticResource Hint}"
               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
    <Button Grid.Row="3" x:Name="BtnOpen" Content="{loc:Text player.history.open}" Theme="{StaticResource PrimaryButton}"
            HorizontalAlignment="Right" Click="OnOpen"/>
  </Grid>
</Window>
