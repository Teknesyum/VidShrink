<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:playback="using:VidShrink.App.Playback"
             x:Class="VidShrink.App.Playback.PlayerView"
             Focusable="True">

  <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource SectionMargin}" RowSpacing="{StaticResource SpaceMd}">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
      <TextBlock Grid.Column="0"
                 Text="{loc:Text main.player.title}"
                 Theme="{StaticResource H2}"
                 VerticalAlignment="Center"/>
      <playback:TrackButtons Grid.Column="1" x:Name="TrackBar" VerticalAlignment="Center"/>
      <Button Grid.Column="2"
              x:Name="BtnPlayerMenu"
              Content="⋮"
              Theme="{StaticResource GhostButton}"
              FontFamily="{StaticResource FontMono}"
              VerticalAlignment="Center"
              auto:AutomationProperties.Name="{loc:Text main.player.menu}"
              Click="OnMenuButton"/>
    </Grid>

    <Border Grid.Row="1" x:Name="Stage" Theme="{StaticResource Panel}" Background="{StaticResource AppBg}">
      <Panel x:Name="Surface" Background="Transparent" ClipToBounds="True">
        <Image x:Name="Frame" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtEmpty"
                   Text="{loc:Text main.player.empty}"
                   Theme="{StaticResource MonoValue}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <Border x:Name="InfoPanel"
                Theme="{StaticResource PlaybackBadge}"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsVisible="False">
          <TextBlock x:Name="TxtInfo" Theme="{StaticResource PlaybackTimeText}"/>
        </Border>
        <Canvas x:Name="ThumbLayer" IsHitTestVisible="False">
          <Border x:Name="ThumbChip" Theme="{StaticResource PlaybackBadge}" IsVisible="False">
            <StackPanel Spacing="{StaticResource PlaybackBadgeGap}">
              <Image x:Name="ThumbImage"
                     Width="{StaticResource PlaybackThumbnailWidth}"
                     Height="{StaticResource PlaybackThumbnailHeight}"
                     Stretch="Fill"/>
              <TextBlock x:Name="ThumbTime"
                         Theme="{StaticResource PlaybackTimeText}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Canvas>
      </Panel>
    </Border>

    <StackPanel Grid.Row="2" Spacing="{StaticResource SpaceSm}">
      <Panel x:Name="SeekBar"
             Height="{StaticResource PlaybackTimelineHeight}"
             Background="Transparent"
             Cursor="Hand"
             auto:AutomationProperties.Name="{loc:Text playback.control.timeline}">
        <Border x:Name="SeekTrack" Theme="{StaticResource PlaybackTrack}" VerticalAlignment="Center"/>
        <Border x:Name="SeekFill"
                Theme="{StaticResource PlaybackTrackFill}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="0"
                IsVisible="False"/>
        <Canvas x:Name="SeekMarkLayer" IsHitTestVisible="False"/>
      </Panel>
      <TextBlock x:Name="TxtView" Theme="{StaticResource MonoValue}" TextWrapping="Wrap" IsVisible="False"/>
      <TextBlock x:Name="TxtState" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
      <TextBlock x:Name="TxtControls" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
      <TextBlock x:Name="TxtStall"
                 Theme="{StaticResource MonoValue}"
                 TextWrapping="Wrap"
                 IsVisible="False"
                 Foreground="{StaticResource NeonEmber}"/>
    </StackPanel>
  </Grid>
</UserControl>
