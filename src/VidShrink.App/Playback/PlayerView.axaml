<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:playback="using:VidShrink.App.Playback"
             x:Class="VidShrink.App.Playback.PlayerView"
             Focusable="True"
             Loaded="OnSeritLoaded">

  <!--
    Kesit B: sayfanin tek satiri kaldi. Baslik, ses/altyazi parcasi dugmeleri ve uc nokta
    kalkti; ucunun de karsiligi sag klik menusunde duruyor. Zaman cubugu, denetim seridi ve
    tanilama satirlari yerlesimde yer kaplamiyor — hepsi panonun ustune binen katmanlar.
  -->
  <Grid>

    <Border x:Name="Stage"
            Theme="{StaticResource Panel}"
            Background="{StaticResource AppBg}"
            BorderThickness="0"
            CornerRadius="0"
            Padding="0">
      <Panel x:Name="Surface" Background="Transparent" ClipToBounds="True">
        <Image x:Name="Frame" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border x:Name="PauseGlyph"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransform="scale(0.8)">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
              <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}"/>
            </Transitions>
          </Border.Transitions>
          <Path Width="{StaticResource PauseGlyphSize}"
                Height="{StaticResource PauseGlyphSize}"
                Stretch="Uniform"
                Data="{StaticResource IconPause}"
                Fill="{StaticResource TextBody}"/>
        </Border>
        <TextBlock x:Name="TxtEmpty"
                   Text="{loc:Text main.player.empty}"
                   Theme="{StaticResource MonoValue}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtEngine"
                   Theme="{StaticResource StatusError}"
                   IsVisible="False"
                   Margin="{StaticResource PlaybackBadgeMargin}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

        <!--
          Bilgi rozeti ve tanilama satirlari. Dort duz metin satiri sayfadan kalkti ama
          agactan kalkmadi: okuyuculari duruyor, artik yalnizca bilgi panosu acikken
          gorunuyorlar. Gorunurluk kodla degil rozetin kendi bayragina baglanarak
          suruluyor, boylece durumu tek yerden geliyor.
        -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="{StaticResource PlaybackBadgeMargin}"
                    Spacing="{StaticResource PlaybackBadgeGap}">
          <Border x:Name="InfoPanel" Theme="{StaticResource PlaybackBadge}" IsVisible="False">
            <TextBlock x:Name="TxtInfo" Theme="{StaticResource PlaybackTimeText}"/>
          </Border>
          <Border x:Name="DiagPanel"
                  Theme="{StaticResource PlaybackBadge}"
                  IsVisible="{Binding #InfoPanel.IsVisible}">
            <StackPanel Spacing="{StaticResource SpaceXs}">
              <TextBlock x:Name="TxtView" Theme="{StaticResource MonoValue}" TextWrapping="Wrap" IsVisible="False"/>
              <TextBlock x:Name="TxtState" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
              <TextBlock x:Name="TxtControls" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Takilma ve hata bildirimi tanilamaya bagli degil: kendi bayragiyla gorunur. -->
        <Border Theme="{StaticResource PlaybackBadge}"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="{Binding #TxtStall.IsVisible}">
          <TextBlock x:Name="TxtStall"
                     Theme="{StaticResource MonoValue}"
                     TextWrapping="Wrap"
                     IsVisible="False"
                     Foreground="{StaticResource EmberBlaze}"/>
        </Border>

        <Canvas x:Name="ThumbLayer" IsHitTestVisible="False">
          <Border x:Name="ThumbChip" Theme="{StaticResource PlaybackBadge}" IsVisible="False">
            <StackPanel Spacing="{StaticResource PlaybackBadgeGap}">
              <Image x:Name="ThumbImage"
                     Width="{StaticResource PlaybackThumbnailWidth}"
                     Height="{StaticResource PlaybackThumbnailHeight}"
                     Stretch="Fill"/>
              <TextBlock x:Name="ThumbTime"
                         Theme="{StaticResource PlaybackTimeText}"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Canvas>

        <!--
          7b/K1: otomatik gizlenen alt serit. Gizliyken IsVisible degil Opacity sifirdir —
          klavye odagi icine dusunce belirmesi gerekiyor ve yerlesim olculeri (zaman
          cubugunun genisligi) gizliyken de dogru kalmali. Fareye gorunmez olmasi
          IsHitTestVisible ile kod tarafinda suruluyor.
        -->
        <Border x:Name="StripBar"
                FlowDirection="LeftToRight"
                Theme="{StaticResource PlaybackStrip}"
                VerticalAlignment="Bottom"
                Opacity="0"
                IsHitTestVisible="False"
                auto:AutomationProperties.Name="{loc:Text playback.control.strip}">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">

            <Panel Grid.Row="0"
                   x:Name="SeekBar"
                   Height="{StaticResource PlaybackSeekBarHeight}"
                   Background="Transparent"
                   Cursor="Hand"
                   auto:AutomationProperties.Name="{loc:Text playback.control.timeline}">
              <Border x:Name="SeekTrack" Theme="{StaticResource PlaybackSeekTrack}" VerticalAlignment="Center"/>
              <Border x:Name="SeekFill"
                      Theme="{StaticResource PlaybackSeekTrackFill}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Width="0"
                      IsVisible="False"/>
              <Canvas x:Name="SeekMarkLayer" IsHitTestVisible="False"/>
            </Panel>

            <!--
              Kesit B: uc oberk. Solda sure okumasi ve ses, ortada -10 / oynat / +10,
              sagda hiz. Oynat dugmesi ortadaki obegin ortasinda durdugu icin izgara
              simetrik: iki yan sutun da yildiz, ortadaki Auto.
            -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpaceMd}">

              <Grid Grid.Column="0"
                    ColumnSpacing="{StaticResource SpaceSm}"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" MaxWidth="{StaticResource PlaybackSliderWidth}"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSeritTime"
                           Theme="{StaticResource PlaybackTimeText}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnSeritMute" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.mute}">
                  <Path x:Name="GlyphSeritVolume"
                        Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        Data="{StaticResource IconVolume}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Slider Grid.Column="2" x:Name="SliderSeritVolume"
                        Theme="{StaticResource PlaybackSlider}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="{StaticResource PlaybackVolumeTick}"
                        IsSnapToTickEnabled="True"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.volume}"/>
                <Border Grid.Column="3" Theme="{StaticResource PlaybackValueChip}">
                  <TextBlock x:Name="TxtSeritVolume" Theme="{StaticResource PlaybackValueText}"/>
                </Border>
              </Grid>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{StaticResource SpaceSm}"
                          VerticalAlignment="Center">
                <Button x:Name="BtnSeritBack" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.seek}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                    <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                          Data="{StaticResource IconRewind}" Fill="{Binding $parent[Button].Foreground}"/>
                    <TextBlock x:Name="TxtSeritBack" Theme="{StaticResource PlaybackValueText}"
                               Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnSeritPlay" Theme="{StaticResource PlaybackPlayButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.playpause}">
                  <Path x:Name="GlyphSeritPlay"
                        Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" Stretch="Uniform"
                        Data="{StaticResource IconPlay}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button x:Name="BtnSeritForward" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.seek}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                    <TextBlock x:Name="TxtSeritForward" Theme="{StaticResource PlaybackValueText}"
                               Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                    <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                          Data="{StaticResource IconFastForward}" Fill="{Binding $parent[Button].Foreground}"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <Grid Grid.Column="2"
                    ColumnSpacing="{StaticResource SpaceSm}"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" MaxWidth="{StaticResource PlaybackSliderWidth}"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="BtnSeritSpeedReset" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.normalspeed}">
                  <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconSpeed}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Slider Grid.Column="2" x:Name="SliderSeritSpeed"
                        Theme="{StaticResource PlaybackSlider}"
                        TickFrequency="{StaticResource PlaybackSpeedTick}"
                        IsSnapToTickEnabled="True"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.faster}"/>
                <Border Grid.Column="3" Theme="{StaticResource PlaybackValueChip}">
                  <TextBlock x:Name="TxtSeritSpeed" Theme="{StaticResource PlaybackValueText}"/>
                </Border>
                <Button Grid.Column="4" x:Name="BtnSeritFullScreen" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.fullscreen}">
                  <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        Data="{StaticResource IconFullScreen}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Panel>
    </Border>
  </Grid>
</UserControl>
