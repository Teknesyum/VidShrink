<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gruvbox Dark ve Discord Dark'ın sıcak, kahve-gri zemini. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF8ABEFF</Color>
  <Color x:Key="NeonPinkColor">#FFD94AC9</Color>
  <Color x:Key="NeonPurpleColor">#FFAB82EF</Color>
  <Color x:Key="NeonSuccessColor">#FF9BE087</Color>
  <Color x:Key="SurfaceToneColor">#FF1E1A18</Color>
  <Color x:Key="AppBgColor">#FF151210</Color>
  <Color x:Key="TextBodyColor">#FFF8F2EA</Color>
  <Color x:Key="TextDisabledColor">#FF8F867F</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFF8BAF0</Color>

  <Color x:Key="NeonBlueFillColor">#1A8ABEFF</Color>
  <Color x:Key="NeonBlueHoverColor">#338ABEFF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D8ABEFF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D8ABEFE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#808ABEFF</Color>
  <Color x:Key="NeonPinkFillColor">#1AD94AC9</Color>
  <Color x:Key="NeonPurpleBorderColor">#80AB82EF</Color>

  <Color x:Key="NeonEmberColor">#FFD94ACA</Color>
  <Color x:Key="EmberFlameColor">#FFEC8C96</Color>
  <Color x:Key="EmberBlazeColor">#FFFFCD62</Color>
  <Color x:Key="AtmosHotColor">#FFFFCD63</Color>
  <Color x:Key="AtmosMidColor">#FFEC8C97</Color>
  <Color x:Key="AtmosEdgeColor">#FFD94ACB</Color>
  <Color x:Key="EmberDeepColor">#FF140F10</Color>
  <Color x:Key="EmberMidColor">#FF161011</Color>
  <Color x:Key="EmberEdgeColor">#FF181014</Color>
  <Color x:Key="EmberBarDeepColor">#FF1C1517</Color>
  <Color x:Key="EmberBarMidColor">#FF1E161A</Color>
  <Color x:Key="EmberBarEdgeColor">#FF22171C</Color>
  <Color x:Key="EmberFlameGlyphColor">#FFF5A97F</Color>

  <Color x:Key="PlaybackScrimColor">#CC151210</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00151210</Color>
  <Color x:Key="PlaybackTitleScrimColor">#E6151210</Color>
  <Color x:Key="PauseGlossColor">#FFF8F2EB</Color>
  <Color x:Key="PauseGlossFadeColor">#00F8F2EA</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #408ABEFF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40D94AC9</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40AB82EF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
