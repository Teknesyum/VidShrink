<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Rose Pine'ın şafak çeşidi; kırık beyaz zemin üstünde gül ve köpük. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF56949F</Color>
  <Color x:Key="NeonPinkColor">#FFD7827E</Color>
  <Color x:Key="NeonPurpleColor">#FF907AA9</Color>
  <Color x:Key="NeonSuccessColor">#FF286983</Color>
  <Color x:Key="SurfaceToneColor">#FFFFFAF3</Color>
  <Color x:Key="AppBgColor">#FFFAF4ED</Color>
  <Color x:Key="TextBodyColor">#FF575279</Color>
  <Color x:Key="TextDisabledColor">#FF797593</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFE4ABA9</Color>

  <Color x:Key="NeonBlueFillColor">#1A56949F</Color>
  <Color x:Key="NeonBlueHoverColor">#3356949F</Color>
  <Color x:Key="NeonBlueActiveColor">#4D56949F</Color>
  <Color x:Key="NeonBlueBorderColor">#4D5694A0</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8056949F</Color>
  <Color x:Key="NeonPinkFillColor">#1AD7827E</Color>
  <Color x:Key="NeonPurpleBorderColor">#80907AA9</Color>

  <Color x:Key="NeonEmberColor">#FFB4637A</Color>
  <Color x:Key="EmberFlameColor">#FFD7827F</Color>
  <Color x:Key="EmberBlazeColor">#FFEA9D34</Color>
  <Color x:Key="AtmosHotColor">#FFEA9D35</Color>
  <Color x:Key="AtmosMidColor">#FFD78280</Color>
  <Color x:Key="AtmosEdgeColor">#FFB4637B</Color>
  <Color x:Key="EmberDeepColor">#FFFAF4EF</Color>
  <Color x:Key="EmberMidColor">#FFFAF3EE</Color>
  <Color x:Key="EmberEdgeColor">#FFF8F1EC</Color>
  <Color x:Key="EmberBarDeepColor">#FFFDF7F3</Color>
  <Color x:Key="EmberBarMidColor">#FFFCF5F1</Color>
  <Color x:Key="EmberBarEdgeColor">#FFFBF3EF</Color>

  <Color x:Key="PlaybackScrimColor">#CCFAF4ED</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00FAF4ED</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4056949F</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40D7827E</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40907AA9</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
