<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF00FFBE</Color>
  <Color x:Key="NeonPinkColor">#FFC800FF</Color>
  <Color x:Key="NeonPurpleColor">#FF6F26FF</Color>
  <Color x:Key="NeonSuccessColor">#FF34D369</Color>
  <Color x:Key="SurfaceToneColor">#FF121316</Color>
  <Color x:Key="AppBgColor">#FF050607</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF71747A</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFE054FF</Color>

  <Color x:Key="NeonBlueFillColor">#1A00FFBE</Color>
  <Color x:Key="NeonBlueHoverColor">#3300FFBE</Color>
  <Color x:Key="NeonBlueActiveColor">#4D00FFBE</Color>
  <Color x:Key="NeonBlueBorderColor">#4D00FFBE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8000FFBE</Color>
  <Color x:Key="NeonPinkFillColor">#1AC800FF</Color>
  <Color x:Key="NeonPurpleBorderColor">#806F26FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF0080</Color>
  <Color x:Key="EmberFlameColor">#FFFF1A00</Color>
  <Color x:Key="EmberBlazeColor">#FFFFB200</Color>
  <Color x:Key="EmberDeepColor">#FF070307</Color>
  <Color x:Key="EmberMidColor">#FF080408</Color>
  <Color x:Key="EmberEdgeColor">#FF0B0409</Color>
  <Color x:Key="EmberBarDeepColor">#FF130D12</Color>
  <Color x:Key="EmberBarMidColor">#FF150E13</Color>
  <Color x:Key="EmberBarEdgeColor">#FF170F14</Color>

  <Color x:Key="PlaybackScrimColor">#CC050607</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00050607</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4000FFBE</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40C800FF</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #406F26FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
