<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Monokai Pro; canlı ve doygun şeker renkleri, sıcak gri zemin. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFD4F4F7</Color>
  <Color x:Key="NeonPinkColor">#FFFF6188</Color>
  <Color x:Key="NeonPurpleColor">#FFAB9DF2</Color>
  <Color x:Key="NeonSuccessColor">#FFBBE493</Color>
  <Color x:Key="SurfaceToneColor">#FF403E41</Color>
  <Color x:Key="AppBgColor">#FF2D2A2E</Color>
  <Color x:Key="TextBodyColor">#FFFCFCFA</Color>
  <Color x:Key="TextDisabledColor">#FFA5A3A6</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFFA2B9</Color>

  <Color x:Key="NeonBlueFillColor">#1AD4F4F7</Color>
  <Color x:Key="NeonBlueHoverColor">#33D4F4F7</Color>
  <Color x:Key="NeonBlueActiveColor">#4DD4F4F7</Color>
  <Color x:Key="NeonBlueBorderColor">#4DD4F4F8</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80D4F4F7</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF6188</Color>
  <Color x:Key="NeonPurpleBorderColor">#80AB9DF2</Color>

  <Color x:Key="NeonEmberColor">#FFF25C81</Color>
  <Color x:Key="EmberFlameColor">#FFFC9867</Color>
  <Color x:Key="EmberBlazeColor">#FFFFD866</Color>
  <Color x:Key="AtmosHotColor">#FFFFD867</Color>
  <Color x:Key="AtmosMidColor">#FFFC9868</Color>
  <Color x:Key="AtmosEdgeColor">#FFF25C82</Color>
  <Color x:Key="EmberDeepColor">#FF262225</Color>
  <Color x:Key="EmberMidColor">#FF292226</Color>
  <Color x:Key="EmberEdgeColor">#FF2B2227</Color>
  <Color x:Key="EmberBarDeepColor">#FF363134</Color>
  <Color x:Key="EmberBarMidColor">#FF393235</Color>
  <Color x:Key="EmberBarEdgeColor">#FF3B3236</Color>
  <Color x:Key="EmberFlameGlyphColor">#FFFFD868</Color>

  <Color x:Key="PlaybackScrimColor">#CC2D2A2E</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#002D2A2E</Color>
  <Color x:Key="PlaybackTitleScrimColor">#E62D2A2E</Color>
  <Color x:Key="PauseGlossColor">#FFFCFCFB</Color>
  <Color x:Key="PauseGlossFadeColor">#00FCFCFA</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40D4F4F7</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FF6188</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40AB9DF2</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
