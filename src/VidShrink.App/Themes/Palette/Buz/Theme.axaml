<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Catppuccin Latte ve JetBrains Islands Light'ın soğuk, mavimsi grisi. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF0B2C82</Color>
  <Color x:Key="NeonPinkColor">#FFBD2FD0</Color>
  <Color x:Key="NeonPurpleColor">#FF7638E8</Color>
  <Color x:Key="NeonSuccessColor">#FF0B3F22</Color>
  <Color x:Key="SurfaceToneColor">#FFECEFF4</Color>
  <Color x:Key="AppBgColor">#FFF8FAFC</Color>
  <Color x:Key="TextBodyColor">#FF171B25</Color>
  <Color x:Key="TextDisabledColor">#FF5C6371</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFF</Color>
  <Color x:Key="PinkTextColor">#FF600F6D</Color>

  <Color x:Key="NeonBlueFillColor">#1A0B2C82</Color>
  <Color x:Key="NeonBlueHoverColor">#330B2C82</Color>
  <Color x:Key="NeonBlueActiveColor">#4D0B2C82</Color>
  <Color x:Key="NeonBlueBorderColor">#4D0B2C83</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#800B2C82</Color>
  <Color x:Key="NeonPinkFillColor">#1ABD2FD0</Color>
  <Color x:Key="NeonPurpleBorderColor">#807638E8</Color>

  <Color x:Key="NeonEmberColor">#FFBD2FD1</Color>
  <Color x:Key="EmberFlameColor">#FF842E68</Color>
  <Color x:Key="EmberBlazeColor">#FF4C2E00</Color>
  <Color x:Key="AtmosHotColor">#FF4C2E01</Color>
  <Color x:Key="AtmosMidColor">#FF842E69</Color>
  <Color x:Key="AtmosEdgeColor">#FFBD2FD2</Color>
  <Color x:Key="EmberDeepColor">#FFF9F8FC</Color>
  <Color x:Key="EmberMidColor">#FFF8F6FB</Color>
  <Color x:Key="EmberEdgeColor">#FFF7F3FB</Color>
  <Color x:Key="EmberBarDeepColor">#FFEFEEF6</Color>
  <Color x:Key="EmberBarMidColor">#FFEFEBF5</Color>
  <Color x:Key="EmberBarEdgeColor">#FFEEE8F4</Color>

  <Color x:Key="PlaybackScrimColor">#CCF8FAFC</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00F8FAFC</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #400B2C82</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40BD2FD0</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #407638E8</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
