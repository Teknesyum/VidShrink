<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FFFF008D</Color>
  <Color x:Key="NeonPinkColor">#FF84FF00</Color>
  <Color x:Key="NeonPurpleColor">#FFF7FF26</Color>
  <Color x:Key="NeonSuccessColor">#FFD334CD</Color>
  <Color x:Key="SurfaceToneColor">#FF161412</Color>
  <Color x:Key="AppBgColor">#FF070605</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF7A7571</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFA7FF54</Color>

  <Color x:Key="NeonBlueFillColor">#1AFF008D</Color>
  <Color x:Key="NeonBlueHoverColor">#33FF008D</Color>
  <Color x:Key="NeonBlueActiveColor">#4DFF008D</Color>
  <Color x:Key="NeonBlueBorderColor">#4DFF008D</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80FF008D</Color>
  <Color x:Key="NeonPinkFillColor">#1A84FF00</Color>
  <Color x:Key="NeonPurpleBorderColor">#80F7FF26</Color>

  <Color x:Key="NeonEmberColor">#FF00FF33</Color>
  <Color x:Key="EmberFlameColor">#FF00FFCC</Color>
  <Color x:Key="EmberBlazeColor">#FF0099FF</Color>
  <Color x:Key="EmberDeepColor">#FF040703</Color>
  <Color x:Key="EmberMidColor">#FF050804</Color>
  <Color x:Key="EmberEdgeColor">#FF040B04</Color>
  <Color x:Key="EmberBarDeepColor">#FF0E130D</Color>
  <Color x:Key="EmberBarMidColor">#FF0E150E</Color>
  <Color x:Key="EmberBarEdgeColor">#FF0F170F</Color>

  <Color x:Key="PlaybackScrimColor">#CC070605</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00070605</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40FF008D</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4084FF00</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40F7FF26</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
