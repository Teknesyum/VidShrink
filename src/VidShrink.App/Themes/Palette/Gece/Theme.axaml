<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- GitHub Primer Dark ve Tokyo Night'ın mavimsi lacivert zemini. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF6CB4FF</Color>
  <Color x:Key="NeonPinkColor">#FFD63DE6</Color>
  <Color x:Key="NeonPurpleColor">#FF9B6CF5</Color>
  <Color x:Key="NeonSuccessColor">#FF56E08A</Color>
  <Color x:Key="SurfaceToneColor">#FF0D1220</Color>
  <Color x:Key="AppBgColor">#FF070A14</Color>
  <Color x:Key="TextBodyColor">#FFE8EEF8</Color>
  <Color x:Key="TextDisabledColor">#FF7F8798</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFF3B1FB</Color>

  <Color x:Key="NeonBlueFillColor">#1A6CB4FF</Color>
  <Color x:Key="NeonBlueHoverColor">#336CB4FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D6CB4FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D6CB4FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#806CB4FF</Color>
  <Color x:Key="NeonPinkFillColor">#1AD63DE6</Color>
  <Color x:Key="NeonPurpleBorderColor">#809B6CF5</Color>

  <Color x:Key="NeonEmberColor">#FFD63DE7</Color>
  <Color x:Key="EmberFlameColor">#FFEA8398</Color>
  <Color x:Key="EmberBlazeColor">#FFFFC94A</Color>
  <Color x:Key="AtmosHotColor">#FFFFC94B</Color>
  <Color x:Key="AtmosMidColor">#FFEA8399</Color>
  <Color x:Key="AtmosEdgeColor">#FFD63DE8</Color>
  <Color x:Key="EmberDeepColor">#FF090913</Color>
  <Color x:Key="EmberMidColor">#FF0B0915</Color>
  <Color x:Key="EmberEdgeColor">#FF0D0A17</Color>
  <Color x:Key="EmberBarDeepColor">#FF0F0F1E</Color>
  <Color x:Key="EmberBarMidColor">#FF121021</Color>
  <Color x:Key="EmberBarEdgeColor">#FF151024</Color>

  <Color x:Key="PlaybackScrimColor">#CC070A14</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00070A14</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #406CB4FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40D63DE6</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #409B6CF5</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
