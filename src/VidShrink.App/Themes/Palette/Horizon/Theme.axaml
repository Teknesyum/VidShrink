<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gün batımı ufku; şeftali, pembe ve turkuazın sıcak-soğuk dengesi. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF25B0BC</Color>
  <Color x:Key="NeonPinkColor">#FFFAB795</Color>
  <Color x:Key="NeonPurpleColor">#FFB877DB</Color>
  <Color x:Key="NeonSuccessColor">#FF29D398</Color>
  <Color x:Key="SurfaceToneColor">#FF232530</Color>
  <Color x:Key="AppBgColor">#FF1C1E26</Color>
  <Color x:Key="TextBodyColor">#FFD5D8DA</Color>
  <Color x:Key="TextDisabledColor">#FF8A8DB0</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFCCFB8</Color>

  <Color x:Key="NeonBlueFillColor">#1A25B0BC</Color>
  <Color x:Key="NeonBlueHoverColor">#3325B0BC</Color>
  <Color x:Key="NeonBlueActiveColor">#4D25B0BC</Color>
  <Color x:Key="NeonBlueBorderColor">#4D25B0BD</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8025B0BC</Color>
  <Color x:Key="NeonPinkFillColor">#1AFAB795</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B877DB</Color>

  <Color x:Key="NeonEmberColor">#FFE95678</Color>
  <Color x:Key="EmberFlameColor">#FFF09383</Color>
  <Color x:Key="EmberBlazeColor">#FFFAC29A</Color>
  <Color x:Key="AtmosHotColor">#FFFAC29B</Color>
  <Color x:Key="AtmosMidColor">#FFF09384</Color>
  <Color x:Key="AtmosEdgeColor">#FFE95679</Color>
  <Color x:Key="EmberDeepColor">#FF19181F</Color>
  <Color x:Key="EmberMidColor">#FF1B1920</Color>
  <Color x:Key="EmberEdgeColor">#FF1E1A21</Color>
  <Color x:Key="EmberBarDeepColor">#FF201E27</Color>
  <Color x:Key="EmberBarMidColor">#FF231E29</Color>
  <Color x:Key="EmberBarEdgeColor">#FF261F29</Color>

  <Color x:Key="PlaybackScrimColor">#CC1C1E26</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001C1E26</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4025B0BC</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FAB795</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B877DB</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
