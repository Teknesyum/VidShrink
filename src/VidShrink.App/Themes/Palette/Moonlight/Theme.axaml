<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ay ışığı mavisi; Tokyo Night'ın daha yumuşak, mor eğilimli kardeşi. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFD1E0FF</Color>
  <Color x:Key="NeonPinkColor">#FF4FD6BE</Color>
  <Color x:Key="NeonPurpleColor">#FFC099FF</Color>
  <Color x:Key="NeonSuccessColor">#FFC3E88D</Color>
  <Color x:Key="SurfaceToneColor">#FF2F334D</Color>
  <Color x:Key="AppBgColor">#FF222436</Color>
  <Color x:Key="TextBodyColor">#FFF1F4FC</Color>
  <Color x:Key="TextDisabledColor">#FF8F97C4</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF89E4D3</Color>

  <Color x:Key="NeonBlueFillColor">#1AD1E0FF</Color>
  <Color x:Key="NeonBlueHoverColor">#33D1E0FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4DD1E0FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4DD1E0FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80D1E0FF</Color>
  <Color x:Key="NeonPinkFillColor">#1A4FD6BE</Color>
  <Color x:Key="NeonPurpleBorderColor">#80C099FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF757F</Color>
  <Color x:Key="EmberFlameColor">#FFFF966C</Color>
  <Color x:Key="EmberBlazeColor">#FFFFC777</Color>
  <Color x:Key="AtmosHotColor">#FFFFC778</Color>
  <Color x:Key="AtmosMidColor">#FFFF966D</Color>
  <Color x:Key="AtmosEdgeColor">#FFFF7580</Color>
  <Color x:Key="EmberDeepColor">#FF1E1E2B</Color>
  <Color x:Key="EmberMidColor">#FF211E2C</Color>
  <Color x:Key="EmberEdgeColor">#FF231F2D</Color>
  <Color x:Key="EmberBarDeepColor">#FF29293D</Color>
  <Color x:Key="EmberBarMidColor">#FF2C2A3E</Color>
  <Color x:Key="EmberBarEdgeColor">#FF302C3E</Color>

  <Color x:Key="PlaybackScrimColor">#CC222436</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00222436</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40D1E0FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #404FD6BE</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40C099FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
