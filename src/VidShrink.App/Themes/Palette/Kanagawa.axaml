<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Hokusai'nin dalgasından; mürekkep mavisi ve soluk Japon boyaları. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki on bir çekirdek renkten
       üretildi. Değiştirmek için çekirdeği düzenle ve VidShrink.PaletteGen
       aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF7E9CD8</Color>
  <Color x:Key="NeonPinkColor">#FF7AA89F</Color>
  <Color x:Key="NeonPurpleColor">#FF957FB8</Color>
  <Color x:Key="NeonSuccessColor">#FF98BB6C</Color>
  <Color x:Key="SurfaceToneColor">#FF2A2A37</Color>
  <Color x:Key="AppBgColor">#FF1F1F28</Color>
  <Color x:Key="TextBodyColor">#FFDCD7BA</Color>
  <Color x:Key="TextDisabledColor">#FF938AA9</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFF</Color>
  <Color x:Key="PinkTextColor">#FFA6C5BF</Color>

  <Color x:Key="NeonBlueFillColor">#1A7E9CD8</Color>
  <Color x:Key="NeonBlueHoverColor">#337E9CD8</Color>
  <Color x:Key="NeonBlueActiveColor">#4D7E9CD8</Color>
  <Color x:Key="NeonBlueBorderColor">#4D7E9CD8</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#807E9CD8</Color>
  <Color x:Key="NeonPinkFillColor">#1A7AA89F</Color>
  <Color x:Key="NeonPurpleBorderColor">#80957FB8</Color>

  <Color x:Key="NeonEmberColor">#FFC34043</Color>
  <Color x:Key="EmberFlameColor">#FFFFA066</Color>
  <Color x:Key="EmberBlazeColor">#FFE6C384</Color>
  <Color x:Key="EmberDeepColor">#FF222029</Color>
  <Color x:Key="EmberMidColor">#FF252029</Color>
  <Color x:Key="EmberEdgeColor">#FF272129</Color>
  <Color x:Key="EmberBarDeepColor">#FF2F2B37</Color>
  <Color x:Key="EmberBarMidColor">#FF322B38</Color>
  <Color x:Key="EmberBarEdgeColor">#FF352C38</Color>

  <Color x:Key="PlaybackScrimColor">#CC1F1F28</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001F1F28</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #407E9CD8</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #407AA89F</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40957FB8</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
