<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Petrol mavisi zemin, bilimsel ölçülmüş düşük kontrastlı efsane. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF2AA198</Color>
  <Color x:Key="NeonPinkColor">#FFB58900</Color>
  <Color x:Key="NeonPurpleColor">#FF8A8FD8</Color>
  <Color x:Key="NeonSuccessColor">#FF859900</Color>
  <Color x:Key="SurfaceToneColor">#FF073642</Color>
  <Color x:Key="AppBgColor">#FF002B36</Color>
  <Color x:Key="TextBodyColor">#FFEEE8D5</Color>
  <Color x:Key="TextDisabledColor">#FF93A1A1</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFCDB054</Color>

  <Color x:Key="NeonBlueFillColor">#1A2AA198</Color>
  <Color x:Key="NeonBlueHoverColor">#332AA198</Color>
  <Color x:Key="NeonBlueActiveColor">#4D2AA198</Color>
  <Color x:Key="NeonBlueBorderColor">#4D2AA199</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#802AA198</Color>
  <Color x:Key="NeonPinkFillColor">#1AB58900</Color>
  <Color x:Key="NeonPurpleBorderColor">#808A8FD8</Color>

  <Color x:Key="NeonEmberColor">#FFDC322F</Color>
  <Color x:Key="EmberFlameColor">#FFCB4B16</Color>
  <Color x:Key="EmberBlazeColor">#FFB58901</Color>
  <Color x:Key="AtmosHotColor">#FFB58902</Color>
  <Color x:Key="AtmosMidColor">#FFCB4B17</Color>
  <Color x:Key="AtmosEdgeColor">#FFDC3230</Color>
  <Color x:Key="EmberDeepColor">#FF03222A</Color>
  <Color x:Key="EmberMidColor">#FF06222A</Color>
  <Color x:Key="EmberEdgeColor">#FF09222A</Color>
  <Color x:Key="EmberBarDeepColor">#FF0A2A33</Color>
  <Color x:Key="EmberBarMidColor">#FF0E2A33</Color>
  <Color x:Key="EmberBarEdgeColor">#FF112A33</Color>

  <Color x:Key="PlaybackScrimColor">#CC002B36</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00002B36</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #402AA198</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40B58900</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #408A8FD8</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
