<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gül ve çam; menekşe zemin üstünde soluk pembe ve köpük mavisi. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF9CCFD8</Color>
  <Color x:Key="NeonPinkColor">#FFEBBCBA</Color>
  <Color x:Key="NeonPurpleColor">#FFC4A7E7</Color>
  <Color x:Key="NeonSuccessColor">#FF9CCFD9</Color>
  <Color x:Key="SurfaceToneColor">#FF1F1D2E</Color>
  <Color x:Key="AppBgColor">#FF191724</Color>
  <Color x:Key="TextBodyColor">#FFF4F3FB</Color>
  <Color x:Key="TextDisabledColor">#FF908CAA</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFF2D2D1</Color>

  <Color x:Key="NeonBlueFillColor">#1A9CCFD8</Color>
  <Color x:Key="NeonBlueHoverColor">#339CCFD8</Color>
  <Color x:Key="NeonBlueActiveColor">#4D9CCFD8</Color>
  <Color x:Key="NeonBlueBorderColor">#4D9CCFD9</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#809CCFD8</Color>
  <Color x:Key="NeonPinkFillColor">#1AEBBCBA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80C4A7E7</Color>

  <Color x:Key="NeonEmberColor">#FFEB6F92</Color>
  <Color x:Key="EmberFlameColor">#FFEBBCBB</Color>
  <Color x:Key="EmberBlazeColor">#FFF6C177</Color>
  <Color x:Key="AtmosHotColor">#FFF6C178</Color>
  <Color x:Key="AtmosMidColor">#FFEBBCBC</Color>
  <Color x:Key="AtmosEdgeColor">#FFEB6F93</Color>
  <Color x:Key="EmberDeepColor">#FF17141E</Color>
  <Color x:Key="EmberMidColor">#FF19141F</Color>
  <Color x:Key="EmberEdgeColor">#FF1C1521</Color>
  <Color x:Key="EmberBarDeepColor">#FF1D1826</Color>
  <Color x:Key="EmberBarMidColor">#FF201A28</Color>
  <Color x:Key="EmberBarEdgeColor">#FF231B29</Color>

  <Color x:Key="PlaybackScrimColor">#CC191724</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00191724</Color>
  <Color x:Key="PauseGlossColor">#FFF4F3FC</Color>
  <Color x:Key="PauseGlossFadeColor">#00F4F3FB</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #409CCFD8</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40EBBCBA</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40C4A7E7</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
