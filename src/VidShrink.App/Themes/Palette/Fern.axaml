<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF27FF00</Color>
  <Color x:Key="NeonPinkColor">#FF001EFF</Color>
  <Color x:Key="NeonPurpleColor">#FF26A0FF</Color>
  <Color x:Key="NeonSuccessColor">#FF8ED334</Color>
  <Color x:Key="SurfaceToneColor">#FF121615</Color>
  <Color x:Key="AppBgColor">#FF050707</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF717A78</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF5462FF</Color>

  <Color x:Key="NeonBlueFillColor">#1A27FF00</Color>
  <Color x:Key="NeonBlueHoverColor">#3327FF00</Color>
  <Color x:Key="NeonBlueActiveColor">#4D27FF00</Color>
  <Color x:Key="NeonBlueBorderColor">#4D27FF00</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8027FF00</Color>
  <Color x:Key="NeonPinkFillColor">#1A001EFF</Color>
  <Color x:Key="NeonPurpleBorderColor">#8026A0FF</Color>

  <Color x:Key="NeonEmberColor">#FF9900FF</Color>
  <Color x:Key="EmberFlameColor">#FFFF00CC</Color>
  <Color x:Key="EmberBlazeColor">#FFFF0033</Color>
  <Color x:Key="EmberDeepColor">#FF030307</Color>
  <Color x:Key="EmberMidColor">#FF040408</Color>
  <Color x:Key="EmberEdgeColor">#FF07040B</Color>
  <Color x:Key="EmberBarDeepColor">#FF0F0D13</Color>
  <Color x:Key="EmberBarMidColor">#FF110E15</Color>
  <Color x:Key="EmberBarEdgeColor">#FF120F17</Color>

  <Color x:Key="PlaybackScrimColor">#CC050707</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00050707</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4027FF00</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40001EFF</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #4026A0FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
