<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF00FF25</Color>
  <Color x:Key="NeonPinkColor">#FF2F00FF</Color>
  <Color x:Key="NeonPurpleColor">#FF265FFF</Color>
  <Color x:Key="NeonSuccessColor">#FF5ED334</Color>
  <Color x:Key="SurfaceToneColor">#FF121616</Color>
  <Color x:Key="AppBgColor">#FF050707</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF71797A</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF7954FF</Color>

  <Color x:Key="NeonBlueFillColor">#1A00FF25</Color>
  <Color x:Key="NeonBlueHoverColor">#3300FF25</Color>
  <Color x:Key="NeonBlueActiveColor">#4D00FF25</Color>
  <Color x:Key="NeonBlueBorderColor">#4D00FF25</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8000FF25</Color>
  <Color x:Key="NeonPinkFillColor">#1A2F00FF</Color>
  <Color x:Key="NeonPurpleBorderColor">#80265FFF</Color>

  <Color x:Key="NeonEmberColor">#FFE500FF</Color>
  <Color x:Key="EmberFlameColor">#FFFF0080</Color>
  <Color x:Key="EmberBlazeColor">#FFFF1A00</Color>
  <Color x:Key="EmberDeepColor">#FF040307</Color>
  <Color x:Key="EmberMidColor">#FF050408</Color>
  <Color x:Key="EmberEdgeColor">#FF09040B</Color>
  <Color x:Key="EmberBarDeepColor">#FF110D13</Color>
  <Color x:Key="EmberBarMidColor">#FF130E15</Color>
  <Color x:Key="EmberBarEdgeColor">#FF150F17</Color>

  <Color x:Key="PlaybackScrimColor">#CC050707</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00050707</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4000FF25</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #402F00FF</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40265FFF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
