<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gruvbox'ın açık yarısı; krem kağıt zemin, aynı toprak tonlu vurgular. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF04404B</Color>
  <Color x:Key="NeonPinkColor">#FF784E0D</Color>
  <Color x:Key="NeonPurpleColor">#FF893C6C</Color>
  <Color x:Key="NeonSuccessColor">#FF444208</Color>
  <Color x:Key="SurfaceToneColor">#FFEBDBB2</Color>
  <Color x:Key="AppBgColor">#FFFBF1C7</Color>
  <Color x:Key="TextBodyColor">#FF282524</Color>
  <Color x:Key="TextDisabledColor">#FF7C6F64</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFF</Color>
  <Color x:Key="PinkTextColor">#FF62481F</Color>

  <Color x:Key="NeonBlueFillColor">#1A04404B</Color>
  <Color x:Key="NeonBlueHoverColor">#3304404B</Color>
  <Color x:Key="NeonBlueActiveColor">#4D04404B</Color>
  <Color x:Key="NeonBlueBorderColor">#4D04404C</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8004404B</Color>
  <Color x:Key="NeonPinkFillColor">#1A784E0D</Color>
  <Color x:Key="NeonPurpleBorderColor">#80893C6C</Color>

  <Color x:Key="NeonEmberColor">#FF9D0006</Color>
  <Color x:Key="EmberFlameColor">#FFAF3A03</Color>
  <Color x:Key="EmberBlazeColor">#FF5A3B0A</Color>
  <Color x:Key="AtmosHotColor">#FF5A3B0B</Color>
  <Color x:Key="AtmosMidColor">#FFAF3A04</Color>
  <Color x:Key="AtmosEdgeColor">#FF9D0007</Color>
  <Color x:Key="EmberDeepColor">#FFFAF0D0</Color>
  <Color x:Key="EmberMidColor">#FFFAEECE</Color>
  <Color x:Key="EmberEdgeColor">#FFF8EBCC</Color>
  <Color x:Key="EmberBarDeepColor">#FFEEDDBF</Color>
  <Color x:Key="EmberBarMidColor">#FFECDABC</Color>
  <Color x:Key="EmberBarEdgeColor">#FFECD7BA</Color>
  <Color x:Key="EmberFlameGlyphColor">#FF5A3B0C</Color>

  <Color x:Key="PlaybackScrimColor">#CCFBF1C7</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00FBF1C7</Color>
  <Color x:Key="PauseGlossColor">#FFFBF1C8</Color>
  <Color x:Key="PauseGlossFadeColor">#00FBF1C8</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4004404B</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40784E0D</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40893C6C</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
