<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One Light ve VS Code Light Modern'in hafif kirli, yumuşak beyazı. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF0F3390</Color>
  <Color x:Key="NeonPinkColor">#FFBD2CCC</Color>
  <Color x:Key="NeonPurpleColor">#FF7A3BE6</Color>
  <Color x:Key="NeonSuccessColor">#FF0E4326</Color>
  <Color x:Key="SurfaceToneColor">#FFF6F6F4</Color>
  <Color x:Key="AppBgColor">#FFFFFFFF</Color>
  <Color x:Key="TextBodyColor">#FF1C1E24</Color>
  <Color x:Key="TextDisabledColor">#FF61656D</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFE</Color>
  <Color x:Key="PinkTextColor">#FF6A1079</Color>

  <Color x:Key="NeonBlueFillColor">#1A0F3390</Color>
  <Color x:Key="NeonBlueHoverColor">#330F3390</Color>
  <Color x:Key="NeonBlueActiveColor">#4D0F3390</Color>
  <Color x:Key="NeonBlueBorderColor">#4D0F3391</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#880F3390</Color>
  <Color x:Key="NeonPinkFillColor">#1ABD2CCC</Color>
  <Color x:Key="NeonPurpleBorderColor">#807A3BE6</Color>

  <Color x:Key="NeonEmberColor">#FFBD2CCD</Color>
  <Color x:Key="EmberFlameColor">#FF892F68</Color>
  <Color x:Key="EmberBlazeColor">#FF553203</Color>
  <Color x:Key="AtmosHotColor">#FF553204</Color>
  <Color x:Key="AtmosMidColor">#FF892F69</Color>
  <Color x:Key="AtmosEdgeColor">#FFBD2CCE</Color>
  <Color x:Key="EmberDeepColor">#FFFEFCFE</Color>
  <Color x:Key="EmberMidColor">#FFFDFAFD</Color>
  <Color x:Key="EmberEdgeColor">#FFFDF6FD</Color>
  <Color x:Key="EmberBarDeepColor">#FFF6F3F6</Color>
  <Color x:Key="EmberBarMidColor">#FFF6F0F5</Color>
  <Color x:Key="EmberBarEdgeColor">#FFF5EDF4</Color>
  <Color x:Key="EmberFlameGlyphColor">#FF7C304F</Color>

  <Color x:Key="PlaybackScrimColor">#CCFFFFFF</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00FFFFFF</Color>
  <Color x:Key="PlaybackTitleScrimColor">#E6FFFFFF</Color>
  <Color x:Key="PauseGlossColor">#FFFFFFFD</Color>
  <Color x:Key="PauseGlossFadeColor">#00FFFFFE</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #400F3390</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40BD2CCC</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #407A3BE6</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
