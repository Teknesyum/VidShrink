<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF000DFF</Color>
  <Color x:Key="NeonPinkColor">#FFFF0004</Color>
  <Color x:Key="NeonPurpleColor">#FFFF268B</Color>
  <Color x:Key="NeonSuccessColor">#FF347ED3</Color>
  <Color x:Key="SurfaceToneColor">#FF161216</Color>
  <Color x:Key="AppBgColor">#FF070507</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF79717A</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFF5754</Color>

  <Color x:Key="NeonBlueFillColor">#1A000DFF</Color>
  <Color x:Key="NeonBlueHoverColor">#33000DFF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D000DFF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D000DFF</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80000DFF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF0004</Color>
  <Color x:Key="NeonPurpleBorderColor">#80FF268B</Color>

  <Color x:Key="NeonEmberColor">#FFFFB200</Color>
  <Color x:Key="EmberFlameColor">#FFB2FF00</Color>
  <Color x:Key="EmberBlazeColor">#FF1AFF00</Color>
  <Color x:Key="EmberDeepColor">#FF070403</Color>
  <Color x:Key="EmberMidColor">#FF080504</Color>
  <Color x:Key="EmberEdgeColor">#FF0B0704</Color>
  <Color x:Key="EmberBarDeepColor">#FF130F0D</Color>
  <Color x:Key="EmberBarMidColor">#FF15110E</Color>
  <Color x:Key="EmberBarEdgeColor">#FF17130F</Color>

  <Color x:Key="PlaybackScrimColor">#CC070507</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00070507</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40000DFF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FF0004</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40FF268B</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
