<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cobalt2; kobalt mavisi zemin üstünde sarı ve camgöbeği. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki on bir çekirdek renkten
       üretildi. Değiştirmek için çekirdeği düzenle ve VidShrink.PaletteGen
       aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF9EFFFF</Color>
  <Color x:Key="NeonPinkColor">#FFFFC600</Color>
  <Color x:Key="NeonPurpleColor">#FFFB94FF</Color>
  <Color x:Key="NeonSuccessColor">#FF3AD900</Color>
  <Color x:Key="SurfaceToneColor">#FF1F4662</Color>
  <Color x:Key="AppBgColor">#FF193549</Color>
  <Color x:Key="TextBodyColor">#FFE1EFFF</Color>
  <Color x:Key="TextDisabledColor">#FF9FBBD4</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFFD954</Color>

  <Color x:Key="NeonBlueFillColor">#1A9EFFFF</Color>
  <Color x:Key="NeonBlueHoverColor">#339EFFFF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D9EFFFF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D9EFFFF</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#809EFFFF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFFC600</Color>
  <Color x:Key="NeonPurpleBorderColor">#80FB94FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF628C</Color>
  <Color x:Key="EmberFlameColor">#FFFF9D00</Color>
  <Color x:Key="EmberBlazeColor">#FFFFEE80</Color>
  <Color x:Key="EmberDeepColor">#FF1E364A</Color>
  <Color x:Key="EmberMidColor">#FF21374B</Color>
  <Color x:Key="EmberEdgeColor">#FF24374C</Color>
  <Color x:Key="EmberBarDeepColor">#FF264763</Color>
  <Color x:Key="EmberBarMidColor">#FF2A4764</Color>
  <Color x:Key="EmberBarEdgeColor">#FF2F4865</Color>

  <Color x:Key="PlaybackScrimColor">#CC193549</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00193549</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #409EFFFF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FFC600</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40FB94FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
