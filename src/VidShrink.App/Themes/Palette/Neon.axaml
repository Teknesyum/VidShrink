<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF00F3FF</Color>
  <Color x:Key="NeonPinkColor">#FFFF00EA</Color>
  <Color x:Key="NeonPurpleColor">#FFB026FF</Color>
  <Color x:Key="NeonSuccessColor">#FF34D399</Color>
  <Color x:Key="SurfaceToneColor">#FF121216</Color>
  <Color x:Key="AppBgColor">#FF050507</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF71717A</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFF54EB</Color>

  <Color x:Key="NeonBlueFillColor">#1A00F3FF</Color>
  <Color x:Key="NeonBlueHoverColor">#3300F3FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D00F3FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D00F3FF</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8000F3FF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF00EA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B026FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF0033</Color>
  <Color x:Key="EmberFlameColor">#FFFF6600</Color>
  <Color x:Key="EmberBlazeColor">#FFFFFF00</Color>
  <Color x:Key="EmberDeepColor">#FF070306</Color>
  <Color x:Key="EmberMidColor">#FF080407</Color>
  <Color x:Key="EmberEdgeColor">#FF0B0407</Color>
  <Color x:Key="EmberBarDeepColor">#FF130D10</Color>
  <Color x:Key="EmberBarMidColor">#FF150E11</Color>
  <Color x:Key="EmberBarEdgeColor">#FF170F12</Color>

  <Color x:Key="PlaybackScrimColor">#CC050507</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00050507</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4000F3FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FF00EA</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B026FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
