<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Mor-pembe ağırlıklı, yüksek kontrastlı klasik. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFA3EEFD</Color>
  <Color x:Key="NeonPinkColor">#FFFF79C6</Color>
  <Color x:Key="NeonPurpleColor">#FFBD93F9</Color>
  <Color x:Key="NeonSuccessColor">#FF50FA7B</Color>
  <Color x:Key="SurfaceToneColor">#FF343746</Color>
  <Color x:Key="AppBgColor">#FF282A36</Color>
  <Color x:Key="TextBodyColor">#FFF8F8F2</Color>
  <Color x:Key="TextDisabledColor">#FF979EB8</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFFA5D9</Color>

  <Color x:Key="NeonBlueFillColor">#1AA3EEFD</Color>
  <Color x:Key="NeonBlueHoverColor">#33A3EEFD</Color>
  <Color x:Key="NeonBlueActiveColor">#4DA3EEFD</Color>
  <Color x:Key="NeonBlueBorderColor">#4DA3EEFE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80A3EEFD</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF79C6</Color>
  <Color x:Key="NeonPurpleBorderColor">#80BD93F9</Color>

  <Color x:Key="NeonEmberColor">#FFFF5555</Color>
  <Color x:Key="EmberFlameColor">#FFFFB86C</Color>
  <Color x:Key="EmberBlazeColor">#FFF1FA8C</Color>
  <Color x:Key="AtmosHotColor">#FFF1FA8D</Color>
  <Color x:Key="AtmosMidColor">#FFFFB86D</Color>
  <Color x:Key="AtmosEdgeColor">#FFFF5556</Color>
  <Color x:Key="EmberDeepColor">#FF22222B</Color>
  <Color x:Key="EmberMidColor">#FF25222B</Color>
  <Color x:Key="EmberEdgeColor">#FF28222C</Color>
  <Color x:Key="EmberBarDeepColor">#FF2D2C37</Color>
  <Color x:Key="EmberBarMidColor">#FF302C37</Color>
  <Color x:Key="EmberBarEdgeColor">#FF332C37</Color>

  <Color x:Key="PlaybackScrimColor">#CC282A36</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00282A36</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40A3EEFD</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FF79C6</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40BD93F9</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
