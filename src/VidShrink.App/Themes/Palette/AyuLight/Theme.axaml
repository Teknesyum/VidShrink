<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ayu'nun açık çeşidi; neredeyse beyaz zemin, turuncu-mavi keskinliği. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki on bir çekirdek renkten
       üretildi. Değiştirmek için çekirdeği düzenle ve VidShrink.PaletteGen
       aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF399EE6</Color>
  <Color x:Key="NeonPinkColor">#FF86B300</Color>
  <Color x:Key="NeonPurpleColor">#FFA37ACC</Color>
  <Color x:Key="NeonSuccessColor">#FF86B300</Color>
  <Color x:Key="SurfaceToneColor">#FFF3F4F5</Color>
  <Color x:Key="AppBgColor">#FFFCFCFC</Color>
  <Color x:Key="TextBodyColor">#FF5C6166</Color>
  <Color x:Key="TextDisabledColor">#FF8A9199</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFF</Color>
  <Color x:Key="PinkTextColor">#FFAECC54</Color>

  <Color x:Key="NeonBlueFillColor">#1A399EE6</Color>
  <Color x:Key="NeonBlueHoverColor">#33399EE6</Color>
  <Color x:Key="NeonBlueActiveColor">#4D399EE6</Color>
  <Color x:Key="NeonBlueBorderColor">#4D399EE6</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80399EE6</Color>
  <Color x:Key="NeonPinkFillColor">#1A86B300</Color>
  <Color x:Key="NeonPurpleBorderColor">#80A37ACC</Color>

  <Color x:Key="NeonEmberColor">#FFF07171</Color>
  <Color x:Key="EmberFlameColor">#FFFA8D3E</Color>
  <Color x:Key="EmberBlazeColor">#FFF2AE49</Color>
  <Color x:Key="EmberDeepColor">#FFFDFAFA</Color>
  <Color x:Key="EmberMidColor">#FFFDF9F9</Color>
  <Color x:Key="EmberEdgeColor">#FFFCF7F7</Color>
  <Color x:Key="EmberBarDeepColor">#FFF6F3F4</Color>
  <Color x:Key="EmberBarMidColor">#FFF6F1F2</Color>
  <Color x:Key="EmberBarEdgeColor">#FFF6EFF0</Color>

  <Color x:Key="PlaybackScrimColor">#CCFCFCFC</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00FCFCFC</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40399EE6</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4086B300</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40A37ACC</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
