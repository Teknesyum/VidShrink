<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Mocha çeşidi; yumuşak pastel vurgular, gözü yormayan düşük doygunluk. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFCEE1FD</Color>
  <Color x:Key="NeonPinkColor">#FF94E2D5</Color>
  <Color x:Key="NeonPurpleColor">#FFCBA6F7</Color>
  <Color x:Key="NeonSuccessColor">#FFA6E3A1</Color>
  <Color x:Key="SurfaceToneColor">#FF313244</Color>
  <Color x:Key="AppBgColor">#FF1E1E2E</Color>
  <Color x:Key="TextBodyColor">#FFF4F6FD</Color>
  <Color x:Key="TextDisabledColor">#FFA6ADC8</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFB7ECE3</Color>

  <Color x:Key="NeonBlueFillColor">#1ACEE1FD</Color>
  <Color x:Key="NeonBlueHoverColor">#33CEE1FD</Color>
  <Color x:Key="NeonBlueActiveColor">#4DCEE1FD</Color>
  <Color x:Key="NeonBlueBorderColor">#4DCEE1FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80CEE1FD</Color>
  <Color x:Key="NeonPinkFillColor">#1A94E2D5</Color>
  <Color x:Key="NeonPurpleBorderColor">#80CBA6F7</Color>

  <Color x:Key="NeonEmberColor">#FFF38BA8</Color>
  <Color x:Key="EmberFlameColor">#FFFAB387</Color>
  <Color x:Key="EmberBlazeColor">#FFF9E2AF</Color>
  <Color x:Key="AtmosHotColor">#FFF9E2B0</Color>
  <Color x:Key="AtmosMidColor">#FFFAB388</Color>
  <Color x:Key="AtmosEdgeColor">#FFF38BA9</Color>
  <Color x:Key="EmberDeepColor">#FF1B1925</Color>
  <Color x:Key="EmberMidColor">#FF1D1B27</Color>
  <Color x:Key="EmberEdgeColor">#FF201B29</Color>
  <Color x:Key="EmberBarDeepColor">#FF2B2937</Color>
  <Color x:Key="EmberBarMidColor">#FF2E2A39</Color>
  <Color x:Key="EmberBarEdgeColor">#FF312C3A</Color>

  <Color x:Key="PlaybackScrimColor">#CC1E1E2E</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001E1E2E</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40CEE1FD</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4094E2D5</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40CBA6F7</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
