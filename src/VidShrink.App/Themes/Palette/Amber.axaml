<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FFFFA500</Color>
  <Color x:Key="NeonPinkColor">#FF00FFAE</Color>
  <Color x:Key="NeonPurpleColor">#FF26FF59</Color>
  <Color x:Key="NeonSuccessColor">#FFD35934</Color>
  <Color x:Key="SurfaceToneColor">#FF141612</Color>
  <Color x:Key="AppBgColor">#FF060705</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF757A71</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF54FFCF</Color>

  <Color x:Key="NeonBlueFillColor">#1AFFA500</Color>
  <Color x:Key="NeonBlueHoverColor">#33FFA500</Color>
  <Color x:Key="NeonBlueActiveColor">#4DFFA500</Color>
  <Color x:Key="NeonBlueBorderColor">#4DFFA500</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80FFA500</Color>
  <Color x:Key="NeonPinkFillColor">#1A00FFAE</Color>
  <Color x:Key="NeonPurpleBorderColor">#8026FF59</Color>

  <Color x:Key="NeonEmberColor">#FF0099FF</Color>
  <Color x:Key="EmberFlameColor">#FF0000FF</Color>
  <Color x:Key="EmberBlazeColor">#FF9900FF</Color>
  <Color x:Key="EmberDeepColor">#FF030706</Color>
  <Color x:Key="EmberMidColor">#FF040807</Color>
  <Color x:Key="EmberEdgeColor">#FF040A0B</Color>
  <Color x:Key="EmberBarDeepColor">#FF0D1213</Color>
  <Color x:Key="EmberBarMidColor">#FF0E1415</Color>
  <Color x:Key="EmberBarEdgeColor">#FF0F1517</Color>

  <Color x:Key="PlaybackScrimColor">#CC060705</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00060705</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40FFA500</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4000FFAE</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #4026FF59</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
