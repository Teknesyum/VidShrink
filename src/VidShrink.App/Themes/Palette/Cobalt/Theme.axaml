<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Cobalt2; kobalt mavisi zemin üstünde sarı ve camgöbeği. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFCDFFFF</Color>
  <Color x:Key="NeonPinkColor">#FFFFC600</Color>
  <Color x:Key="NeonPurpleColor">#FFFB94FF</Color>
  <Color x:Key="NeonSuccessColor">#FF42F800</Color>
  <Color x:Key="SurfaceToneColor">#FF1F4662</Color>
  <Color x:Key="AppBgColor">#FF193549</Color>
  <Color x:Key="TextBodyColor">#FFF6FBFF</Color>
  <Color x:Key="TextDisabledColor">#FF9FBBD4</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFFD954</Color>

  <Color x:Key="NeonBlueFillColor">#1ACDFFFF</Color>
  <Color x:Key="NeonBlueHoverColor">#33CDFFFF</Color>
  <Color x:Key="NeonBlueActiveColor">#4DCDFFFF</Color>
  <Color x:Key="NeonBlueBorderColor">#4DCDFFFE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80CDFFFF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFFC600</Color>
  <Color x:Key="NeonPurpleBorderColor">#80FB94FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF628C</Color>
  <Color x:Key="EmberFlameColor">#FFFF9D00</Color>
  <Color x:Key="EmberBlazeColor">#FFFFEE80</Color>
  <Color x:Key="AtmosHotColor">#FFFFEE81</Color>
  <Color x:Key="AtmosMidColor">#FFFF9D01</Color>
  <Color x:Key="AtmosEdgeColor">#FFFF628D</Color>
  <Color x:Key="EmberDeepColor">#FF172A3A</Color>
  <Color x:Key="EmberMidColor">#FF1A2B3A</Color>
  <Color x:Key="EmberEdgeColor">#FF1C2B3B</Color>
  <Color x:Key="EmberBarDeepColor">#FF1E374D</Color>
  <Color x:Key="EmberBarMidColor">#FF21374E</Color>
  <Color x:Key="EmberBarEdgeColor">#FF25384F</Color>

  <Color x:Key="PlaybackScrimColor">#CC193549</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00193549</Color>
  <Color x:Key="PauseGlossColor">#FFF6FBFE</Color>
  <Color x:Key="PauseGlossFadeColor">#00F6FBFF</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40CDFFFF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FFC600</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40FB94FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
