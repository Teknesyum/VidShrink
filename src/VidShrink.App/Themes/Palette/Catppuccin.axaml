<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Mocha çeşidi; yumuşak pastel vurgular, gözü yormayan düşük doygunluk. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki on bir çekirdek renkten
       üretildi. Değiştirmek için çekirdeği düzenle ve VidShrink.PaletteGen
       aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF89B4FA</Color>
  <Color x:Key="NeonPinkColor">#FF94E2D5</Color>
  <Color x:Key="NeonPurpleColor">#FFCBA6F7</Color>
  <Color x:Key="NeonSuccessColor">#FFA6E3A1</Color>
  <Color x:Key="SurfaceToneColor">#FF313244</Color>
  <Color x:Key="AppBgColor">#FF1E1E2E</Color>
  <Color x:Key="TextBodyColor">#FFCDD6F4</Color>
  <Color x:Key="TextDisabledColor">#FFA6ADC8</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFF</Color>
  <Color x:Key="PinkTextColor">#FFB7ECE3</Color>

  <Color x:Key="NeonBlueFillColor">#1A89B4FA</Color>
  <Color x:Key="NeonBlueHoverColor">#3389B4FA</Color>
  <Color x:Key="NeonBlueActiveColor">#4D89B4FA</Color>
  <Color x:Key="NeonBlueBorderColor">#4D89B4FA</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8089B4FA</Color>
  <Color x:Key="NeonPinkFillColor">#1A94E2D5</Color>
  <Color x:Key="NeonPurpleBorderColor">#80CBA6F7</Color>

  <Color x:Key="NeonEmberColor">#FFF38BA8</Color>
  <Color x:Key="EmberFlameColor">#FFFAB387</Color>
  <Color x:Key="EmberBlazeColor">#FFF9E2AF</Color>
  <Color x:Key="EmberDeepColor">#FF222030</Color>
  <Color x:Key="EmberMidColor">#FF252232</Color>
  <Color x:Key="EmberEdgeColor">#FF292334</Color>
  <Color x:Key="EmberBarDeepColor">#FF373547</Color>
  <Color x:Key="EmberBarMidColor">#FF3B3649</Color>
  <Color x:Key="EmberBarEdgeColor">#FF3F384B</Color>

  <Color x:Key="PlaybackScrimColor">#CC1E1E2E</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001E1E2E</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4089B4FA</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4094E2D5</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40CBA6F7</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
