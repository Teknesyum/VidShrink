<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Hokusai'nin dalgasından; mürekkep mavisi ve soluk Japon boyaları. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFC0CEEB</Color>
  <Color x:Key="NeonPinkColor">#FF7AA89F</Color>
  <Color x:Key="NeonPurpleColor">#FFA28FC1</Color>
  <Color x:Key="NeonSuccessColor">#FFA1C178</Color>
  <Color x:Key="SurfaceToneColor">#FF2A2A37</Color>
  <Color x:Key="AppBgColor">#FF1F1F28</Color>
  <Color x:Key="TextBodyColor">#FFEEECDE</Color>
  <Color x:Key="TextDisabledColor">#FF938AA9</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFA6C5BF</Color>

  <Color x:Key="NeonBlueFillColor">#1AC0CEEB</Color>
  <Color x:Key="NeonBlueHoverColor">#33C0CEEB</Color>
  <Color x:Key="NeonBlueActiveColor">#4DC0CEEB</Color>
  <Color x:Key="NeonBlueBorderColor">#4DC0CEEC</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80C0CEEB</Color>
  <Color x:Key="NeonPinkFillColor">#1A7AA89F</Color>
  <Color x:Key="NeonPurpleBorderColor">#80A28FC1</Color>

  <Color x:Key="NeonEmberColor">#FFC34043</Color>
  <Color x:Key="EmberFlameColor">#FFFFA066</Color>
  <Color x:Key="EmberBlazeColor">#FFE6C384</Color>
  <Color x:Key="AtmosHotColor">#FFE6C385</Color>
  <Color x:Key="AtmosMidColor">#FFFFA067</Color>
  <Color x:Key="AtmosEdgeColor">#FFC34044</Color>
  <Color x:Key="EmberDeepColor">#FF1B1920</Color>
  <Color x:Key="EmberMidColor">#FF1D1920</Color>
  <Color x:Key="EmberEdgeColor">#FF1E1A20</Color>
  <Color x:Key="EmberBarDeepColor">#FF25222B</Color>
  <Color x:Key="EmberBarMidColor">#FF27222C</Color>
  <Color x:Key="EmberBarEdgeColor">#FF29222C</Color>

  <Color x:Key="PlaybackScrimColor">#CC1F1F28</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001F1F28</Color>
  <Color x:Key="PauseGlossColor">#FFEEECDF</Color>
  <Color x:Key="PauseGlossFadeColor">#00EEECDE</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40C0CEEB</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #407AA89F</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40A28FC1</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
