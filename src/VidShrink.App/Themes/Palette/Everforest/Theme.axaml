<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Orman yeşili ve toprak tonları; sıcak, doğal, yorgunluk vermeyen. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF7FBBB3</Color>
  <Color x:Key="NeonPinkColor">#FFDBBC7F</Color>
  <Color x:Key="NeonPurpleColor">#FFD699B6</Color>
  <Color x:Key="NeonSuccessColor">#FFA7C080</Color>
  <Color x:Key="SurfaceToneColor">#FF2E383C</Color>
  <Color x:Key="AppBgColor">#FF272E33</Color>
  <Color x:Key="TextBodyColor">#FFD3C6AA</Color>
  <Color x:Key="TextDisabledColor">#FF9DA9A0</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFE7D2A9</Color>

  <Color x:Key="NeonBlueFillColor">#1A7FBBB3</Color>
  <Color x:Key="NeonBlueHoverColor">#337FBBB3</Color>
  <Color x:Key="NeonBlueActiveColor">#4D7FBBB3</Color>
  <Color x:Key="NeonBlueBorderColor">#4D7FBBB4</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#807FBBB3</Color>
  <Color x:Key="NeonPinkFillColor">#1ADBBC7F</Color>
  <Color x:Key="NeonPurpleBorderColor">#80D699B6</Color>

  <Color x:Key="NeonEmberColor">#FFE67E80</Color>
  <Color x:Key="EmberFlameColor">#FFE69875</Color>
  <Color x:Key="EmberBlazeColor">#FFDBBC80</Color>
  <Color x:Key="AtmosHotColor">#FFDBBC81</Color>
  <Color x:Key="AtmosMidColor">#FFE69876</Color>
  <Color x:Key="AtmosEdgeColor">#FFE67E81</Color>
  <Color x:Key="EmberDeepColor">#FF222529</Color>
  <Color x:Key="EmberMidColor">#FF24262A</Color>
  <Color x:Key="EmberEdgeColor">#FF26272B</Color>
  <Color x:Key="EmberBarDeepColor">#FF292D30</Color>
  <Color x:Key="EmberBarMidColor">#FF2B2F31</Color>
  <Color x:Key="EmberBarEdgeColor">#FF2E3033</Color>

  <Color x:Key="PlaybackScrimColor">#CC272E33</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00272E33</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #407FBBB3</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40DBBC7F</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40D699B6</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
