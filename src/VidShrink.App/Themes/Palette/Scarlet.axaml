<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FFFF0C00</Color>
  <Color x:Key="NeonPinkColor">#FF00FF15</Color>
  <Color x:Key="NeonPurpleColor">#FF75FF26</Color>
  <Color x:Key="NeonSuccessColor">#FFD3346E</Color>
  <Color x:Key="SurfaceToneColor">#FF161612</Color>
  <Color x:Key="AppBgColor">#FF070705</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF7A7A71</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF54FF68</Color>

  <Color x:Key="NeonBlueFillColor">#1AFF0C00</Color>
  <Color x:Key="NeonBlueHoverColor">#33FF0C00</Color>
  <Color x:Key="NeonBlueActiveColor">#4DFF0C00</Color>
  <Color x:Key="NeonBlueBorderColor">#4DFF0C00</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80FF0C00</Color>
  <Color x:Key="NeonPinkFillColor">#1A00FF15</Color>
  <Color x:Key="NeonPurpleBorderColor">#8075FF26</Color>

  <Color x:Key="NeonEmberColor">#FF00FFCC</Color>
  <Color x:Key="EmberFlameColor">#FF0099FF</Color>
  <Color x:Key="EmberBlazeColor">#FF0000FF</Color>
  <Color x:Key="EmberDeepColor">#FF030704</Color>
  <Color x:Key="EmberMidColor">#FF040805</Color>
  <Color x:Key="EmberEdgeColor">#FF040B08</Color>
  <Color x:Key="EmberBarDeepColor">#FF0D1310</Color>
  <Color x:Key="EmberBarMidColor">#FF0E1512</Color>
  <Color x:Key="EmberBarEdgeColor">#FF0F1714</Color>

  <Color x:Key="PlaybackScrimColor">#CC070705</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00070705</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40FF0C00</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4000FF15</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #4075FF26</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
