<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- GitHub'ın koyu arayüzü; nötr, kurumsal, herkesin alışık olduğu renkler. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF58A6FF</Color>
  <Color x:Key="NeonPinkColor">#FF3FB950</Color>
  <Color x:Key="NeonPurpleColor">#FFD2A8FF</Color>
  <Color x:Key="NeonSuccessColor">#FF56D364</Color>
  <Color x:Key="SurfaceToneColor">#FF161B22</Color>
  <Color x:Key="AppBgColor">#FF0D1117</Color>
  <Color x:Key="TextBodyColor">#FFE6EDF3</Color>
  <Color x:Key="TextDisabledColor">#FF8B949E</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF7ED08A</Color>

  <Color x:Key="NeonBlueFillColor">#1A58A6FF</Color>
  <Color x:Key="NeonBlueHoverColor">#3358A6FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D58A6FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D58A6FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8058A6FF</Color>
  <Color x:Key="NeonPinkFillColor">#1A3FB950</Color>
  <Color x:Key="NeonPurpleBorderColor">#80D2A8FF</Color>

  <Color x:Key="NeonEmberColor">#FFF85149</Color>
  <Color x:Key="EmberFlameColor">#FFF0883E</Color>
  <Color x:Key="EmberBlazeColor">#FFE3B341</Color>
  <Color x:Key="AtmosHotColor">#FFE3B342</Color>
  <Color x:Key="AtmosMidColor">#FFF0883F</Color>
  <Color x:Key="AtmosEdgeColor">#FFF8514A</Color>
  <Color x:Key="EmberDeepColor">#FF0E0E13</Color>
  <Color x:Key="EmberMidColor">#FF100F14</Color>
  <Color x:Key="EmberEdgeColor">#FF141014</Color>
  <Color x:Key="EmberBarDeepColor">#FF17171B</Color>
  <Color x:Key="EmberBarMidColor">#FF1A171C</Color>
  <Color x:Key="EmberBarEdgeColor">#FF1E181D</Color>

  <Color x:Key="PlaybackScrimColor">#CC0D1117</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#000D1117</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4058A6FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #403FB950</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40D2A8FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
