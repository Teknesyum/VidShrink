<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Buz mavisi ve pastel kutup ışığı tonlarıyla sakin, soğuk bir şema. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki on bir çekirdek renkten
       üretildi. Değiştirmek için çekirdeği düzenle ve VidShrink.PaletteGen
       aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF88C0D0</Color>
  <Color x:Key="NeonPinkColor">#FFEBCB8B</Color>
  <Color x:Key="NeonPurpleColor">#FFB48EAD</Color>
  <Color x:Key="NeonSuccessColor">#FFA3BE8C</Color>
  <Color x:Key="SurfaceToneColor">#FF2E3440</Color>
  <Color x:Key="AppBgColor">#FF242933</Color>
  <Color x:Key="TextBodyColor">#FFECEFF4</Color>
  <Color x:Key="TextDisabledColor">#FF9AA3B5</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFF2DCB1</Color>

  <Color x:Key="NeonBlueFillColor">#1A88C0D0</Color>
  <Color x:Key="NeonBlueHoverColor">#3388C0D0</Color>
  <Color x:Key="NeonBlueActiveColor">#4D88C0D0</Color>
  <Color x:Key="NeonBlueBorderColor">#4D88C0D0</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8088C0D0</Color>
  <Color x:Key="NeonPinkFillColor">#1AEBCB8B</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B48EAD</Color>

  <Color x:Key="NeonEmberColor">#FFBF616A</Color>
  <Color x:Key="EmberFlameColor">#FFD08770</Color>
  <Color x:Key="EmberBlazeColor">#FFEBCB8B</Color>
  <Color x:Key="EmberDeepColor">#FF272A34</Color>
  <Color x:Key="EmberMidColor">#FF292B35</Color>
  <Color x:Key="EmberEdgeColor">#FF2C2C36</Color>
  <Color x:Key="EmberBarDeepColor">#FF323541</Color>
  <Color x:Key="EmberBarMidColor">#FF353642</Color>
  <Color x:Key="EmberBarEdgeColor">#FF383743</Color>

  <Color x:Key="PlaybackScrimColor">#CC242933</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00242933</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4088C0D0</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40EBCB8B</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B48EAD</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
