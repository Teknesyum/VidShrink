<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Buz mavisi ve pastel kutup ışığı tonlarıyla sakin, soğuk bir şema. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFCEE5EB</Color>
  <Color x:Key="NeonPinkColor">#FFEBCB8B</Color>
  <Color x:Key="NeonPurpleColor">#FFB48EAD</Color>
  <Color x:Key="NeonSuccessColor">#FFBACFAA</Color>
  <Color x:Key="SurfaceToneColor">#FF2E3440</Color>
  <Color x:Key="AppBgColor">#FF242933</Color>
  <Color x:Key="TextBodyColor">#FFF3F5F8</Color>
  <Color x:Key="TextDisabledColor">#FF9AA3B5</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFF2DCB1</Color>

  <Color x:Key="NeonBlueFillColor">#1ACEE5EB</Color>
  <Color x:Key="NeonBlueHoverColor">#33CEE5EB</Color>
  <Color x:Key="NeonBlueActiveColor">#4DCEE5EB</Color>
  <Color x:Key="NeonBlueBorderColor">#4DCEE5EC</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80CEE5EB</Color>
  <Color x:Key="NeonPinkFillColor">#1AEBCB8B</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B48EAD</Color>

  <Color x:Key="NeonEmberColor">#FFBF616A</Color>
  <Color x:Key="EmberFlameColor">#FFD08770</Color>
  <Color x:Key="EmberBlazeColor">#FFEBCB8C</Color>
  <Color x:Key="AtmosHotColor">#FFEBCB8D</Color>
  <Color x:Key="AtmosMidColor">#FFD08771</Color>
  <Color x:Key="AtmosEdgeColor">#FFBF616B</Color>
  <Color x:Key="EmberDeepColor">#FF1E2129</Color>
  <Color x:Key="EmberMidColor">#FF202229</Color>
  <Color x:Key="EmberEdgeColor">#FF22222A</Color>
  <Color x:Key="EmberBarDeepColor">#FF272933</Color>
  <Color x:Key="EmberBarMidColor">#FF292A33</Color>
  <Color x:Key="EmberBarEdgeColor">#FF2C2B34</Color>
  <Color x:Key="EmberFlameGlyphColor">#FFEBCB8E</Color>

  <Color x:Key="PlaybackScrimColor">#CC242933</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00242933</Color>
  <Color x:Key="PauseGlossColor">#FFF3F5F9</Color>
  <Color x:Key="PauseGlossFadeColor">#00F3F5F8</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40CEE5EB</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40EBCB8B</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B48EAD</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
