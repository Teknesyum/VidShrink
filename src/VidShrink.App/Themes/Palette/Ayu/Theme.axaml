<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Simsiyaha yakın zemin, turuncu-mavi kontrastıyla modern ve keskin. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF59C2FF</Color>
  <Color x:Key="NeonPinkColor">#FF95E6CB</Color>
  <Color x:Key="NeonPurpleColor">#FFD2A6FF</Color>
  <Color x:Key="NeonSuccessColor">#FFAAD94C</Color>
  <Color x:Key="SurfaceToneColor">#FF131721</Color>
  <Color x:Key="AppBgColor">#FF0B0E14</Color>
  <Color x:Key="TextBodyColor">#FFE4E3E0</Color>
  <Color x:Key="TextDisabledColor">#FF8A9199</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFB8EEDC</Color>

  <Color x:Key="NeonBlueFillColor">#1A59C2FF</Color>
  <Color x:Key="NeonBlueHoverColor">#3359C2FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D59C2FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D59C2FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8059C2FF</Color>
  <Color x:Key="NeonPinkFillColor">#1A95E6CB</Color>
  <Color x:Key="NeonPurpleBorderColor">#80D2A6FF</Color>

  <Color x:Key="NeonEmberColor">#FFF07178</Color>
  <Color x:Key="EmberFlameColor">#FFFF8F40</Color>
  <Color x:Key="EmberBlazeColor">#FFE6B450</Color>
  <Color x:Key="AtmosHotColor">#FFE6B451</Color>
  <Color x:Key="AtmosMidColor">#FFFF8F41</Color>
  <Color x:Key="AtmosEdgeColor">#FFF07179</Color>
  <Color x:Key="EmberDeepColor">#FF0C0C11</Color>
  <Color x:Key="EmberMidColor">#FF0F0D13</Color>
  <Color x:Key="EmberEdgeColor">#FF110F14</Color>
  <Color x:Key="EmberBarDeepColor">#FF14141C</Color>
  <Color x:Key="EmberBarMidColor">#FF17161D</Color>
  <Color x:Key="EmberBarEdgeColor">#FF1B171E</Color>

  <Color x:Key="PlaybackScrimColor">#CC0B0E14</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#000B0E14</Color>
  <Color x:Key="PauseGlossColor">#FFE4E3E1</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4059C2FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4095E6CB</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40D2A6FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
