<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gece Tokyo'su: lacivert zemin üstünde mavi-mor neon. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFB6CCFB</Color>
  <Color x:Key="NeonPinkColor">#FF73DACA</Color>
  <Color x:Key="NeonPurpleColor">#FFBB9AF7</Color>
  <Color x:Key="NeonSuccessColor">#FF9ECE6A</Color>
  <Color x:Key="SurfaceToneColor">#FF24283B</Color>
  <Color x:Key="AppBgColor">#FF1A1B26</Color>
  <Color x:Key="TextBodyColor">#FFEAEDFC</Color>
  <Color x:Key="TextDisabledColor">#FF9AA5CE</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFA1E6DB</Color>

  <Color x:Key="NeonBlueFillColor">#1AB6CCFB</Color>
  <Color x:Key="NeonBlueHoverColor">#33B6CCFB</Color>
  <Color x:Key="NeonBlueActiveColor">#4DB6CCFB</Color>
  <Color x:Key="NeonBlueBorderColor">#4DB6CCFC</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80B6CCFB</Color>
  <Color x:Key="NeonPinkFillColor">#1A73DACA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80BB9AF7</Color>

  <Color x:Key="NeonEmberColor">#FFF7768E</Color>
  <Color x:Key="EmberFlameColor">#FFFF9E64</Color>
  <Color x:Key="EmberBlazeColor">#FFE0AF68</Color>
  <Color x:Key="AtmosHotColor">#FFE0AF69</Color>
  <Color x:Key="AtmosMidColor">#FFFF9E65</Color>
  <Color x:Key="AtmosEdgeColor">#FFF7768F</Color>
  <Color x:Key="EmberDeepColor">#FF17171F</Color>
  <Color x:Key="EmberMidColor">#FF1B1721</Color>
  <Color x:Key="EmberEdgeColor">#FF1D1922</Color>
  <Color x:Key="EmberBarDeepColor">#FF212130</Color>
  <Color x:Key="EmberBarMidColor">#FF252231</Color>
  <Color x:Key="EmberBarEdgeColor">#FF282333</Color>

  <Color x:Key="PlaybackScrimColor">#CC1A1B26</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#001A1B26</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40B6CCFB</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4073DACA</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40BB9AF7</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
