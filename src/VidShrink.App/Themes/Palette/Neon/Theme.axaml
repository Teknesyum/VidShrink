<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Programın kendi şeması: is siyahı üzerinde yeşil atmosfer, camgöbeğinden mora giden neon. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF00F3FF</Color>
  <Color x:Key="NeonPinkColor">#FFFF00EA</Color>
  <Color x:Key="NeonPurpleColor">#FFB026FF</Color>
  <Color x:Key="NeonSuccessColor">#FF34D399</Color>
  <Color x:Key="SurfaceToneColor">#FF121216</Color>
  <Color x:Key="AppBgColor">#FF050507</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF71717A</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFF54F1</Color>

  <Color x:Key="NeonBlueFillColor">#1A00F3FF</Color>
  <Color x:Key="NeonBlueHoverColor">#3300F3FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D00F3FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D00F3FE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8000F3FF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF00EA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B026FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF0033</Color>
  <Color x:Key="EmberFlameColor">#FFFF6600</Color>
  <Color x:Key="EmberBlazeColor">#FFFFFF00</Color>
  <Color x:Key="AtmosHotColor">#FF7BE2BD</Color>
  <Color x:Key="AtmosMidColor">#FF34D39A</Color>
  <Color x:Key="AtmosEdgeColor">#FF21815F</Color>
  <Color x:Key="EmberDeepColor">#FF020505</Color>
  <Color x:Key="EmberMidColor">#FF020605</Color>
  <Color x:Key="EmberEdgeColor">#FF020706</Color>
  <Color x:Key="EmberBarDeepColor">#FF091010</Color>
  <Color x:Key="EmberBarMidColor">#FF081110</Color>
  <Color x:Key="EmberBarEdgeColor">#FF081310</Color>

  <Color x:Key="PlaybackScrimColor">#CC050507</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00050507</Color>
  <Color x:Key="PauseGlossColor">#FFFFFFFE</Color>
  <Color x:Key="PauseGlossFadeColor">#00FFFFFF</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #4000F3FF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FF00EA</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B026FF</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
