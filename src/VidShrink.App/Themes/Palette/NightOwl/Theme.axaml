<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Gece laciverti; renk körlüğü gözetilerek seçilmiş vurgular. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFB7CEFF</Color>
  <Color x:Key="NeonPinkColor">#FF7FDBCA</Color>
  <Color x:Key="NeonPurpleColor">#FFC792EA</Color>
  <Color x:Key="NeonSuccessColor">#FFADDB67</Color>
  <Color x:Key="SurfaceToneColor">#FF0B2942</Color>
  <Color x:Key="AppBgColor">#FF011627</Color>
  <Color x:Key="TextBodyColor">#FFECF0F6</Color>
  <Color x:Key="TextDisabledColor">#FF7E9898</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFA9E7DB</Color>

  <Color x:Key="NeonBlueFillColor">#1AB7CEFF</Color>
  <Color x:Key="NeonBlueHoverColor">#33B7CEFF</Color>
  <Color x:Key="NeonBlueActiveColor">#4DB7CEFF</Color>
  <Color x:Key="NeonBlueBorderColor">#4DB7CEFE</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80B7CEFF</Color>
  <Color x:Key="NeonPinkFillColor">#1A7FDBCA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80C792EA</Color>

  <Color x:Key="NeonEmberColor">#FFEF5350</Color>
  <Color x:Key="EmberFlameColor">#FFF78C6C</Color>
  <Color x:Key="EmberBlazeColor">#FFECC48D</Color>
  <Color x:Key="AtmosHotColor">#FFECC48E</Color>
  <Color x:Key="AtmosMidColor">#FFF78C6D</Color>
  <Color x:Key="AtmosEdgeColor">#FFEF5351</Color>
  <Color x:Key="EmberDeepColor">#FF05121F</Color>
  <Color x:Key="EmberMidColor">#FF07131F</Color>
  <Color x:Key="EmberEdgeColor">#FF0A1420</Color>
  <Color x:Key="EmberBarDeepColor">#FF0E2133</Color>
  <Color x:Key="EmberBarMidColor">#FF112234</Color>
  <Color x:Key="EmberBarEdgeColor">#FF152234</Color>
  <Color x:Key="EmberFlameGlyphColor">#FFECC48F</Color>

  <Color x:Key="PlaybackScrimColor">#CC011627</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00011627</Color>
  <Color x:Key="PauseGlossColor">#FFECF0F7</Color>
  <Color x:Key="PauseGlossFadeColor">#00ECF0F6</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40B7CEFF</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #407FDBCA</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40C792EA</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
