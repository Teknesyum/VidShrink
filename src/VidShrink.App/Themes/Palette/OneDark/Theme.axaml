<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Atom'un mirası; dengeli, ölçülü, en yaygın kullanılan koyu şema. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFBCDDF8</Color>
  <Color x:Key="NeonPinkColor">#FF98C379</Color>
  <Color x:Key="NeonPurpleColor">#FFC679DD</Color>
  <Color x:Key="NeonSuccessColor">#FFACCF93</Color>
  <Color x:Key="SurfaceToneColor">#FF2C313A</Color>
  <Color x:Key="AppBgColor">#FF282C34</Color>
  <Color x:Key="TextBodyColor">#FFF9FAFB</Color>
  <Color x:Key="TextDisabledColor">#FFABB2BF</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFBAD7A5</Color>

  <Color x:Key="NeonBlueFillColor">#1ABCDDF8</Color>
  <Color x:Key="NeonBlueHoverColor">#33BCDDF8</Color>
  <Color x:Key="NeonBlueActiveColor">#4DBCDDF8</Color>
  <Color x:Key="NeonBlueBorderColor">#4DBCDDF9</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80BCDDF8</Color>
  <Color x:Key="NeonPinkFillColor">#1A98C379</Color>
  <Color x:Key="NeonPurpleBorderColor">#80C679DD</Color>

  <Color x:Key="NeonEmberColor">#FFBE5046</Color>
  <Color x:Key="EmberFlameColor">#FFD19A66</Color>
  <Color x:Key="EmberBlazeColor">#FFE5C07B</Color>
  <Color x:Key="AtmosHotColor">#FFE5C07C</Color>
  <Color x:Key="AtmosMidColor">#FFD19A67</Color>
  <Color x:Key="AtmosEdgeColor">#FFBE5047</Color>
  <Color x:Key="EmberDeepColor">#FF222329</Color>
  <Color x:Key="EmberMidColor">#FF232329</Color>
  <Color x:Key="EmberEdgeColor">#FF252429</Color>
  <Color x:Key="EmberBarDeepColor">#FF25272D</Color>
  <Color x:Key="EmberBarMidColor">#FF28282E</Color>
  <Color x:Key="EmberBarEdgeColor">#FF2A282E</Color>

  <Color x:Key="PlaybackScrimColor">#CC282C34</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00282C34</Color>
  <Color x:Key="PauseGlossColor">#FFF9FAFC</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40BCDDF8</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4098C379</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40C679DD</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
