<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FFFF0040</Color>
  <Color x:Key="NeonPinkColor">#FF37FF00</Color>
  <Color x:Key="NeonPurpleColor">#FFB6FF26</Color>
  <Color x:Key="NeonSuccessColor">#FFD3349E</Color>
  <Color x:Key="SurfaceToneColor">#FF161512</Color>
  <Color x:Key="AppBgColor">#FF070605</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF7A7771</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FF73FF54</Color>

  <Color x:Key="NeonBlueFillColor">#1AFF0040</Color>
  <Color x:Key="NeonBlueHoverColor">#33FF0040</Color>
  <Color x:Key="NeonBlueActiveColor">#4DFF0040</Color>
  <Color x:Key="NeonBlueBorderColor">#4DFF0040</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80FF0040</Color>
  <Color x:Key="NeonPinkFillColor">#1A37FF00</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B6FF26</Color>

  <Color x:Key="NeonEmberColor">#FF00FF80</Color>
  <Color x:Key="EmberFlameColor">#FF00E5FF</Color>
  <Color x:Key="EmberBlazeColor">#FF004CFF</Color>
  <Color x:Key="EmberDeepColor">#FF030703</Color>
  <Color x:Key="EmberMidColor">#FF040804</Color>
  <Color x:Key="EmberEdgeColor">#FF040B06</Color>
  <Color x:Key="EmberBarDeepColor">#FF0D130E</Color>
  <Color x:Key="EmberBarMidColor">#FF0E1510</Color>
  <Color x:Key="EmberBarEdgeColor">#FF0F1712</Color>

  <Color x:Key="PlaybackScrimColor">#CC070605</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00070605</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40FF0040</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #4037FF00</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40B6FF26</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

</ResourceDictionary>
