<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- GitHub Primer Light ve Fluent 2 Light'ın saf beyaz zemini. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FF123A9E</Color>
  <Color x:Key="NeonPinkColor">#FFC026D3</Color>
  <Color x:Key="NeonPurpleColor">#FF7C3AED</Color>
  <Color x:Key="NeonSuccessColor">#FF14532D</Color>
  <Color x:Key="SurfaceToneColor">#FFFFFFFF</Color>
  <Color x:Key="AppBgColor">#FFF3F6FB</Color>
  <Color x:Key="TextBodyColor">#FF14181F</Color>
  <Color x:Key="TextDisabledColor">#FF6B7280</Color>
  <Color x:Key="OnNeonColor">#FFFFFFFE</Color>
  <Color x:Key="PinkTextColor">#FF7A1685</Color>

  <Color x:Key="NeonBlueFillColor">#1A123A9E</Color>
  <Color x:Key="NeonBlueHoverColor">#33123A9E</Color>
  <Color x:Key="NeonBlueActiveColor">#4D123A9E</Color>
  <Color x:Key="NeonBlueBorderColor">#4D123A9F</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80123A9E</Color>
  <Color x:Key="NeonPinkFillColor">#1AC026D3</Color>
  <Color x:Key="NeonPurpleBorderColor">#807C3AED</Color>

  <Color x:Key="NeonEmberColor">#FFC026D4</Color>
  <Color x:Key="EmberFlameColor">#FF92306C</Color>
  <Color x:Key="EmberBlazeColor">#FF633B05</Color>
  <Color x:Key="AtmosHotColor">#FF633B06</Color>
  <Color x:Key="AtmosMidColor">#FF92306D</Color>
  <Color x:Key="AtmosEdgeColor">#FFC026D5</Color>
  <Color x:Key="EmberDeepColor">#FFF5F5FB</Color>
  <Color x:Key="EmberMidColor">#FFF4F3FB</Color>
  <Color x:Key="EmberEdgeColor">#FFF3F0FA</Color>
  <Color x:Key="EmberBarDeepColor">#FFFDFAFE</Color>
  <Color x:Key="EmberBarMidColor">#FFFDF6FD</Color>
  <Color x:Key="EmberBarEdgeColor">#FFFCF3FD</Color>

  <Color x:Key="PlaybackScrimColor">#CCF3F6FB</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00F3F6FB</Color>
  <Color x:Key="PauseGlossColor">#FFF3F6FC</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40123A9E</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40C026D3</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #407C3AED</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
