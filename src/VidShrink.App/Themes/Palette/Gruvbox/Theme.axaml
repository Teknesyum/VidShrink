<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Retro, toprak tonlu ve sıcak; sarı-turuncu ateş rolleri doğal oturur. -->
  <!-- Elle yazılmadı: Themes/Palette/seeds.json içindeki standart rollerden
       (renk-1 … warning) üretildi. Değiştirmek için tohumu düzenle ve
       VidShrink.PaletteGen aracını çalıştır; komut docs/tema.md içinde. -->

  <Color x:Key="NeonBlueColor">#FFDBE6E1</Color>
  <Color x:Key="NeonPinkColor">#FFFABD2F</Color>
  <Color x:Key="NeonPurpleColor">#FFD3869B</Color>
  <Color x:Key="NeonSuccessColor">#FFD3D644</Color>
  <Color x:Key="SurfaceToneColor">#FF3C3836</Color>
  <Color x:Key="AppBgColor">#FF282828</Color>
  <Color x:Key="TextBodyColor">#FFFEFEFC</Color>
  <Color x:Key="TextDisabledColor">#FFA89984</Color>
  <Color x:Key="OnNeonColor">#FF000000</Color>
  <Color x:Key="PinkTextColor">#FFFCD374</Color>

  <Color x:Key="NeonBlueFillColor">#1ADBE6E1</Color>
  <Color x:Key="NeonBlueHoverColor">#33DBE6E1</Color>
  <Color x:Key="NeonBlueActiveColor">#4DDBE6E1</Color>
  <Color x:Key="NeonBlueBorderColor">#4DDBE6E2</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#80DBE6E1</Color>
  <Color x:Key="NeonPinkFillColor">#1AFABD2F</Color>
  <Color x:Key="NeonPurpleBorderColor">#80D3869B</Color>

  <Color x:Key="NeonEmberColor">#FFD95D58</Color>
  <Color x:Key="EmberFlameColor">#FFFE8019</Color>
  <Color x:Key="EmberBlazeColor">#FFFBC64B</Color>
  <Color x:Key="AtmosHotColor">#FFFBC64C</Color>
  <Color x:Key="AtmosMidColor">#FFFE801A</Color>
  <Color x:Key="AtmosEdgeColor">#FFD95D59</Color>
  <Color x:Key="EmberDeepColor">#FF222020</Color>
  <Color x:Key="EmberMidColor">#FF242121</Color>
  <Color x:Key="EmberEdgeColor">#FF262221</Color>
  <Color x:Key="EmberBarDeepColor">#FF332C2B</Color>
  <Color x:Key="EmberBarMidColor">#FF352D2C</Color>
  <Color x:Key="EmberBarEdgeColor">#FF372E2C</Color>
  <Color x:Key="EmberFlameGlyphColor">#FFFBC64D</Color>

  <Color x:Key="PlaybackScrimColor">#CC282828</Color>
  <Color x:Key="PlaybackScrimEdgeColor">#00282828</Color>
  <Color x:Key="PlaybackTitleScrimColor">#E6282828</Color>
  <Color x:Key="PauseGlossColor">#FFFEFEFD</Color>
  <Color x:Key="PauseGlossFadeColor">#00FEFEFC</Color>

  <BoxShadows x:Key="GlowBlue">0 0 20 0 #40DBE6E1</BoxShadows>
  <BoxShadows x:Key="GlowPink">0 0 20 0 #40FABD2F</BoxShadows>
  <BoxShadows x:Key="GlowPurple">0 0 20 0 #40D3869B</BoxShadows>
  <BoxShadows x:Key="GlowNone">0 0 0 0 #00000000</BoxShadows>

  <!-- Standardın rol adları. Themes/Theme.axaml fırçaları bu adlara bağlanır;
       değer yukarıdaki tek anahtardan gelir, ikinci bir renk yazılmaz. -->
  <StaticResource x:Key="Renk1Color" ResourceKey="NeonBlueColor"/>
  <StaticResource x:Key="Renk2Color" ResourceKey="NeonPinkColor"/>
  <StaticResource x:Key="Renk3Color" ResourceKey="NeonPurpleColor"/>
  <StaticResource x:Key="Renk2TextColor" ResourceKey="PinkTextColor"/>
  <StaticResource x:Key="SuccessColor" ResourceKey="NeonSuccessColor"/>
  <StaticResource x:Key="SurfaceColor" ResourceKey="SurfaceToneColor"/>
  <StaticResource x:Key="DisabledColor" ResourceKey="TextDisabledColor"/>
  <StaticResource x:Key="OnRenk1Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk2Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="OnRenk3Color" ResourceKey="OnNeonColor"/>
  <StaticResource x:Key="Renk1x10Color" ResourceKey="NeonBlueFillColor"/>
  <StaticResource x:Key="Renk1x20Color" ResourceKey="NeonBlueHoverColor"/>
  <StaticResource x:Key="Renk1x30Color" ResourceKey="NeonBlueActiveColor"/>
  <StaticResource x:Key="Renk2x10Color" ResourceKey="NeonPinkFillColor"/>
  <StaticResource x:Key="Renk3x50Color" ResourceKey="NeonPurpleBorderColor"/>
  <StaticResource x:Key="BorderDefaultColor" ResourceKey="NeonBlueBorderColor"/>
  <StaticResource x:Key="BorderStrongColor" ResourceKey="NeonBlueBorderStrongColor"/>
  <StaticResource x:Key="DangerColor" ResourceKey="NeonEmberColor"/>
  <StaticResource x:Key="WarningColor" ResourceKey="EmberBlazeColor"/>

</ResourceDictionary>
