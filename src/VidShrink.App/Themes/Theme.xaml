<!-- Teknesyum Neon — WPF. App.xaml > Application.Resources > MergedDictionaries içine ekle. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="NeonBlueColor">#FF00F3FF</Color>
  <Color x:Key="NeonPinkColor">#FFFF00EA</Color>
  <Color x:Key="NeonPurpleColor">#FFB026FF</Color>
  <Color x:Key="SurfaceToneColor">#FF121216</Color>

  <SolidColorBrush x:Key="NeonBlue"    Color="#FF00F3FF"/>
  <SolidColorBrush x:Key="NeonPink"    Color="#FFFF00EA"/>
  <SolidColorBrush x:Key="NeonPurple"  Color="#FFB026FF"/>
  <SolidColorBrush x:Key="NeonSuccess" Color="#FF34D399"/>
  <SolidColorBrush x:Key="Surface"     Color="{StaticResource SurfaceToneColor}"/>
  <SolidColorBrush x:Key="AppBg"       Color="#FF050507"/>
  <LinearGradientBrush x:Key="TitleBarBackground" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#FF101318" Offset="0"/>
    <GradientStop Color="{StaticResource SurfaceToneColor}" Offset="0.5"/>
    <GradientStop Color="#FF171018" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="TextBody"  Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="TextDim"   Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="TextLabel" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="TextHint"  Color="#FFFFFFFF"/>

  <FontFamily x:Key="FontSans">./Fonts/#Atkinson Hyperlegible Next</FontFamily>
  <FontFamily x:Key="FontMono">Consolas, Cascadia Mono</FontFamily>

  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
  </Style>

  <Style x:Key="H3" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
  </Style>

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <Style x:Key="MonoValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </Style>

  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="#3300F3FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="24"/>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
    <Setter Property="Foreground" Value="Black"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="Padding" Value="20,14"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="{StaticResource NeonBlueColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NeonTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="NeonTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/><Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="22,10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#1400F3FF" BorderBrush="#3300F3FF" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NeonBlue}"/><Setter Property="Foreground" Value="{StaticResource NeonBlue}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource NeonPink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

</ResourceDictionary>
