<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:izi="using:VidShrink.App">
  <Styles.Resources>
    <ResourceDictionary>
      <!--
        Burada palet ikinci kez birleştirilmez. Eskiden Palette/Neon/Theme.axaml ve Theme.axaml
        bu sözlüğe de merge ediliyordu; sonuç, programın bütün denetim temalarının
        App.axaml'ın bildirdiği paletten değil kendi özel Neon kopyasından boyanmasıydı —
        ayarlardan tema seçmek bu yüzeylere hiç ulaşmıyordu. Belirteçler artık tek yerden,
        Application.Resources üzerinden çözülüyor. Ölçü: PaletteApplyTests.
      -->
      <FocusAdornerTemplate x:Key="DuzenOdakHalkasi">
        <Panel Margin="{StaticResource FocusRingOutset}" UseLayoutRounding="True">
          <Rectangle Margin="{StaticResource FocusRingInnerInset}"
                     RadiusX="{StaticResource FocusRingInnerRadius}" RadiusY="{StaticResource FocusRingInnerRadius}"
                     Stroke="{StaticResource AppBg}" StrokeThickness="{StaticResource FocusRingScalar}"/>
          <Rectangle Margin="{StaticResource FocusRingOuterInset}"
                     RadiusX="{StaticResource FocusRingOuterRadius}" RadiusY="{StaticResource FocusRingOuterRadius}"
                     Stroke="{StaticResource NeonBlue}" StrokeThickness="{StaticResource FocusRingScalar}"/>
        </Panel>
      </FocusAdornerTemplate>

      <ControlTheme x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </ControlTheme>

      <!--
        T29 Tur 2: açıklama metinleri de madde listesi. İpucu balonundan tek farkı balon
        tavanının olmaması; madde aralığı (`SpaceXs`) ve sarma aynı.
      -->
      <ControlTheme x:Key="BulletText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineSpacing" Value="{StaticResource SpaceXs}"/>
      </ControlTheme>

      <ControlTheme x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
      </ControlTheme>

      <!--
        Balonun genişliği içerikten gelir: TextBlock genişliği kendi metnine göre ölçülür,
        yalnızca tavana dayandığında satır böler. Tavan balonun kendi tavanıyla aynı
        belirteçtir (TooltipMaxWidth), böylece iki ayrı sınır birbirini kırpmaz. TipMaxWidth
        açılış paneline ait, ipucuna değil.
      -->
      <ControlTheme x:Key="TipText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="{StaticResource TooltipMaxWidth}"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}"/>
        <!--
          K7: maddeler arasına bir kademe boşluk. Satır aralığı `SpaceXs`, yani ölçek
          tablosunun en küçük adımı. Bu boşluk balonu yükseltir, genişletmez — satır
          genişlikleri ve dolayısıyla `TipOverflowTests` ölçümü değişmez.
        -->
        <Setter Property="LineSpacing" Value="{StaticResource SpaceXs}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
      </ControlTheme>

      <ControlTheme x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="{StaticResource TrackingLg}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
      </ControlTheme>

      <ControlTheme x:Key="AppTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="FontSize" Value="{StaticResource LabelTitleSize}"/>
        <Setter Property="FontWeight" Value="{StaticResource LabelTitleWeight}"/>
        <Setter Property="LetterSpacing" Value="{StaticResource TrackingLg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </ControlTheme>

      <ControlTheme x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="{StaticResource TrackingMd}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="Margin" Value="{StaticResource SectionMargin}"/>
      </ControlTheme>

      <ControlTheme x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="{StaticResource TrackingLabel}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="Margin" Value="{StaticResource LabelMargin}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </ControlTheme>

      <ControlTheme x:Key="DropTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="{StaticResource TrackingMd}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </ControlTheme>

      <ControlTheme x:Key="DropHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </ControlTheme>

      <ControlTheme x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </ControlTheme>

      <ControlTheme x:Key="PlanFactLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="{StaticResource PlanFactMinWidth}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
      </ControlTheme>

      <ControlTheme x:Key="PlanFactValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="TextWrapping" Value="Wrap"/>
      </ControlTheme>

      <ControlTheme x:Key="PlanBullet" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="Margin" Value="{StaticResource PlanBulletMargin}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
      </ControlTheme>

      <ControlTheme x:Key="PlanReasonText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}"/>
      </ControlTheme>

      <!--
        T163/K3: onizleme ile plan paneli arasindaki surukleneblir ayirici. Boy ve renk
        var olan belirteclerden — yeni bir olcu uydurulmadi.
        Arayuz turu (2026-09-28): ayirici satir araliginin yerini aliyor. Tutma alani SpaceMd,
        gorunen cizgi SpaceXs; iki yanindaki SpaceMd araligi kalkti, orta sutun 24 px kisaldi
        ve tam ekranda bildirim seridi acikken Kucult kaydirmasiz sigdi.
      -->
      <ControlTheme x:Key="PlanSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="{StaticResource SpaceMd}"/>
        <Setter Property="Background" Value="{StaticResource NeonBlueBorder}"/>
        <Setter Property="Cursor" Value="SizeNorthSouth"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent">
              <Border Height="{StaticResource SpaceXs}" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="PanelRule" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource BorderThinScalar}"/>
        <Setter Property="Background" Value="{StaticResource NeonBlueBorder}"/>
      </ControlTheme>

      <ControlTheme x:Key="HeroValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
      </ControlTheme>

      <ControlTheme x:Key="ProductTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
      </ControlTheme>

      <ControlTheme x:Key="OutFactLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Margin" Value="0"/>
      </ControlTheme>

      <ControlTheme x:Key="OutFactValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
      </ControlTheme>

      <ControlTheme x:Key="StatusSuccess" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource NeonSuccess}"/>
      </ControlTheme>

      <ControlTheme x:Key="StatusError" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource EmberBlaze}"/>
      </ControlTheme>

      <!--
        Uyari hatadan renkle degil bicimle ayrilir: 27 paletin hicbirinde uyari hue'su yok
        ve elle secmek "renk uydurma" yasagini cignerdi. Karar
        docs/netlestirme/018-uyari-rengi-27-palette-yok.md. Hata kirmizi ve simgesiz,
        uyari govde renginde + ucgen-unlem simgesi + SemiBold.
      -->
      <ControlTheme x:Key="StatusWarning" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
      </ControlTheme>

      <ControlTheme x:Key="SignatureText" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
      </ControlTheme>

      <ControlTheme x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Padding" Value="{StaticResource PanelPadding}"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="{StaticResource MotionBase}" Easing="CubicEaseOut"/>
            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionBase}" Easing="CubicEaseOut"/>
          </Transitions>
        </Setter>
        <Style Selector="^.enter">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="RenderTransform" Value="translateY(10px)"/>
        </Style>
        <Style Selector="^.enter-flat">
          <Setter Property="Opacity" Value="0"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingSm}"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{StaticResource MotionInstant}"/>
                  <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                </Transitions>
              </Border.Transitions>
              <Panel>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  TextWrapping="Wrap"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <Border Name="HoverRing"
                        IsHitTestVisible="False"
                        BorderBrush="Transparent"
                        BorderThickness="{StaticResource BorderStrong}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
          <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#HoverRing">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
          <Setter Property="BoxShadow" Value="{DynamicResource GlowPurple}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="ShortcutKeyButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="{StaticResource NavTabPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style Selector="^.listening /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="PanelHeaderToggle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#HoverRing">
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource OnNeon}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BoxShadow="{DynamicResource GlowBlue}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{StaticResource MotionInstant}"/>
                  <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                  <DoubleTransition Property="Opacity" Duration="{StaticResource MotionInstant}"/>
                </Transitions>
              </Border.Transitions>
              <Panel>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
      </ControlTheme>

      <!-- Readable pink for text. The fill pink measures 4.57:1 on the surface and misses the
           floor; this one measures 7.72:1, so coloured words use it and fills keep NeonPink. -->
      <SolidColorBrush x:Key="PinkText" Color="{StaticResource Renk2TextColor}"/>

      <ControlTheme x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
        <Setter Property="Margin" Value="{StaticResource ChipMargin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
      </ControlTheme>

      <!-- Kullanıcı ön ayarını silen "×". Yonganın içinde durduğu için kendi dolgusu yok;
           ölçüsü yonganınkinden küçük, rengi yonganın yazı rengi. -->
      <ControlTheme x:Key="ChipRemoveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="Padding" Value="{StaticResource ChipRemovePadding}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="Padding" Value="{StaticResource HeaderButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource WindowButtonMargin}"/>
        <Setter Property="Height" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSquare}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style Selector="^:pointerover">
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#HoverRing">
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="LanguageButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Style Selector="^.selected">
          <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="SupportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        <Style Selector="^ /template/ Border#Root">
          <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="TitleBarSupportButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="Foreground" Value="{StaticResource PinkText}"/>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="TitleBarLinkButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Panel>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalContentAlignment="Center"/>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
          <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="^:pressed">
          <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="InfoButton" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Width" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="Height" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="Margin" Value="{StaticResource InfoBadgeMargin}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource InfoBadgeGlyphSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Content" Value="?"/>
        <Setter Property="ToolTip.ShowDelay" Value="120"/>
        <!-- Anchored to the badge, not to the pointer, so the balloon lines up with the ? it
             belongs to. Avalonia flips the popup itself when the button sits near a screen edge. -->
        <Setter Property="ToolTip.Placement" Value="BottomEdgeAlignedLeft"/>
        <Setter Property="ToolTip.HorizontalOffset" Value="0"/>
        <Setter Property="ToolTip.VerticalOffset" Value="0"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Panel Background="Transparent">
              <Border Name="Badge"
                      Width="{StaticResource InfoBadgeSize}"
                      Height="{StaticResource InfoBadgeSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource RadiusChip}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Badge">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPink}"/>
        </Style>
      </ControlTheme>

      <!-- Etiketin yanindaki rozet. Etiket kendi alt boslugunu tasiyor ve satiri asagi
           dogru buyutuyor; rozet o boslugu paylasmazsa satirin ortasina yerlesip etiketin
           uzerinden 4,5 px asagi kayiyor. Olculdu: WindowLayoutTests
           InfoBadgesAlignWithTheirLabelAndTheQuestionMarkFits. Etiket tasimayan satirlarda
           InfoButton kullanilir; ikisi ayni sayiyi tasiyamaz.

           Dugmenin kendisi TargetMinSize degil InfoBadgeSize kadar yer tutuyor: 24 + 8
           satiri etiketin 19 + 8'inin uzerine cikarip sayfayi 6 px kaydiriyordu. Gorunen
           rozet zaten 18; kalan 3 px goruntusuz bir halkaydi. Dokunma hedefi olan
           denetimler TargetMinSize'i kullanmaya devam eder, bu bir vurgu rozeti. -->
      <ControlTheme x:Key="InfoButtonBesideLabel" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Width" Value="{StaticResource InfoBadgeSize}"/>
        <Setter Property="Height" Value="{StaticResource InfoBadgeSize}"/>
        <Setter Property="Margin" Value="{StaticResource InfoBadgeLabelMargin}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource InfoBadgeGlyphSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Content" Value="?"/>
        <Setter Property="ToolTip.ShowDelay" Value="120"/>
        <!-- Anchored to the badge, not to the pointer, so the balloon lines up with the ? it
             belongs to. Avalonia flips the popup itself when the button sits near a screen edge. -->
        <Setter Property="ToolTip.Placement" Value="BottomEdgeAlignedLeft"/>
        <Setter Property="ToolTip.HorizontalOffset" Value="0"/>
        <Setter Property="ToolTip.VerticalOffset" Value="0"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Panel Background="Transparent">
              <Border Name="Badge"
                      Width="{StaticResource InfoBadgeSize}"
                      Height="{StaticResource InfoBadgeSize}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{StaticResource RadiusChip}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Badge">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPink}"/>
        </Style>
      </ControlTheme>

      <!--
        Windows'un kendi pencere düğmeleri gibi: bitişik, köşesiz dikdörtgenler, başlık
        çubuğu boyunca tam yükseklikte. Yükseklik `Height` ile değil `Stretch` ile geliyor,
        böylece kapatma düğmesi çubuğun üst pikseline kadar uzanıyor ve tam ekranda ekranın
        köşesine dayanıyor. Genişlik yine `WindowButtonWidth`; boşluk, kenarlık ve köşe
        yarıçapı sıfır, çünkü bitişiklik ölçü değil boşluğun yokluğudur.
      -->
      <ControlTheme x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Width" Value="{StaticResource WindowButtonWidth}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Button">
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{StaticResource MotionInstant}"/>
                  <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                </Transitions>
              </Border.Transitions>
              <Panel>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"/>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource OnNeon}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource PinkText}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource NeonPinkFill}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="CheckStyle" TargetType="CheckBox">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Margin" Value="{StaticResource CheckMargin}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="CheckBox">
            <Grid MinHeight="{StaticResource TargetMinSize}" Background="Transparent" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource CheckColumnWidth}"/>
                <ColumnDefinition Width="{StaticResource CheckGapWidth}"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Panel Grid.Column="0" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}">
                <Border Name="CheckOutline"
                        Width="{StaticResource CheckGlyphSize}" Height="{StaticResource CheckGlyphSize}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource NeonBlue}"
                        BorderThickness="{StaticResource BorderThin}"
                        CornerRadius="{StaticResource RadiusChip}">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="{StaticResource MotionInstant}"/>
                      <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <Path Name="CheckMark"
                      Width="{StaticResource CheckGlyphSize}" Height="{StaticResource CheckGlyphSize}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 4 10 L 8 14 L 16 5"
                      Stroke="{StaticResource NeonBlue}"
                      StrokeThickness="2.5"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Opacity="0"
                      RenderTransform="scale(0.6)">
                  <Path.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
                      <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                    </Transitions>
                  </Path.Transitions>
                </Path>
              </Panel>
              <ContentPresenter Grid.Column="2"
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#CheckMark">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:checked /template/ Border#CheckOutline">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
          <Setter Property="Background" Value="{StaticResource NeonBlueActive}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#CheckOutline">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPink}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#CheckOutline">
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="^:disabled /template/ Path#CheckMark">
          <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="RadioButton">
            <Grid MinHeight="{StaticResource TargetMinSize}" Background="{TemplateBinding Background}" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource CheckColumnWidth}"/>
                <ColumnDefinition Width="{StaticResource CheckGapWidth}"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Panel Grid.Column="0" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}">
                <Ellipse Name="RadioOutline"
                         Width="{StaticResource CheckGlyphSize}" Height="{StaticResource CheckGlyphSize}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource Surface}"
                         Stroke="{StaticResource NeonBlue}"
                         StrokeThickness="{StaticResource BorderThinScalar}">
                  <Ellipse.Transitions>
                    <Transitions>
                      <BrushTransition Property="Fill" Duration="{StaticResource MotionInstant}"/>
                      <BrushTransition Property="Stroke" Duration="{StaticResource MotionInstant}"/>
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>
                <Ellipse Name="RadioDot"
                         Width="{StaticResource RadioDotSize}" Height="{StaticResource RadioDotSize}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource NeonBlue}"
                         Opacity="0"
                         RenderTransform="scale(0.6)">
                  <Ellipse.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
                      <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                    </Transitions>
                  </Ellipse.Transitions>
                </Ellipse>
              </Panel>
              <ContentPresenter Grid.Column="2"
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Ellipse#RadioDot">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#RadioOutline">
          <Setter Property="Stroke" Value="{StaticResource NeonPurple}"/>
          <Setter Property="Fill" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Ellipse#RadioOutline">
          <Setter Property="Stroke" Value="{StaticResource NeonPink}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#RadioOutline">
          <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#RadioDot">
          <Setter Property="Fill" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="NeonTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
          </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="TabControl">
            <!--
              Kesit B: uyari yigini artik icerigi asagi itmiyor. Onceden kendi satirindaydi
              ve her acilisinda oynatici o kadar kisaliyordu; simdi icerikle ayni gozde,
              uste yaslanmis bir katman. "Uyari cikacaksa oynaticinin ustunde ciksin"
              cumlesinin karsiligi bu.
            -->
            <Grid RowDefinitions="Auto,*" ClipToBounds="False">
              <TransitioningContentControl Name="SelectedContentHost"
                                           Margin="{StaticResource WorkspaceMargin}"
                                           Grid.Row="1"
                                           Content="{TemplateBinding SelectedContent}"
                                           ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                           HorizontalContentAlignment="Stretch"
                                           VerticalContentAlignment="Stretch">
                <TransitioningContentControl.PageTransition>
                  <CrossFade Duration="{StaticResource MotionBase}"/>
                </TransitioningContentControl.PageTransition>
              </TransitioningContentControl>
              <ContentPresenter Name="NoticeLayer"
                                Grid.Row="1"
                                VerticalAlignment="Top"
                                Content="{TemplateBinding Tag}"/>
              <Panel Name="TopOverlay"
                     Classes="reveal"
                     Grid.Row="0"
                     Grid.RowSpan="2"
                     VerticalAlignment="Top">
                <Border Name="TopScrim"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        Height="{StaticResource PlaybackTopScrimHeight}"
                        Background="{StaticResource PlaybackTopScrimVeil}"/>
                <ItemsPresenter Name="PART_ItemsPresenter"
                                Height="{StaticResource TitleBarHeight}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                ClipToBounds="False"
                                Margin="{TemplateBinding Padding}"/>
                <ContentPresenter Name="TopOverlayContent"
                                  VerticalAlignment="Top"
                                  Content="{TemplateBinding izi:UstPanel.Icerik}"/>
              </Panel>
              <Border Name="TopRowSpacer"
                      Grid.Row="0"
                      IsHitTestVisible="False"
                      Height="{StaticResource TitleBarHeight}"/>
            </Grid>
          </ControlTemplate>
        </Setter>
        <!--
          Oynatici sekmesi tum alani kapsiyor: calisma kenari yalniz o sekmede sifir.
          Sekme sirasi MainWindow.PlayerTabIndex ile pimli.
        -->
        <Style Selector="^[SelectedIndex=0] /template/ TransitioningContentControl#SelectedContentHost">
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Grid.Row" Value="0"/>
          <Setter Property="Grid.RowSpan" Value="2"/>
        </Style>
        <Style Selector="^[SelectedIndex=0] /template/ Border#TopScrim">
          <Setter Property="IsVisible" Value="True"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="NeonTabItem" TargetType="TabItem">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="{StaticResource NavTabPadding}"/>
        <Setter Property="Margin" Value="{StaticResource TabMargin}"/>
        <Setter Property="Height" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="TabItem">
            <Border Name="TabOutline"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    UseLayoutRounding="True">
              <Panel>
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource SpaceSm}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <Path Name="TabIcon"
                        FlowDirection="LeftToRight"
                        Width="{StaticResource IconSizeSm}"
                        Height="{StaticResource IconSizeSm}"
                        Stretch="Uniform"
                        VerticalAlignment="Center"
                        Data="{TemplateBinding Tag}"
                        Fill="{TemplateBinding Foreground}"/>
                  <ContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                </StackPanel>
                <Border Name="TabIndicator"
                        IsHitTestVisible="False"
                        Height="{StaticResource TabIndicatorHeight}"
                        Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Background="{TemplateBinding Foreground}"
                        Opacity="0"
                        RenderTransform="scaleX(0)"/>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:focus-visible">
          <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#TabIndicator">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:focus-visible /template/ Border#TabIndicator">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#TabIndicator">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#TabIndicator">
          <Setter Property="Opacity" Value="0"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="ComboBoxItem">
            <Border Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="{StaticResource BorderThin}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource RadiusCell}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#ItemBorder">
          <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource OnNeon}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#ItemBorder">
          <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="PlaylistItem" TargetType="ListBoxItem">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="ListBoxItem">
            <Border Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="{StaticResource BorderThin}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{StaticResource RadiusCell}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
        </Style>
        <Style Selector="^:selected /template/ Border#ItemBorder">
          <Setter Property="Background" Value="{DynamicResource NeonBlueFill}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource NeonBlueBorderStrong}"/>
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource OnNeon}"/>
        </Style>
        <Style Selector="^:pointerover /template/ Border#ItemBorder">
          <Setter Property="Background" Value="{DynamicResource NeonBlue}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="MinHeight" Value="{StaticResource FieldMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="MaxDropDownHeight" Value="{StaticResource DropDownMaxHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="ComboBox">
            <Panel>
              <Border Name="Root"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      MinHeight="{TemplateBinding MinHeight}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                  </Transitions>
                </Border.Transitions>
                <Grid ColumnDefinitions="*,20">
                  <ContentControl Name="SelectionBox"
                                  Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding ItemTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>
                  <Path Name="Arrow"
                        Grid.Column="1"
                        Data="M 0 0 L 4 4 L 8 0"
                        Stroke="{StaticResource NeonBlue}"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Popup Name="PART_Popup"
                     IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                     MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                     MaxHeight="{TemplateBinding MaxDropDownHeight}"
                     Placement="BottomEdgeAlignedLeft"
                     IsLightDismissEnabled="True"
                     WindowManagerAddShadowHint="False">
                <Border Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource NeonBlue}"
                        BorderThickness="{StaticResource BorderThin}"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="{StaticResource PopupPadding}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPink}"/>
        </Style>
        <Style Selector="^:dropdownopen /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:dropdownopen /template/ Path#Arrow">
          <Setter Property="RenderTransform" Value="rotate(180deg)"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
        </Style>
        <Style Selector="^:disabled /template/ Path#Arrow">
          <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="MinHeight" Value="{StaticResource FieldMinHeight}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="{StaticResource FieldPadding}"/>
        <Setter Property="CaretBrush" Value="{StaticResource NeonBlue}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NeonBlueActive}"/>
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextBody}"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="TextBox">
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}"/>
                </Transitions>
              </Border.Transitions>
              <Panel>
                <ScrollViewer Name="PART_ScrollViewer"
                              Margin="{TemplateBinding Padding}"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                  <TextPresenter Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 VerticalAlignment="Center"/>
                </ScrollViewer>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
        </Style>
        <Style Selector="^:focus /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
          <Setter Property="Cursor" Value="No"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#Root">
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="SliderFilledTrack" TargetType="RepeatButton">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="RepeatButton">
            <Panel Background="Transparent">
              <Border Name="FilledTrack"
                      Height="{StaticResource SliderTrackHeight}"
                      VerticalAlignment="Center"
                      Background="{StaticResource NeonBlue}"
                      BorderBrush="{StaticResource NeonBlue}"
                      BorderThickness="{StaticResource BorderThin}"
                      CornerRadius="{StaticResource SliderFilledTrackRadius}"/>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled /template/ Border#FilledTrack">
          <Setter Property="Background" Value="{StaticResource TextDisabled}"/>
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="SliderEmptyTrack" TargetType="RepeatButton">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="RepeatButton">
            <Panel Background="Transparent">
              <Border Name="RemainingTrack"
                      Height="{StaticResource SliderTrackHeight}"
                      VerticalAlignment="Center"
                      Background="{StaticResource NeonBlueFill}"
                      BorderBrush="{StaticResource NeonBlueBorder}"
                      BorderThickness="{StaticResource BorderThin}"
                      CornerRadius="{StaticResource SliderEmptyTrackRadius}"/>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^.ustunde /template/ Border#RemainingTrack">
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        </Style>
        <Style Selector="^.odak /template/ Border#RemainingTrack">
          <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        </Style>
        <Style Selector="^:disabled /template/ Border#RemainingTrack">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Thumb">
            <Panel Background="Transparent">
              <Ellipse Name="Knob"
                       Width="{StaticResource SliderThumbSize}"
                       Height="{StaticResource SliderThumbSize}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="{StaticResource AppBg}"
                       Stroke="{StaticResource NeonBlue}"
                       StrokeThickness="{StaticResource SliderThumbStroke}"
                       RenderTransform="none">
                <Ellipse.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>
        <Style Selector="^.ustunde /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>
        <Style Selector="^.odak /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="scale(1.1)"/>
        </Style>
        <Style Selector="^:pressed /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="scale(1.2)"/>
          <Setter Property="Fill" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^.basili /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="scale(1.2)"/>
          <Setter Property="Fill" Value="{StaticResource NeonBlue}"/>
        </Style>
        <Style Selector="^:disabled /template/ Ellipse#Knob">
          <Setter Property="RenderTransform" Value="none"/>
          <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="FocusAdorner" Value="{StaticResource DuzenOdakHalkasi}"/>
        <Setter Property="Height" Value="{StaticResource FieldMinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="izi:KaydiriciHareketi.Etkin" Value="True"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Slider">
            <Border Name="Root" Background="Transparent" Padding="{StaticResource SliderTrackPadding}">
              <Panel>
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       Orientation="{TemplateBinding Orientation}"
                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                  <Track.DecreaseButton>
                    <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderFilledTrack}" Focusable="False"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderEmptyTrack}" Focusable="False"/>
                  </Track.IncreaseButton>
                  <Track.Thumb>
                    <Thumb Name="ThumbVisual"
                           Theme="{StaticResource SliderThumb}"
                           Width="{StaticResource SliderThumbSize}"/>
                  </Track.Thumb>
                </Track>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Cursor" Value="No"/>
        </Style>

      </ControlTheme>

      <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCell}"/>
        <Setter Property="MinHeight" Value="{StaticResource ProgressBarHeight}"/>
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Value" Duration="{StaticResource MotionFast}" Easing="LinearEasing"/>
          </Transitions>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate TargetType="ProgressBar">
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True">
              <Panel Name="PART_LayoutRoot">
                <Border Name="PART_Indicator"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HorizontalAlignment="Left"/>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="Thumb">
            <Border Name="ThumbVisual"
                    Margin="{StaticResource ScrollBarThumbMargin}"
                    Background="{StaticResource NeonBlue}"
                    CornerRadius="{StaticResource RadiusCell}"/>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#ThumbVisual">
          <Setter Property="Background" Value="{StaticResource NeonPink}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#ThumbVisual">
          <Setter Property="Background" Value="{StaticResource NeonPurple}"/>
        </Style>
      </ControlTheme>

      <ControlTemplate x:Key="ScrollBarVerticalTemplate" TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusCell}">
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="Vertical"
                       IsDirectionReversed="True">
                  <Track.DecreaseButton>
                    <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" Focusable="False"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" Focusable="False"/>
                  </Track.IncreaseButton>
                  <Track.Thumb>
                    <Thumb Theme="{StaticResource ScrollBarThumb}"/>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>

      <ControlTemplate x:Key="ScrollBarHorizontalTemplate" TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusCell}">
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="Horizontal">
                  <Track.DecreaseButton>
                    <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" Focusable="False"/>
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" Focusable="False"/>
                  </Track.IncreaseButton>
                  <Track.Thumb>
                    <Thumb Theme="{StaticResource ScrollBarThumb}"/>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>

      <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Style Selector="^:vertical">
          <Setter Property="Width" Value="{StaticResource ScrollBarThickness}"/>
          <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}"/>
        </Style>
        <Style Selector="^:horizontal">
          <Setter Property="Height" Value="{StaticResource ScrollBarThickness}"/>
          <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="Padding" Value="{StaticResource TooltipPadding}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="MaxWidth" Value="{StaticResource TooltipMaxWidth}"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="Wrap"/>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonPurple}"/>
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
        <Setter Property="Padding" Value="{StaticResource TooltipPadding}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}"/>
        <Setter Property="MaxWidth" Value="{StaticResource FlyoutMaxWidth}"/>
        <Setter Property="Template">
          <ControlTemplate TargetType="FlyoutPresenter">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusControl}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                TextWrapping="Wrap"/>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="Surface"/>
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="NeonPurple"/>
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="TextBody"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPressed" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundDisabled" ResourceKey="TextDisabled"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="NeonBlue"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="NeonBlue"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" ResourceKey="TextBody"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" ResourceKey="TextDisabled"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="TextBody"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevronSubMenuOpened" ResourceKey="OnNeon"/>
      <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="TextDisabled"/>

    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector=":is(Window) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Null}"/>
    <Setter Property="BorderBrush" Value="{x:Null}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>

  <!--
    Arayuz turu (2026-09-28): kapali dugmenin "neden kapali" balonu. Avalonia kapali denetimde
    balonu varsayilan gostermiyor; :disabled secicili ToolTip.Tip yazan her dugme bu yuzden sessizdi.
  -->
  <Style Selector="Button:disabled">
    <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
  </Style>

  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
  </Style>

  <Style Selector="Border.playlist">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutPresenterBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource MenuFlyoutPresenterBorderThemeThickness}"/>
    <Setter Property="Padding" Value="{DynamicResource MenuFlyoutPresenterThemePadding}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="{StaticResource ScrollBarThickness}"/>
    <Setter Property="Template" Value="{StaticResource ScrollBarVerticalTemplate}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="{StaticResource ScrollBarThickness}"/>
    <Setter Property="Template" Value="{StaticResource ScrollBarHorizontalTemplate}"/>
  </Style>
</Styles>
