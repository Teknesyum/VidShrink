<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    D3 (028): düzenleyici çizelgesinin ölçüleri. Burada yeni sayı yok; her belirteç
    Theme.axaml ya da Playback.axaml'daki bir belirtecin değerini alır. Renk de yok:
    çizelge palet fırçalarını (NeonBlueFill, NeonPink, NeonPurple...) doğrudan çağırır.

    İz ve cetvel

      EditorVideoTrackHeight     <- DropIconSize (48). İki dokunma ölçüsü üst üste; klip
                                    içinde rozet ve tutamak sığar.
      EditorAudioTrackShare      <- AudioTrackShare (0,2). Oran, piksel değil: ses izinin
                                    yüksekliği EditorVideoTrackHeight × bu pay (48 → 9,6).
                                    Görüntü izi değişirse ses izi onunla birlikte ölçeklenir.
                                    Dalga biçimi kaynağın en yüksek tepesine göre ölçeklenir,
                                    ince izde de tam boy okunur.
      EditorTextTrackHeight      <- TargetMinSize (24). Metin izi (T1), video izinin üstünde;
                                    tek satır etiket ve kenar tutamağı sığar.
      EditorTrackGap             <- SpaceXs (4). İzler arası tek çizgi payı.
      EditorTrackHeaderWidth     <- FieldWidthSm (120). İz adı sütunu.
      EditorRulerHeight          <- TargetMinSize (24). Cetvel tıklanabilir, oynatma
                                    başını taşır.
      EditorRulerMajorTick       <- SpaceSm (8). Büyük çentik.
      EditorRulerMinorTick       <- SpaceXs (4). Küçük çentik.
      EditorRulerLabelMinSpacing <- NumberBoxWidth (96). Mono zaman etiketinin genişliği;
                                    etiket aralığı bunun altına inince 1-2-5-10
                                    merdiveninde bir üst basamağa çıkılır.

    Anahtar kare ve küçük resim şeridi

      EditorKeyframeTick         <- SpaceSm (8). Anahtar kare çentiği; görüntü izinin alt
                                    kenarında, klibin üstüne çizilir.
      EditorKeyframeMinSpacing   <- SpaceXs (4). İki çentik bundan yakınsa sonraki çizilmez.
      EditorThumbnailStripHeight <- PlaybackBarButtonSize (32). Ses izinin altındaki şerit;
                                    kare genişliği kaynağın en/boy oranından çıkar.

    Klip

      EditorClipRadius           <- RadiusChip (4). Şerit parçası, PlaybackTrack'le aynı köşe.
      EditorClipBorder           <- BorderThin (1). Klip çerçevesi.
      EditorClipSelectedBorder   <- FocusRingThickness (2). Seçim kalınlıkla da okunur.
      EditorClipPadding          <- SpaceXs (4). Rozet kenara yapışmaz.
      EditorClipMinWidth         <- TargetMinSize (24). Bunun altındaki klip çizilir ama
                                    rozetsizdir.
      EditorEdgeGripWidth        <- SpaceSm (8). Kenar tutamağı; D3'te yalnız imleç biçimi.

    Oynatma başı ve etkileşim

      EditorPlayheadWidth        <- PlaybackCursorWidth (2). Oynatıcının imleciyle aynı.
      EditorPlayheadHandle       <- SliderThumbSize (20). Cetveldeki tutamaç.
      EditorSnapThresholdPx      <- SpaceSm (8). Piksel tanımlanır, tick saklanır; eşik
                                    tick her zoom değişiminde yeniden hesaplanır.
      EditorDragThresholdPx      <- SpaceXs (4). Altındaki hareket tıklamadır.
      EditorAutoScrollMargin     <- PlaybackThumbnailWidth (128). Sürüklerken kenara bu
                                    kadar yaklaşınca görünüm kayar.

    Yakınlaştırma

      EditorZoomMax              <- TargetMinSize (24). Bir kaynak karesi 24 px olunca durur.
      EditorZoomMin              <- sayı değil kural: çizelgenin tamamı görünüme sığar.
      EditorZoomStep             <- PlaybackHoverZoom (2). Ctrl+tekerlek ×2 / ÷2.
      EditorMotionSelect         <- MotionFast. Seçim ve fare üstü geçişi.
      Kaydırma anında olur, geçişi yok; o yüzden ayrı bir süre belirteci de yok.

    Yerleşim (dalga 2A)

      EditorToolButtonSize       <- PlaybackBarButtonSize (32). Araç paletinin kare
                                    düğmesi; oynatıcı şeridinin düğmesiyle aynı hedef.
      EditorTransportGap         <- SpaceSm (8). Monitör satırındaki düğmelerin arası.
      EditorTimecodeWidth        <- FieldWidthSm (120). Mono zaman kodu kutusu;
                                    "00:00:00:00" ve kutu dolgusu sığar.
      EditorExportModeWidth      <- FieldWidth (280). Dışa aktarma kipi kutusu; en uzun
                                    Türkçe seçenek ("Tam Yeniden Kodlama") ok sütunuyla sığar.
      EditorPreviewMinHeight     <- DropZoneMinHeight (144). Önizlemenin en az yüksekliği;
                                    alt panel bundan fazlasını isterse kaydırılır.

    Kalıplar

      EditorClip klibin gövdesidir: PlaybackTrack'in fırçaları, fare üstünde NeonBlueHover,
      seçilince NeonBlueActive + NeonBlueBorderStrong + GlowBlue ve kalın kenar.
      EditorToolButton araç paletinin ve mıknatısın aç-kapa düğmesidir: GhostButton yüzü,
      seçiliyken NeonBlueFill zemin + NeonBlue kenar (dinlenme kenarı NeonBlueBorderStrong
      olduğundan seçili kenar opak vurguyla ayrılır), yazı TextBody (NeonBlueActive
      zeminde ne NeonBlue ne TextBody yazı 7:1 tutuyor; 36 palette ölçüldü). Araç şeridinin
      paneli opak Surface zeminlidir: PanelSurface'in geçirdiği atmosfer ışıması seçili düğmenin
      zeminini konuma göre açıyordu, Cobalt'ta yazı 7.35'ten 6.96'ya düştü; opakta 7.21 sabit.
      EditorBadgeText hız rozetinin yazısıdır: PlaybackBadgeText kalıbı, TextBody rengiyle
      (perde üstü yazı 7:1 ölçülü). Rozetin kendisi PlaybackBadge kalıbını kullanır.
  -->

  <StaticResource x:Key="EditorVideoTrackHeight" ResourceKey="DropIconSize"/>
  <StaticResource x:Key="EditorAudioTrackShare" ResourceKey="AudioTrackShare"/>
  <StaticResource x:Key="EditorTextTrackHeight" ResourceKey="TargetMinSize"/>
  <StaticResource x:Key="EditorTrackGap" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="EditorTrackHeaderWidth" ResourceKey="FieldWidthSm"/>
  <StaticResource x:Key="EditorRulerHeight" ResourceKey="TargetMinSize"/>
  <StaticResource x:Key="EditorRulerMajorTick" ResourceKey="SpaceSm"/>
  <StaticResource x:Key="EditorRulerMinorTick" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="EditorRulerLabelMinSpacing" ResourceKey="NumberBoxWidth"/>

  <StaticResource x:Key="EditorKeyframeTick" ResourceKey="SpaceSm"/>
  <StaticResource x:Key="EditorKeyframeMinSpacing" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="EditorThumbnailStripHeight" ResourceKey="PlaybackBarButtonSize"/>

  <StaticResource x:Key="EditorClipRadius" ResourceKey="RadiusChip"/>
  <StaticResource x:Key="EditorClipBorder" ResourceKey="BorderThin"/>
  <StaticResource x:Key="EditorClipSelectedBorder" ResourceKey="FocusRingThickness"/>
  <StaticResource x:Key="EditorClipPadding" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="EditorClipMinWidth" ResourceKey="TargetMinSize"/>
  <StaticResource x:Key="EditorEdgeGripWidth" ResourceKey="SpaceSm"/>

  <StaticResource x:Key="EditorPlayheadWidth" ResourceKey="PlaybackCursorWidth"/>
  <StaticResource x:Key="EditorPlayheadHandle" ResourceKey="SliderThumbSize"/>
  <StaticResource x:Key="EditorSnapThresholdPx" ResourceKey="SpaceSm"/>
  <StaticResource x:Key="EditorDragThresholdPx" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="EditorAutoScrollMargin" ResourceKey="PlaybackThumbnailWidth"/>

  <StaticResource x:Key="EditorZoomMax" ResourceKey="TargetMinSize"/>
  <StaticResource x:Key="EditorZoomStep" ResourceKey="PlaybackHoverZoom"/>
  <StaticResource x:Key="EditorMotionSelect" ResourceKey="MotionFast"/>

  <StaticResource x:Key="EditorToolButtonSize" ResourceKey="PlaybackBarButtonSize"/>
  <StaticResource x:Key="EditorTransportGap" ResourceKey="SpaceSm"/>
  <StaticResource x:Key="EditorTimecodeWidth" ResourceKey="FieldWidthSm"/>
  <StaticResource x:Key="EditorExportModeWidth" ResourceKey="FieldWidth"/>
  <StaticResource x:Key="EditorPreviewMinHeight" ResourceKey="DropZoneMinHeight"/>

  <ControlTheme x:Key="EditorToolButton" TargetType="ToggleButton" BasedOn="{StaticResource GhostButton}">
    <Setter Property="MinWidth" Value="{StaticResource EditorToolButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource EditorToolButtonSize}"/>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    </Style>
    <Style Selector="^:checked /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="EditorClip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource EditorClipBorder}"/>
    <Setter Property="CornerRadius" Value="{StaticResource EditorClipRadius}"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource EditorMotionSelect}"/>
      </Transitions>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource NeonBlueHover}"/>
    </Style>
    <Style Selector="^.selected">
      <Setter Property="Background" Value="{StaticResource NeonBlueActive}"/>
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
      <Setter Property="BorderThickness" Value="{StaticResource EditorClipSelectedBorder}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="EditorBadgeText" TargetType="TextBlock" BasedOn="{StaticResource PlaybackBadgeText}">
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </ControlTheme>

</ResourceDictionary>
