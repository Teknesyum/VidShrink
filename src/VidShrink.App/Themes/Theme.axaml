                         Geometry="M 611.7,395.1 C 612,390 614,365.7 614.1,358.7 C 614.2,351.8 613,349.4 612.2,346 C 611.4,342.5 609.2,337.9 608.2,334.6 C 607.3,331.2 606,326 605.4,322.4 C 604.9,318.8 604.8,312.8 604,309.3 C 603.3,305.8 602.1,300.6 600.3,297.8 C 598.6,294.9 594.4,291.6 591.6,289.4 C 588.7,287.3 583,284.9 580.4,282.7 C 577.7,280.4 574,276.7 572.7,273.6 C 571.4,270.5 571.2,264.6 571,260.7 C 570.9,256.9 571.9,250.2 571.5,246.5 C 571.1,242.8 569.8,237.5 568.1,234.6 C 566.5,231.8 562.2,228.5 559.6,226.2 C 557,223.9 552.1,221 549.8,218.5 C 547.4,216.1 544.5,211.9 542.9,209 C 541.2,206.1 539.8,201 538.1,198.1 C 536.3,195.3 533.6,191 530.7,188.9 C 527.9,186.7 519.7,183.9 517.9,183.1 L 496.9,116.5 L 512.6,194.5 L 491,177.3 L 501.2,201.8 L 451.9,180.2 L 483.7,205.1 C 484.9,206.3 489.2,211.6 492,213.8 C 494.7,216 500.2,218.5 503.4,220.4 C 506.5,222.3 512,224.9 514.3,227.3 C 516.7,229.8 519.2,234.2 520,237.7 C 520.8,241.1 520.1,247.6 520.1,251.6 C 520,255.6 519.1,262.2 519.7,265.8 C 520.3,269.4 522.3,274.1 524.2,276.9 C 526.1,279.6 530.7,282.7 533.3,285 C 535.8,287.3 540.1,290.6 542,293.3 C 544,296 545.8,300.9 546.9,304.1 C 548.1,307.3 548.8,312.9 550.3,316 C 551.7,319 554.4,323.3 557.1,325.6 C 559.7,327.8 565.3,330.2 568.8,332 C 572.2,333.8 578.3,335.9 581.3,337.9 C 584.3,340 588,343.6 589.8,346.4 C 591.5,349.3 592.8,354.5 593.7,357.9 C 594.6,361.3 593.6,365 596.1,370.3 C 598.6,375.6 609.5,391.6 611.7,395.1 Z"/>
        <GeometryDrawing Brush="{StaticResource PhoenixWingFlameFar}"
                         Geometry="M 618.1,413.1 C 616.5,406.8 609.7,376.8 607.1,368.4 C 604.4,359.9 601.8,357.3 599.4,353.3 C 596.9,349.3 592.2,343.9 589.6,340 C 587.1,336 583.5,329.7 581.4,325.4 C 579.4,321 577.2,313.5 575.2,309 C 573.2,304.6 570.2,297.7 567.5,294 C 564.7,290.2 559.1,285.6 555.5,282.7 C 551.8,279.7 545,276.2 541.5,273 C 538.1,269.9 533.3,264.6 531.1,260.4 C 528.9,256.1 527.4,248 526.2,242.9 C 525,237.7 524.3,228.9 522.7,224.1 C 521.1,219.3 517.8,212.7 514.8,209.2 C 511.7,205.7 505.2,202 501,199.4 C 496.9,196.9 489.5,193.8 485.5,191.2 C 481.4,188.6 475.9,184 472.5,180.8 C 469.1,177.6 464.9,171.7 461.5,168.5 C 458.2,165.3 452.9,160.5 448.6,158.1 C 444.2,155.7 433.5,152.6 431,151.7 L 400.4,58.4 L 431.4,163.6 L 404.8,139 L 423.1,170.9 L 365.8,129.1 L 414.8,178.1 L 364.4,159.4 L 397.8,180.7 C 399.7,182.1 406.7,188.5 411,191 C 415.2,193.4 423.1,196 427.9,198 C 432.7,200 440.7,202.4 444.8,205 C 448.8,207.6 454.1,212.5 456.6,216.5 C 459.2,220.4 461.2,228.1 462.8,232.9 C 464.3,237.7 465.8,245.8 467.8,250.3 C 469.8,254.7 473.8,260.7 476.8,264.2 C 479.9,267.7 486.1,271.7 489.6,274.9 C 493,278 498.6,282.6 501.4,286.4 C 504.1,290.1 507.2,296.9 509.2,301.4 C 511.1,305.8 513.1,313.5 515.4,317.7 C 517.8,321.8 521.9,327.7 525.5,330.7 C 529.1,333.7 536.4,336.8 541,338.9 C 545.6,341.1 553.6,343.5 558,345.9 C 562.3,348.2 568.4,352.4 571.7,355.7 C 575,359 578.9,365 581.4,369 C 583.9,373 584.4,377.4 589.6,383.6 C 594.8,389.8 614.1,408.9 618.1,413.1 Z"/>
