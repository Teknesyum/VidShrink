<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <Color x:Key="NeonBlueColor">#FF00F3FF</Color>
  <Color x:Key="NeonPinkColor">#FFFF00EA</Color>
  <Color x:Key="NeonPurpleColor">#FFB026FF</Color>
  <Color x:Key="NeonSuccessColor">#FF34D399</Color>
  <Color x:Key="SurfaceToneColor">#FF121216</Color>
  <Color x:Key="AppBgColor">#FF050507</Color>
  <Color x:Key="TextBodyColor">#FFFFFFFF</Color>
  <Color x:Key="TextDisabledColor">#FF71717A</Color>

  <Color x:Key="NeonBlueFillColor">#1A00F3FF</Color>
  <Color x:Key="NeonBlueHoverColor">#3300F3FF</Color>
  <Color x:Key="NeonBlueActiveColor">#4D00F3FF</Color>
  <Color x:Key="NeonBlueBorderColor">#4D00F3FF</Color>
  <Color x:Key="NeonBlueBorderStrongColor">#8000F3FF</Color>
  <Color x:Key="NeonPinkFillColor">#1AFF00EA</Color>
  <Color x:Key="NeonPurpleBorderColor">#80B026FF</Color>

  <Color x:Key="NeonEmberColor">#FFFF0033</Color>
  <Color x:Key="EmberFlameColor">#FFFF6600</Color>
  <Color x:Key="EmberBlazeColor">#FFFFFF00</Color>
  <Color x:Key="EmberDeepColor">#FF070306</Color>
  <Color x:Key="EmberMidColor">#FF080407</Color>
  <Color x:Key="EmberEdgeColor">#FF0B0407</Color>
  <Color x:Key="EmberBarDeepColor">#FF130D10</Color>
  <Color x:Key="EmberBarMidColor">#FF150E11</Color>
  <Color x:Key="EmberBarEdgeColor">#FF170F12</Color>

  <SolidColorBrush x:Key="NeonBlue" Color="{StaticResource NeonBlueColor}"/>
  <SolidColorBrush x:Key="NeonPink" Color="{StaticResource NeonPinkColor}"/>
  <SolidColorBrush x:Key="NeonPurple" Color="{StaticResource NeonPurpleColor}"/>
  <SolidColorBrush x:Key="NeonSuccess" Color="{StaticResource NeonSuccessColor}"/>
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceToneColor}"/>
  <SolidColorBrush x:Key="AppBg" Color="{StaticResource AppBgColor}"/>
  <SolidColorBrush x:Key="TextBody" Color="{StaticResource TextBodyColor}"/>
  <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}"/>

  <SolidColorBrush x:Key="NeonBlueFill" Color="{StaticResource NeonBlueFillColor}"/>
  <SolidColorBrush x:Key="NeonBlueHover" Color="{StaticResource NeonBlueHoverColor}"/>
  <SolidColorBrush x:Key="NeonBlueActive" Color="{StaticResource NeonBlueActiveColor}"/>
  <SolidColorBrush x:Key="NeonBlueBorder" Color="{StaticResource NeonBlueBorderColor}"/>
  <SolidColorBrush x:Key="NeonBlueBorderStrong" Color="{StaticResource NeonBlueBorderStrongColor}"/>
  <SolidColorBrush x:Key="NeonPinkFill" Color="{StaticResource NeonPinkFillColor}"/>
  <SolidColorBrush x:Key="NeonPurpleBorder" Color="{StaticResource NeonPurpleBorderColor}"/>
  <SolidColorBrush x:Key="OnNeon" Color="#FF000000"/>
  <SolidColorBrush x:Key="NeonEmber" Color="{StaticResource NeonEmberColor}"/>

  <x:Double x:Key="PhoenixOpacity">0.08</x:Double>
  <x:Double x:Key="PhoenixGlowInnerOpacity">0.34</x:Double>
  <x:Double x:Key="PhoenixGlowMidOpacity">0.30</x:Double>
  <x:Double x:Key="PhoenixGlowOuterOpacity">0.26</x:Double>
  <x:Double x:Key="PhoenixEmberSparkOpacity">0.85</x:Double>
  <x:Double x:Key="EmberAtmosphereOuterOpacity">0.18</x:Double>
  <x:Double x:Key="EmberAtmosphereCoreOpacity">0.12</x:Double>
  <x:Double x:Key="EmberAtmosphereVeilOpacity">0.13</x:Double>
  <x:Double x:Key="EmberAtmosphereCoalOpacity">0.62</x:Double>
  <x:Double x:Key="PanelSurfaceOpacity">0.90</x:Double>

  <SolidColorBrush x:Key="PanelSurface"
                   Color="{StaticResource SurfaceToneColor}"
                   Opacity="{StaticResource PanelSurfaceOpacity}"/>
  <LinearGradientBrush x:Key="PhoenixBodyFlame" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.3"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.94"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PhoenixTailFlame" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.35"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.9"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PhoenixWingFlameNear" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.62"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PhoenixWingFlameFar" StartPoint="100%,50%" EndPoint="0%,50%">
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.55"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PhoenixCrestFlame" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.5"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <RadialGradientBrush x:Key="PhoenixGlowInner" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%" Opacity="{StaticResource PhoenixGlowInnerOpacity}">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.45"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.9"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="PhoenixGlowMid" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%" Opacity="{StaticResource PhoenixGlowMidOpacity}">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.4"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.85"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </RadialGradientBrush>

  <RadialGradientBrush x:Key="PhoenixGlowOuter" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%" Opacity="{StaticResource PhoenixGlowOuterOpacity}">
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.55"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </RadialGradientBrush>

  <LinearGradientBrush x:Key="PhoenixEmberSpark" StartPoint="50%,100%" EndPoint="50%,0%" Opacity="{StaticResource PhoenixEmberSparkOpacity}">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.5"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.92"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <!-- Broad, low-frequency layers make the backdrop read as heated air rather than an illustration. -->
  <RadialGradientBrush x:Key="EmberAtmosphereOuter" Center="50%,58%" GradientOrigin="42%,62%" RadiusX="58%" RadiusY="58%" Opacity="{StaticResource EmberAtmosphereOuterOpacity}">
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.48"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="EmberAtmosphereCore" Center="48%,56%" GradientOrigin="44%,62%" RadiusX="52%" RadiusY="52%" Opacity="{StaticResource EmberAtmosphereCoreOpacity}">
    <GradientStop Color="{StaticResource EmberBlazeColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.34"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.72"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="EmberAtmosphereVeil" StartPoint="0%,100%" EndPoint="100%,0%" Opacity="{StaticResource EmberAtmosphereVeilOpacity}">
    <GradientStop Color="Transparent" Offset="0"/>
    <GradientStop Color="{StaticResource NeonEmberColor}" Offset="0.38"/>
    <GradientStop Color="{StaticResource EmberFlameColor}" Offset="0.62"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="EmberAtmosphereCoal" StartPoint="0%,0%" EndPoint="100%,100%" Opacity="{StaticResource EmberAtmosphereCoalOpacity}">
    <GradientStop Color="Transparent" Offset="0"/>
    <GradientStop Color="{StaticResource EmberDeepColor}" Offset="0.46"/>
    <GradientStop Color="{StaticResource EmberEdgeColor}" Offset="0.7"/>
    <GradientStop Color="Transparent" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TitleBarBackground" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{StaticResource EmberBarDeepColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberBarDeepColor}" Offset="0.2"/>
    <GradientStop Color="{StaticResource EmberBarMidColor}" Offset="0.4"/>
    <GradientStop Color="{StaticResource EmberBarMidColor}" Offset="0.6"/>
    <GradientStop Color="{StaticResource EmberBarEdgeColor}" Offset="0.8"/>
    <GradientStop Color="{StaticResource EmberBarEdgeColor}" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="WorkspaceGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="{StaticResource EmberDeepColor}" Offset="0"/>
    <GradientStop Color="{StaticResource EmberDeepColor}" Offset="0.25"/>
    <GradientStop Color="{StaticResource EmberMidColor}" Offset="0.5"/>
    <GradientStop Color="{StaticResource EmberMidColor}" Offset="0.75"/>
    <GradientStop Color="{StaticResource EmberEdgeColor}" Offset="1"/>
  </LinearGradientBrush>

  <DrawingBrush x:Key="WorkspaceBackground"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center">
    <DrawingBrush.Drawing>
    <DrawingGroup>
      <DrawingGroup.Children>
      <GeometryDrawing Brush="{StaticResource WorkspaceGradient}"
                       Geometry="M 0,0 L 1600,0 L 1600,1000 L 0,1000 Z"/>
      <!-- Offset thermal pools, smoke banks and crossing veils deliberately avoid a readable silhouette. -->
      <DrawingGroup>
        <DrawingGroup.Children>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereOuter}"
                         Geometry="M -120,790 C 70,520 300,390 570,420 C 790,445 920,610 870,790 C 815,985 520,1070 190,1030 C 10,1008 -100,920 -120,790 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereOuter}"
                         Geometry="M 760,330 C 930,120 1260,95 1510,270 C 1660,375 1700,590 1570,720 C 1420,870 1110,780 930,650 C 790,548 690,418 760,330 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereCore}"
                         Geometry="M 210,865 C 300,650 470,535 665,565 C 810,588 885,700 820,820 C 735,978 430,1035 250,950 C 215,933 195,905 210,865 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereCore}"
                         Geometry="M 1010,270 C 1125,150 1370,170 1510,320 C 1600,418 1570,555 1460,610 C 1325,678 1090,555 1005,430 C 965,372 968,315 1010,270 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereVeil}"
                         Geometry="M -80,735 C 180,610 390,585 610,620 C 850,658 1040,785 1280,770 C 1410,762 1520,720 1680,630 L 1680,715 C 1500,825 1370,865 1215,862 C 970,858 805,740 580,702 C 365,666 155,690 -80,820 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereVeil}"
                         Geometry="M 390,-70 C 535,120 650,205 825,260 C 1035,327 1210,310 1410,430 C 1510,490 1590,565 1680,675 L 1680,765 C 1555,615 1460,548 1345,495 C 1150,405 980,420 775,345 C 590,278 470,170 330,-10 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereCoal}"
                         Geometry="M -60,120 C 220,40 480,125 660,300 C 790,425 825,585 745,705 C 650,850 390,842 185,735 C 10,642 -95,430 -60,120 Z"/>
        <GeometryDrawing Brush="{StaticResource EmberAtmosphereCoal}"
                         Geometry="M 910,590 C 1100,470 1370,505 1660,700 L 1660,1040 L 850,1040 C 790,875 805,690 910,590 Z"/>
        </DrawingGroup.Children>
      </DrawingGroup>
      <DrawingGroup Opacity="{StaticResource PhoenixOpacity}">
        <DrawingGroup.Children>
        <GeometryDrawing Brush="{StaticResource PhoenixGlowOuter}"
                         Geometry="M 1072,470 C 1072,523.6 1060.5,581.2 1040,630.7 C 1019.5,680.2 986.9,729.1 949,767 C 911.1,804.9 862.2,837.5 812.7,858 C 763.2,878.5 705.6,890 652,890 C 598.4,890 540.8,878.5 491.3,858 C 441.8,837.5 392.9,804.9 355,767 C 317.1,729.1 284.5,680.2 264,630.7 C 243.5,581.2 232,523.6 232,470 C 232,416.4 243.5,358.8 264,309.3 C 284.5,259.8 317.1,210.9 355,173 C 392.9,135.1 441.8,102.5 491.3,82 C 540.8,61.5 598.4,50 652,50 C 705.6,50 763.2,61.5 812.7,82 C 862.2,102.5 911.1,135.1 949,173 C 986.9,210.9 1019.5,259.8 1040,309.3 C 1060.5,358.8 1072,416.4 1072,470 Z"/>
        <GeometryDrawing Brush="{StaticResource PhoenixGlowMid}"
                         Geometry="M 952,470 C 952,508.3 943.8,549.4 929.2,584.8 C 914.5,620.2 891.2,655.1 864.1,682.1 C 837.1,709.2 802.2,732.5 766.8,747.2 C 731.4,761.8 690.3,770 652,770 C 613.7,770 572.6,761.8 537.2,747.2 C 501.8,732.5 466.9,709.2 439.9,682.1 C 412.8,655.1 389.5,620.2 374.8,584.8 C 360.2,549.4 352,508.3 352,470 C 352,431.7 360.2,390.6 374.8,355.2 C 389.5,319.8 412.8,284.9 439.9,257.9 C 466.9,230.8 501.8,207.5 537.2,192.8 C 572.6,178.2 613.7,170 652,170 C 690.3,170 731.4,178.2 766.8,192.8 C 802.2,207.5 837.1,230.8 864.1,257.9 C 891.2,284.9 914.5,319.8 929.2,355.2 C 943.8,390.6 952,431.7 952,470 Z"/>
        <GeometryDrawing Brush="{StaticResource PhoenixGlowInner}"
                         Geometry="M 857,470 C 857,496.2 851.4,524.3 841.4,548.5 C 831.4,572.6 815.4,596.5 797,615 C 778.5,633.4 754.6,649.4 730.5,659.4 C 706.3,669.4 678.2,675 652,675 C 625.8,675 597.7,669.4 573.5,659.4 C 549.4,649.4 525.5,633.4 507,615 C 488.6,596.5 472.6,572.6 462.6,548.5 C 452.6,524.3 447,496.2 447,470 C 447,443.8 452.6,415.7 462.6,391.5 C 472.6,367.4 488.6,343.5 507,325 C 525.5,306.6 549.4,290.6 573.5,280.6 C 597.7,270.6 625.8,265 652,265 C 678.2,265 706.3,270.6 730.5,280.6 C 754.6,290.6 778.5,306.6 797,325 C 815.4,343.5 831.4,367.4 841.4,391.5 C 851.4,415.7 857,443.8 857,470 Z"/>
