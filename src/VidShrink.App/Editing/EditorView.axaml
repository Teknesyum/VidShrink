<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:playback="using:VidShrink.App.Playback"
             xmlns:editing="using:VidShrink.App.Editing"
             x:Class="VidShrink.App.Editing.EditorView">
  <Grid x:Name="Layout">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="{StaticResource EditorPreviewMinHeight}"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <playback:PlayerView x:Name="Preview" Grid.Row="0" auto:AutomationProperties.Name="{loc:Text editor.monitor}"/>
    <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Theme="{StaticResource PlanSplitter}" ResizeDirection="Rows"/>
    <editing:EditorScrollViewer x:Name="LowerScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusPanel}" Margin="{StaticResource PageMargin}">
      <Grid x:Name="MonitorBar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource EditorTransportGap}" AutomationProperties.Name="{loc:Text editor.monitor}">
        <TextBox x:Name="TxtTimecode" Grid.Column="0" MinWidth="{StaticResource EditorTimecodeWidth}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.timecode}"/>
        <StackPanel x:Name="Transport" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource EditorTransportGap}">
          <Button x:Name="BtnMarkIn" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.mark-in}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" RenderTransform="rotate(90deg)" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnMarkOut" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.mark-out}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" RenderTransform="rotate(-90deg)" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnGoIn" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.key.go-in}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconRestart}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnFrameBack" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text main.player.menu.prevframe}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconRewind}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnPlay" Theme="{StaticResource PlaybackPlayButton}" AutomationProperties.Name="{loc:Text main.player.menu.playpause}">
            <Path x:Name="GlyphPlay" Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" Stretch="Uniform" Data="{StaticResource IconPlay}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnFrameForward" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text main.player.menu.nextframe}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconFastForward}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnGoOut" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.key.go-out}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" RenderTransform="scale(-1,1)" Data="{StaticResource IconRestart}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnSplit" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.split}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconEditor}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="BtnExtract" Theme="{StaticResource PlaybackBarButton}" AutomationProperties.Name="{loc:Text editor.delete-range}">
            <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconMinimize}" Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource EditorTransportGap}" VerticalAlignment="Center">
          <Button x:Name="BtnAudioTrack" Theme="{StaticResource PlaybackBarButton}" IsVisible="False" AutomationProperties.Name="{loc:Text editor.monitor.audio-track}" ToolTip.Tip="{loc:Text editor.monitor.audio-track}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <Path x:Name="GlyphAudioTrack" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" VerticalAlignment="Center" Data="{StaticResource IconVolume}" Fill="{Binding $parent[Button].Foreground}"/>
              <SarilanMetin x:Name="TxtAudioTrack" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>
          <ProgressBar x:Name="LevelMeter" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" Minimum="-60" Maximum="0" Value="-60" IsVisible="False" AutomationProperties.Name="{loc:Text editor.monitor.level}" ToolTip.Tip="{loc:Text editor.monitor.level}">
            <ProgressBar.Transitions>
              <Transitions/>
            </ProgressBar.Transitions>
          </ProgressBar>
          <SarilanMetin x:Name="TxtOnKeyframe" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.on-keyframe}" IsVisible="False"/>
          <SarilanMetin x:Name="TxtDuration" Theme="{StaticResource MonoValue}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.duration}" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
      </Border>
      <Border Theme="{StaticResource Panel}" Background="{StaticResource Surface}" Margin="{StaticResource PageMargin}">
        <StackPanel Spacing="{StaticResource SpaceSm}">
          <WrapPanel x:Name="Strip" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
            <WrapPanel x:Name="Toolbar" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
              <TextBox x:Name="TxtSpeed" Width="{StaticResource NumberBoxWidth}" AutomationProperties.Name="{loc:Text editor.speed}"/>
              <Button x:Name="BtnUndo" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.undo}"/>
              <Button x:Name="BtnRedo" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.redo}"/>
              <Button x:Name="BtnZoomOut" Theme="{StaticResource GhostButton}" MinWidth="{StaticResource EditorToolButtonSize}" Content="-" AutomationProperties.Name="{loc:Text editor.zoom-out}"/>
              <Button x:Name="BtnZoomIn" Theme="{StaticResource GhostButton}" MinWidth="{StaticResource EditorToolButtonSize}" Content="+" AutomationProperties.Name="{loc:Text editor.zoom-in}"/>
              <Button x:Name="BtnZoomFit" Theme="{StaticResource GhostButton}" AutomationProperties.Name="{loc:Text editor.key.zoom-fit}">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconFullScreen}" Fill="{Binding $parent[Button].Foreground}"/>
              </Button>
              <ToggleButton x:Name="BtnSnap" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.snap}" AutomationProperties.Name="{loc:Text editor.snap}"/>
              <ComboBox x:Name="CmbProjectFrame" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text editor.frame.tip}" AutomationProperties.Name="{loc:Text editor.frame}"/>
              <Button x:Name="BtnAddSource" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.source.add}"/>
              <ToggleButton x:Name="BtnMedia" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.media.open}" AutomationProperties.Name="{loc:Text editor.media.open}"/>
              <Button x:Name="BtnAddText" Theme="{StaticResource GhostButton}" MinWidth="{StaticResource EditorToolButtonSize}" Content="T" AutomationProperties.Name="{loc:Text editor.text.add}"/>
              <ToggleButton x:Name="BtnSilence" Theme="{StaticResource EditorToolButton}" AutomationProperties.Name="{loc:Text editor.silence.open}" ToolTip.Tip="{loc:Text editor.silence.open}">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconVolumeMute}" Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </ToggleButton>
            </WrapPanel>
            <WrapPanel x:Name="DeliveryGroup" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}" VerticalAlignment="Top">
              <Button x:Name="BtnSave" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.save}" AutomationProperties.Name="{loc:Text editor.save}" IsEnabled="False" ToolTip.Tip="{loc:Text main.action.shrink.disabled-tip}"/>
              <Button x:Name="BtnExport" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.save-as}" AutomationProperties.Name="{loc:Text editor.save-as}" IsEnabled="False" ToolTip.Tip="{loc:Text main.action.shrink.disabled-tip}"/>
              <Button x:Name="BtnShare" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.share}" AutomationProperties.Name="{loc:Text main.action.share}" IsEnabled="False" ToolTip.Tip="{loc:Text main.action.shrink.disabled-tip}"/>
              <ComboBox x:Name="CmbExportMode" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.mode}" SelectedIndex="1">
                <ComboBoxItem Content="{loc:Text editor.export.fast}"/>
                <ComboBoxItem Content="{loc:Text editor.export.smart}"/>
                <ComboBoxItem Content="{loc:Text editor.export.full}"/>
              </ComboBox>
              <Button x:Name="BtnExportOptions" Theme="{StaticResource GhostButton}" AutomationProperties.Name="{loc:Text editor.export.separate}" IsEnabled="False" ToolTip.Tip="{loc:Text editor.export.separate}">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                      <CheckBox x:Name="ChkExportSeparate" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.export.separate}"/>
                      <CheckBox x:Name="ChkExportDropMetadata" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.drop-metadata.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.drop-metadata.tip}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                      <CheckBox x:Name="ChkExportChapters" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.export.chapters}" ToolTip.Tip="{loc:Text editor.export.chapters.tip}"/>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.part-name}"/>
                        <TextBox x:Name="TxtPartName" Width="{StaticResource FieldWidth}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.export.part-name}" ToolTip.Tip="{loc:Text editor.export.part-name.hint}"/>
                      </StackPanel>
                      <SarilanMetin x:Name="TxtPartNameError" Theme="{StaticResource StatusError}" TextWrapping="Wrap" MaxWidth="{StaticResource FieldWidth}" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <Grid x:Name="ExportSettingsGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceSm}">
                        <SarilanMetin Grid.Row="0" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.preset}"/>
                        <ComboBox x:Name="CmbExportPreset" Grid.Row="0" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.preset}" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Text editor.export.preset.custom}" Tag=""/>
                          <ComboBoxItem Content="{loc:Text editor.export.preset.1080p}" Tag="1080p"/>
                          <ComboBoxItem Content="{loc:Text editor.export.preset.720p}" Tag="720p"/>
                          <ComboBoxItem Content="{loc:Text editor.export.preset.vertical}" Tag="vertical"/>
                        </ComboBox>
                        <SarilanMetin Grid.Row="1" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.resolution}"/>
                        <ComboBox x:Name="CmbExportResolution" Grid.Row="1" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.resolution}" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Text editor.export.source}" Tag="0x0"/>
                          <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
                          <ComboBoxItem Content="1280 × 720" Tag="1280x720"/>
                          <ComboBoxItem Content="1080 × 1920" Tag="1080x1920"/>
                        </ComboBox>
                        <SarilanMetin Grid.Row="2" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.fps}"/>
                        <ComboBox x:Name="CmbExportFps" Grid.Row="2" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.fps}" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Text editor.export.source}" Tag="0"/>
                        </ComboBox>
                        <SarilanMetin Grid.Row="3" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.codec}"/>
                        <ComboBox x:Name="CmbExportCodec" Grid.Row="3" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.codec}"/>
                        <SarilanMetin Grid.Row="4" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.quality}"/>
                        <ComboBox x:Name="CmbExportQuality" Grid.Row="4" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.quality}" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Text editor.export.quality.high}"/>
                          <ComboBoxItem Content="{loc:Text editor.export.quality.balanced}"/>
                          <ComboBoxItem Content="{loc:Text editor.export.quality.small}"/>
                        </ComboBox>
                        <SarilanMetin Grid.Row="5" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.audio-bitrate}"/>
                        <ComboBox x:Name="CmbExportAudioBitrate" Grid.Row="5" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.audio-bitrate}"/>
                        <CheckBox x:Name="ChkExportAudioOnly" Grid.Row="6" Grid.ColumnSpan="2" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.export.audio-only}" ToolTip.Tip="{loc:Text editor.export.audio-only.tip}"/>
                        <SarilanMetin Grid.Row="7" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.export.audio-track}"/>
                        <ComboBox x:Name="CmbExportAudioTrack" Grid.Row="7" Grid.Column="1" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.export.audio-track}"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <TextBox x:Name="TxtExportPresetName" Width="{StaticResource FieldWidth}" VerticalAlignment="Center" PlaceholderText="{loc:Text editor.export.preset.name}" AutomationProperties.Name="{loc:Text editor.export.preset.name}"/>
                        <Button x:Name="BtnExportPresetSave" Theme="{StaticResource GhostButton}" VerticalAlignment="Center" Content="{loc:Text main.preset.save}"/>
                      </StackPanel>
                      <SarilanMetin x:Name="TxtExportPresetError" Theme="{StaticResource StatusError}" TextWrapping="Wrap" MaxWidth="{StaticResource FieldWidth}" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <Grid x:Name="RemuxGrid" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceSm}">
                        <SarilanMetin Grid.Row="0" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.file-title}"/>
                        <TextBox x:Name="TxtRemuxFileTitle" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.remux.file-title}"/>
                        <SarilanMetin Grid.Row="1" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.track}"/>
                        <ComboBox x:Name="CmbRemuxTrack" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" MinWidth="{StaticResource EditorExportModeWidth}" AutomationProperties.Name="{loc:Text editor.remux.track}"/>
                        <SarilanMetin Grid.Row="2" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.language}"/>
                        <TextBox x:Name="TxtRemuxLanguage" Grid.Row="2" Grid.Column="1" Width="{StaticResource FieldWidthSm}" MaxLength="3" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.remux.language}"/>
                        <SarilanMetin Grid.Row="2" Grid.Column="2" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.track-title}"/>
                        <TextBox x:Name="TxtRemuxTrackTitle" Grid.Row="2" Grid.Column="3" Width="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.remux.track-title}"/>
                        <SarilanMetin Grid.Row="3" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.offset}"/>
                        <TextBox x:Name="TxtRemuxOffset" Grid.Row="3" Grid.Column="1" Width="{StaticResource FieldWidthSm}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.remux.offset}"/>
                        <SarilanMetin Grid.Row="3" Grid.Column="2" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.remux.rotation}"/>
                        <ComboBox x:Name="CmbRemuxRotation" Grid.Row="3" Grid.Column="3" Width="{StaticResource FieldWidthSm}" AutomationProperties.Name="{loc:Text editor.remux.rotation}" SelectedIndex="0">
                          <ComboBoxItem Content="{loc:Text editor.remux.rotation.keep}"/>
                          <ComboBoxItem Content="0°"/>
                          <ComboBoxItem Content="90°"/>
                          <ComboBoxItem Content="180°"/>
                          <ComboBoxItem Content="270°"/>
                        </ComboBox>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                          <CheckBox x:Name="ChkRemuxInclude" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.remux.include}"/>
                          <CheckBox x:Name="ChkRemuxDefault" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.remux.default}"/>
                        </StackPanel>
                        <Button x:Name="BtnRemux" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Theme="{StaticResource GhostButton}" HorizontalAlignment="Right" IsEnabled="False" Content="{loc:Text editor.remux.run}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text editor.remux.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                          <Button x:Name="BtnRemuxAdd" Theme="{StaticResource GhostButton}" IsEnabled="False" Content="{loc:Text editor.remux.add}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text editor.remux.add.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                          <Button x:Name="BtnRemuxExtract" Theme="{StaticResource GhostButton}" IsEnabled="False" Content="{loc:Text editor.remux.extract}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text editor.remux.extract.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                          <Button x:Name="BtnRemuxCover" Theme="{StaticResource GhostButton}" IsEnabled="False" Content="{loc:Text editor.remux.cover}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text editor.remux.cover.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </WrapPanel>
          <WrapPanel x:Name="TextPanel" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}" IsVisible="False" AutomationProperties.Name="{loc:Text editor.text.panel}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextContent" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.content}"/>
              <TextBox x:Name="TxtTextContent" Width="{StaticResource FieldWidth}" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="{loc:Text editor.text.content}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextSize" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.size}"/>
              <TextBox x:Name="TxtTextSize" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.size}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextColor" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.color}"/>
              <TextBox x:Name="TxtTextColor" Width="{StaticResource NumberBoxWidth}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.color}"/>
              <Border x:Name="TextSwatch" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusChip}" BorderThickness="{StaticResource BorderThin}" BorderBrush="{StaticResource HeaderRestBorder}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextFont" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.font}"/>
              <ComboBox x:Name="CmbTextFont" Width="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.font}"/>
              <ToggleButton x:Name="BtnTextBold" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.text.bold}" AutomationProperties.Name="{loc:Text editor.text.bold}"/>
              <ToggleButton x:Name="BtnTextItalic" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.text.italic}" AutomationProperties.Name="{loc:Text editor.text.italic}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextFadeIn" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.fade-in}"/>
              <TextBox x:Name="TxtTextFadeIn" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.fade-in}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextFadeOut" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.fade-out}"/>
              <TextBox x:Name="TxtTextFadeOut" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.fade-out}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextOutline" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.outline}"/>
              <TextBox x:Name="TxtTextOutline" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" PlaceholderText="{loc:Text editor.text.auto}" AutomationProperties.Name="{loc:Text editor.text.outline}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextShadow" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.shadow}"/>
              <TextBox x:Name="TxtTextShadow" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.shadow}"/>
              <ToggleButton x:Name="BtnTextBox" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.text.box}" AutomationProperties.Name="{loc:Text editor.text.box}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextX" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.x}"/>
              <TextBox x:Name="TxtTextX" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.x}"/>
              <SarilanMetin x:Name="LblTextY" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.y}"/>
              <TextBox x:Name="TxtTextY" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.text.y}"/>
              <ToggleButton x:Name="BtnTextKeyframe" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.text.keyframe}" ToolTip.Tip="{loc:Text editor.text.keyframe.tip}" AutomationProperties.Name="{loc:Text editor.text.keyframe}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextMotionIn" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.motion-in}"/>
              <ComboBox x:Name="CmbTextMotionIn" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text editor.text.motion.tip}" AutomationProperties.Name="{loc:Text editor.text.motion-in}"/>
              <TextBox x:Name="TxtTextMotionIn" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text editor.text.motion.duration}" AutomationProperties.Name="{loc:Text editor.text.motion.duration}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="LblTextMotionOut" Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.text.motion-out}"/>
              <ComboBox x:Name="CmbTextMotionOut" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text editor.text.motion.tip}" AutomationProperties.Name="{loc:Text editor.text.motion-out}"/>
              <TextBox x:Name="TxtTextMotionOut" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" ToolTip.Tip="{loc:Text editor.text.motion.duration}" AutomationProperties.Name="{loc:Text editor.text.motion.duration}"/>
            </StackPanel>
          </WrapPanel>
          <WrapPanel x:Name="ClipPanel" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}" IsVisible="False" AutomationProperties.Name="{loc:Text editor.clip.panel}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <Button x:Name="BtnClipRotate" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.rotate}" AutomationProperties.Name="{loc:Text editor.clip.rotate}"/>
              <ToggleButton x:Name="BtnClipFlipH" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.flip-h}" AutomationProperties.Name="{loc:Text editor.clip.flip-h}"/>
              <ToggleButton x:Name="BtnClipFlipV" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.flip-v}" AutomationProperties.Name="{loc:Text editor.clip.flip-v}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.crop}"/>
              <ComboBox x:Name="CmbClipCrop" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.crop}"/>
              <ToggleButton x:Name="BtnClipFit" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.fit}" AutomationProperties.Name="{loc:Text editor.clip.fit}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.pad}"/>
              <ComboBox x:Name="CmbClipPad" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.pad}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.scale}"/>
              <TextBox x:Name="TxtClipScale" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.scale}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.offset-x}"/>
              <TextBox x:Name="TxtClipOffsetX" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.offset-x}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.offset-y}"/>
              <TextBox x:Name="TxtClipOffsetY" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.offset-y}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.angle}"/>
              <TextBox x:Name="TxtClipAngle" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.angle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.volume}"/>
              <TextBox x:Name="TxtClipVolume" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.volume}"/>
              <ToggleButton x:Name="BtnClipMute" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.mute}" AutomationProperties.Name="{loc:Text editor.clip.mute}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <ToggleButton x:Name="BtnClipDenoise" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.denoise}" AutomationProperties.Name="{loc:Text editor.clip.denoise}"/>
              <ToggleButton x:Name="BtnClipLoudnorm" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.loudnorm}" AutomationProperties.Name="{loc:Text editor.clip.loudnorm}"/>
              <ToggleButton x:Name="BtnClipCompressor" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.compressor}" AutomationProperties.Name="{loc:Text editor.clip.compressor}"/>
              <ToggleButton x:Name="BtnClipLimiter" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.limiter}" AutomationProperties.Name="{loc:Text editor.clip.limiter}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.eq-bass}"/>
              <TextBox x:Name="TxtClipBass" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.eq-bass}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.eq-mid}"/>
              <TextBox x:Name="TxtClipMid" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.eq-mid}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.eq-treble}"/>
              <TextBox x:Name="TxtClipTreble" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.eq-treble}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.fade-in}"/>
              <TextBox x:Name="TxtClipFadeIn" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.fade-in}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.fade-out}"/>
              <TextBox x:Name="TxtClipFadeOut" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.fade-out}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.transition}"/>
              <ComboBox x:Name="CmbClipTransition" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.transition}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.transition.duration}"/>
              <TextBox x:Name="TxtClipTransition" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.transition.duration}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.label}"/>
              <TextBox x:Name="TxtClipLabel" Width="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.label}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.look}"/>
              <ComboBox x:Name="CmbClipLook" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.look}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.brightness}"/>
              <TextBox x:Name="TxtClipBrightness" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.brightness}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.contrast}"/>
              <TextBox x:Name="TxtClipContrast" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.contrast}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.saturation}"/>
              <TextBox x:Name="TxtClipSaturation" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.saturation}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.temperature}"/>
              <TextBox x:Name="TxtClipTemperature" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.temperature}"/>
            </StackPanel>
            <ToggleButton x:Name="BtnClipAutoColor" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.auto-color}" AutomationProperties.Name="{loc:Text editor.clip.auto-color}"/>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.curve-shadows}"/>
              <TextBox x:Name="TxtClipCurveShadows" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.curve-shadows}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.curve-mids}"/>
              <TextBox x:Name="TxtClipCurveMids" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.curve-mids}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.curve-highlights}"/>
              <TextBox x:Name="TxtClipCurveHighlights" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.curve-highlights}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.shadow-hue}"/>
              <TextBox x:Name="TxtClipShadowHue" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.shadow-hue}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.shadow-amount}"/>
              <TextBox x:Name="TxtClipShadowAmount" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.shadow-amount}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.mid-hue}"/>
              <TextBox x:Name="TxtClipMidHue" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.mid-hue}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.mid-amount}"/>
              <TextBox x:Name="TxtClipMidAmount" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.mid-amount}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.highlight-hue}"/>
              <TextBox x:Name="TxtClipHighlightHue" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.highlight-hue}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.highlight-amount}"/>
              <TextBox x:Name="TxtClipHighlightAmount" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.highlight-amount}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.blur}"/>
              <TextBox x:Name="TxtClipBlur" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.blur}" ToolTip.Tip="{loc:Text editor.clip.blur.tip}"/>
              <ToggleButton x:Name="BtnClipBlurRegion" Theme="{StaticResource EditorToolButton}" Content="{loc:Text editor.clip.blur.region}" AutomationProperties.Name="{loc:Text editor.clip.blur.region}" ToolTip.Tip="{loc:Text editor.clip.blur.region.tip}"/>
              <Button x:Name="BtnClipBlurWhole" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.blur.whole}" AutomationProperties.Name="{loc:Text editor.clip.blur.whole}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.keys.ease}"/>
              <ComboBox x:Name="CmbClipEase" MinWidth="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.keys.ease}"/>
              <Button x:Name="BtnClipKeyVolume" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.keys.add-volume}" AutomationProperties.Name="{loc:Text editor.clip.keys.add-volume}"/>
              <Button x:Name="BtnClipKeyCrop" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.keys.add-crop}" AutomationProperties.Name="{loc:Text editor.clip.keys.add-crop}"/>
              <Button x:Name="BtnClipKeysClear" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.keys.clear}" AutomationProperties.Name="{loc:Text editor.clip.keys.clear}"/>
              <SarilanMetin x:Name="TxtClipKeys" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
              <Button x:Name="BtnClipLut" Theme="{StaticResource GhostButton}" VerticalAlignment="Center" Content="{loc:Text editor.clip.lut.load}" AutomationProperties.Name="{loc:Text editor.clip.lut.load}"/>
              <SarilanMetin x:Name="TxtClipLutName" Theme="{StaticResource Hint}" VerticalAlignment="Center" MaxWidth="{StaticResource FieldWidthSm}"/>
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.clip.lut.mix}"/>
              <TextBox x:Name="TxtClipLutMix" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.clip.lut.mix}"/>
              <Button x:Name="BtnClipLutRemove" Theme="{StaticResource GhostButton}" VerticalAlignment="Center" Content="{loc:Text editor.clip.lut.remove}" AutomationProperties.Name="{loc:Text editor.clip.lut.remove}"/>
            </StackPanel>
            <Button x:Name="BtnClipReset" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.clip.reset}" AutomationProperties.Name="{loc:Text editor.clip.reset}"/>
          </WrapPanel>
          <WrapPanel x:Name="MediaPanel" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}" IsVisible="False" AutomationProperties.Name="{loc:Text editor.media.open}">
            <ListBox x:Name="LstMedia" Width="{StaticResource FieldWidth}" MaxHeight="{StaticResource DropDownMaxHeight}" SelectionMode="Single" AutomationProperties.Name="{loc:Text editor.media.open}" ToolTip.Tip="{loc:Text editor.media.tip}"/>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Top">
              <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.media.mode}"/>
              <ComboBox x:Name="CmbPlaceMode" MinWidth="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.media.mode}">
                <ComboBoxItem Content="{loc:Text editor.media.insert}"/>
                <ComboBoxItem Content="{loc:Text editor.media.overwrite}"/>
              </ComboBox>
            </StackPanel>
            <StackPanel x:Name="ProxyPanel" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Top" MaxWidth="{StaticResource FieldWidth}">
              <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
                <Button x:Name="BtnProxyCreate" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.proxy.create}" AutomationProperties.Name="{loc:Text editor.proxy.create}" ToolTip.Tip="{loc:Text editor.proxy.tip}" IsEnabled="False"/>
                <Button x:Name="BtnProxyCancel" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.cancel}" IsVisible="False"/>
                <Button x:Name="BtnProxyDelete" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.proxy.delete}" AutomationProperties.Name="{loc:Text editor.proxy.delete}" IsEnabled="False"/>
              </WrapPanel>
              <ProgressBar x:Name="ProxyProgress" Maximum="1" IsVisible="False"/>
              <SarilanMetin x:Name="TxtProxyStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel x:Name="SilencePanel" Spacing="{StaticResource SpaceSm}" IsVisible="False" AutomationProperties.Name="{loc:Text editor.silence.panel}">
            <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <CheckBox x:Name="ChkSilenceAudio" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.silence.audio}" IsChecked="True" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSilenceBlack" Theme="{StaticResource CheckStyle}" Content="{loc:Text editor.silence.black}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.silence.threshold}"/>
                <TextBox x:Name="TxtSilenceThreshold" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.silence.threshold}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.silence.min}"/>
                <TextBox x:Name="TxtSilenceMin" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.silence.min}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.silence.padding-start}"/>
                <TextBox x:Name="TxtSilencePaddingStart" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.silence.padding-start}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.silence.padding-end}"/>
                <TextBox x:Name="TxtSilencePaddingEnd" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.silence.padding-end}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.silence.track}"/>
                <ComboBox x:Name="CmbSilenceTrack" MinWidth="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.silence.track}" IsEnabled="{Binding #ChkSilenceAudio.IsChecked}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <Button x:Name="BtnSilenceScan" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.silence.scan}" AutomationProperties.Name="{loc:Text editor.silence.scan}"/>
                <Button x:Name="BtnSilenceCancel" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.cancel}" IsVisible="False"/>
                <Button x:Name="BtnSilenceApply" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.silence.apply}" AutomationProperties.Name="{loc:Text editor.silence.apply}" IsEnabled="False">
                  <Button.Styles>
                    <Style Selector="Button">
                      <Setter Property="ToolTip.Tip" Value="{loc:Text editor.silence.hint}"/>
                    </Style>
                    <Style Selector="Button:disabled">
                      <Setter Property="ToolTip.Tip" Value="{loc:Text editor.silence.none}"/>
                    </Style>
                  </Button.Styles>
                </Button>
                <Button x:Name="BtnSilenceSaveList" Theme="{StaticResource GhostButton}" Content="{loc:Text mediainfo.audit.save-list}" AutomationProperties.Name="{loc:Text mediainfo.audit.save-list}" IsEnabled="False"/>
              </StackPanel>
              <Button x:Name="BtnSceneSplit" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.scene.split}" AutomationProperties.Name="{loc:Text editor.scene.split}" IsEnabled="False">
                <Button.Styles>
                  <Style Selector="Button:disabled">
                    <Setter Property="ToolTip.Tip" Value="{loc:Text main.ai.load-first}"/>
                  </Style>
                </Button.Styles>
              </Button>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.scene.threshold}"/>
                <TextBox x:Name="TxtSceneThreshold" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.scene.threshold}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.split.auto}"/>
                <ComboBox x:Name="CmbAutoSplit" MinWidth="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.split.auto}">
                  <ComboBoxItem Content="{loc:Text editor.split.count}"/>
                  <ComboBoxItem Content="{loc:Text editor.split.duration}"/>
                  <ComboBoxItem Content="{loc:Text editor.split.size}"/>
                </ComboBox>
                <TextBox x:Name="TxtAutoSplit" Width="{StaticResource NumberBoxWidth}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.split.value}"/>
                <Button x:Name="BtnAutoSplit" Theme="{StaticResource GhostButton}" Content="{loc:Text editor.split.apply}" AutomationProperties.Name="{loc:Text editor.split.apply}" IsEnabled="False"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <SarilanMetin Theme="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Text editor.marker.name}"/>
                <TextBox x:Name="TxtMarkerName" Width="{StaticResource FieldWidthSm}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Text editor.marker.name}"/>
              </StackPanel>
            </WrapPanel>
            <ProgressBar x:Name="SilenceProgress" Maximum="1" IsVisible="False"/>
            <SarilanMetin x:Name="TxtSilenceStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <StackPanel x:Name="ExportBar" Spacing="{StaticResource SpaceSm}" IsVisible="False">
            <ProgressBar x:Name="ExportProgress" Maximum="1" IsVisible="False"/>
            <SarilanMetin x:Name="TxtExportNote" Theme="{StaticResource StatusWarning}" TextWrapping="Wrap" IsVisible="False"/>
            <SarilanMetin x:Name="TxtExportStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
            <WrapPanel Orientation="Horizontal" ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
              <Button x:Name="BtnExportCancel" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.cancel}" IsVisible="False"/>
              <Button x:Name="BtnExportReveal" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.show-in-folder}" IsVisible="False"/>
              <Button x:Name="BtnExportPlay" Theme="{StaticResource GhostButton}" Content="{loc:Text recorder.output.to-player}" IsVisible="False"/>
              <Button x:Name="BtnShareCancel" Theme="{StaticResource GhostButton}" Content="{loc:Text main.action.cancel-upload}" IsVisible="False"/>
            </WrapPanel>
            <ProgressBar x:Name="ShareProgress" Maximum="1" IsVisible="False"/>
            <Grid x:Name="ShareLinkRow" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
              <TextBox Grid.Column="0" x:Name="TxtShareLink" IsReadOnly="True" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" x:Name="BtnShareCopy" Theme="{StaticResource GhostButton}" VerticalAlignment="Center" Content="{loc:Text main.action.copy}"/>
            </Grid>
            <SarilanMetin x:Name="TxtShareStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
            <StackPanel x:Name="ToolPalette" Grid.Column="0" Orientation="Vertical" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Top" AutomationProperties.Name="{loc:Text editor.tools}">
              <ToggleButton x:Name="BtnToolSelection" Theme="{StaticResource EditorToolButton}" AutomationProperties.Name="{loc:Text editor.tool.selection}" IsChecked="True">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" RenderTransform="rotate(-135deg)" Data="{StaticResource IconPlay}" Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </ToggleButton>
              <ToggleButton x:Name="BtnToolRazor" Theme="{StaticResource EditorToolButton}" AutomationProperties.Name="{loc:Text editor.tool.razor}">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconEditor}" Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </ToggleButton>
              <ToggleButton x:Name="BtnToolRipple" Theme="{StaticResource EditorToolButton}" AutomationProperties.Name="{loc:Text editor.tool.ripple}">
                <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform" Data="{StaticResource IconConvert}" Fill="{Binding $parent[ToggleButton].Foreground}"/>
              </ToggleButton>
            </StackPanel>
            <editing:EditorTimeline x:Name="Timeline" Grid.Column="1" AutomationProperties.Name="{loc:Text editor.timeline}">
              <editing:EditorTimeline.ContextMenu>
                <ContextMenu x:Name="TimelineMenu">
                  <MenuItem x:Name="MnuSplit" Header="{loc:Text editor.split}"/>
                  <MenuItem x:Name="MnuDelete" Header="{loc:Text editor.delete}"/>
                  <Separator/>
                  <MenuItem x:Name="MnuCopy" Header="{loc:Text editor.copy}"/>
                  <MenuItem x:Name="MnuCut" Header="{loc:Text editor.cut}"/>
                  <MenuItem x:Name="MnuPaste" Header="{loc:Text editor.paste}"/>
                  <MenuItem x:Name="MnuDuplicate" Header="{loc:Text editor.duplicate}"/>
                  <MenuItem x:Name="MnuGroup" Header="{loc:Text editor.group}"/>
                  <MenuItem x:Name="MnuUngroup" Header="{loc:Text editor.ungroup}"/>
                  <Separator/>
                  <MenuItem x:Name="MnuMarkIn" Header="{loc:Text editor.mark-in}"/>
                  <MenuItem x:Name="MnuMarkOut" Header="{loc:Text editor.mark-out}"/>
                  <MenuItem x:Name="MnuDeleteRange" Header="{loc:Text editor.delete-range}"/>
                  <Separator/>
                  <MenuItem x:Name="MnuSpeed" Header="{loc:Text editor.speed}"/>
                  <MenuItem x:Name="MnuReverse" Header="{loc:Text editor.reverse}"/>
                  <MenuItem x:Name="MnuMusic" Header="{loc:Text editor.music}"/>
                  <Separator/>
                  <MenuItem x:Name="MnuAddSource" Header="{loc:Text editor.source.add}"/>
                  <MenuItem x:Name="MnuColorClip" Header="{loc:Text editor.still.color}">
                    <MenuItem x:Name="MnuColorBlack" Header="{loc:Text editor.still.black}"/>
                    <MenuItem x:Name="MnuColorWhite" Header="{loc:Text editor.still.white}"/>
                  </MenuItem>
                  <MenuItem x:Name="MnuFreeze" Header="{loc:Text editor.still.freeze}"/>
                  <MenuItem x:Name="MnuProjectSave" Header="{loc:Text editor.project.save}"/>
                  <MenuItem x:Name="MnuProjectOpen" Header="{loc:Text editor.project.open}"/>
                  <MenuItem x:Name="MnuBatchExport" Header="{loc:Text editor.batch.open}"/>
                  <MenuItem x:Name="MnuCutListExport" Header="{loc:Text editor.cutlist.export}"/>
                  <MenuItem x:Name="MnuCutListImport" Header="{loc:Text editor.cutlist.import}"/>
                  <MenuItem x:Name="MnuOtioExport" Header="{loc:Text editor.otio.export}"/>
                  <MenuItem x:Name="MnuOtioImport" Header="{loc:Text editor.otio.import}"/>
                  <MenuItem x:Name="MnuSubtitleImport" Header="{loc:Text editor.subtitle.import}"/>
                  <MenuItem x:Name="MnuSubtitleExport" Header="{loc:Text editor.subtitle.export}"/>
                </ContextMenu>
              </editing:EditorTimeline.ContextMenu>
            </editing:EditorTimeline>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
    </editing:EditorScrollViewer>
  </Grid>
</UserControl>
