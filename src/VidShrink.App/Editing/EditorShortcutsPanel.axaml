<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:VidShrink.App.Localization"
             x:Class="VidShrink.App.Editing.EditorShortcutsPanel">
  <Border Theme="{StaticResource Panel}">
    <StackPanel Spacing="{StaticResource SpaceMd}">
      <TextBlock Text="{loc:Text editor.shortcuts.title}" Theme="{StaticResource H2}"/>
      <TextBlock Text="{loc:Text editor.shortcuts.hint}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
      <Grid x:Name="Rows"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{StaticResource SpaceLg}"
            RowSpacing="{StaticResource SpaceXs}"/>
    </StackPanel>
  </Border>
</UserControl>
