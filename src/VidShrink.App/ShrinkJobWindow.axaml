<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        x:Class="VidShrink.App.ShrinkJobWindow"
        Title="VidShrink"
        Width="{StaticResource TipMaxWidth}"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}"
        Foreground="{StaticResource TextBody}">

  <Border x:Name="JobShell"
          Background="{StaticResource PanelSurface}"
          BorderBrush="{StaticResource NeonBlueBorder}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusPanel}"
          Padding="{StaticResource PanelPadding}">
    <StackPanel Spacing="{StaticResource SpaceMd}">

      <TextBlock x:Name="TxtHeadline"
                 FontSize="{StaticResource FontSizeMd}"
                 TextWrapping="Wrap"
                 MaxLines="2"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding $self.Text}"/>

      <TextBlock x:Name="TxtTarget"
                 FontSize="{StaticResource FontSizeSm}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextBody}"/>

      <ProgressBar x:Name="Progress"
                   Minimum="0" Maximum="1"
                   Height="{StaticResource ProgressBarHeight}"/>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" x:Name="RowFacts">
        <TextBlock Grid.Column="0"
                   Text="{loc:Text main.output.stage}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   Margin="{StaticResource ChipMargin}"/>
        <TextBlock Grid.Column="1" x:Name="TxtStage"
                   FontSize="{StaticResource FontSizeSm}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding $self.Text}"/>
        <TextBlock Grid.Column="2"
                   Text="{loc:Text main.output.remaining}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   Margin="{StaticResource ChipMargin}"/>
        <TextBlock Grid.Column="3" x:Name="TxtRemaining"
                   FontSize="{StaticResource FontSizeSm}"/>
      </Grid>

      <TextBlock x:Name="TxtNotice"
                 FontSize="{StaticResource FontSizeSm}"
                 Foreground="{StaticResource EmberBlaze}"
                 TextWrapping="Wrap"
                 MaxWidth="{StaticResource TipMaxWidth}"
                 IsVisible="False"/>

      <TextBlock x:Name="TxtMessage"
                 FontSize="{StaticResource FontSizeSm}"
                 TextWrapping="Wrap"
                 MaxWidth="{StaticResource TipMaxWidth}"/>

      <StackPanel x:Name="OvershootPanel" Spacing="{StaticResource SpaceSm}" IsVisible="False">
        <TextBlock Text="{loc:Text main.retry.title}"
                   FontSize="{StaticResource FontSizeMd}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtOvershoot"
                   FontSize="{StaticResource FontSizeSm}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource TipMaxWidth}"/>
        <TextBlock x:Name="TxtOvershootMeaning"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource TipMaxWidth}"/>
        <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
          <Button Theme="{StaticResource GhostButton}" x:Name="BtnOvershootAccept"
                  auto:AutomationProperties.Name="{loc:Text main.retry.accept.name}"
                  Padding="{StaticResource ButtonPaddingSm}"/>
          <Button Theme="{StaticResource GhostButton}" x:Name="BtnOvershootStop"
                  Content="{loc:Text main.retry.stop}"
                  Padding="{StaticResource ButtonPaddingSm}"/>
        </WrapPanel>
      </StackPanel>

      <StackPanel x:Name="PendingPanel" Spacing="{StaticResource SpaceXs}" IsVisible="False">
        <TextBlock x:Name="TxtPending"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"/>
        <ScrollViewer MaxHeight="{StaticResource DropDownMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PendingList" Spacing="{StaticResource SpaceXs}"/>
        </ScrollViewer>
      </StackPanel>

      <StackPanel x:Name="QueueControls" Spacing="{StaticResource SpaceSm}">
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnPause"
                Content="{loc:Text main.shrink-job.pause}"
                Padding="{StaticResource ButtonPaddingSm}"/>
        <StackPanel Spacing="{StaticResource SpaceXs}">
          <TextBlock Text="{loc:Text main.shrink-job.when-done}"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextWrapping="Wrap"/>
          <ComboBox x:Name="CmbWhenDone"
                    auto:AutomationProperties.Name="{loc:Text main.shrink-job.when-done}"
                    MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="TxtPaused"
                 Text="{loc:Text main.shrink-job.paused}"
                 FontSize="{StaticResource FontSizeSm}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <Grid x:Name="CountdownRow"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource SpaceMd}"
            IsVisible="False">
        <TextBlock Grid.Column="0"
                   x:Name="TxtCountdown"
                   FontSize="{StaticResource FontSizeSm}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Theme="{StaticResource GhostButton}" Grid.Column="1"
                x:Name="BtnCountdownCancel"
                Content="{loc:Text main.shrink-job.countdown.cancel}"
                Padding="{StaticResource ButtonPaddingSm}"
                VerticalAlignment="Center"/>
      </Grid>

      <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnOpenInApp"
                Content="{loc:Text main.shrink-job.open-in-app}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnReveal"
                Content="{loc:Text main.action.show-in-folder}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShare"
                Content="{loc:Text main.action.share}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShareCancel"
                Content="{loc:Text main.action.cancel-upload}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShareRetry"
                auto:AutomationProperties.Name="{loc:Text settings.share.retry}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnClose"
                Content="{loc:Text main.action.cancel}"
                Padding="{StaticResource ButtonPaddingSm}"/>
      </WrapPanel>

      <ProgressBar x:Name="ShareProgress" Maximum="1" Height="{StaticResource ProgressBarHeight}" IsVisible="False"/>

      <Grid x:Name="ShareLinkRow"
            IsVisible="False"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource SpaceMd}">
        <TextBox Grid.Column="0"
                 x:Name="TxtShareLink"
                 IsReadOnly="True"
                 FontFamily="{StaticResource FontMono}"
                 VerticalAlignment="Center"/>
        <Button Theme="{StaticResource GhostButton}" Grid.Column="1"
                x:Name="BtnShareCopy"
                Content="{loc:Text main.action.copy}"
                Padding="{StaticResource ButtonPaddingSm}"
                VerticalAlignment="Center"/>
      </Grid>

      <TextBlock x:Name="TxtShareStatus"
                 FontSize="{StaticResource FontSizeSm}"
                 Foreground="{StaticResource TextBody}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

    </StackPanel>
  </Border>
</Window>
