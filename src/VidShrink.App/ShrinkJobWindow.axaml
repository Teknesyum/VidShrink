<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        xmlns:share="using:VidShrink.App.Share"
        x:Class="VidShrink.App.ShrinkJobWindow"
        Title="VidShrink"
        Width="{StaticResource TipMaxWidth}"
        SizeToContent="Height"
        CanResize="False" CanMaximize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}" FontSize="{StaticResource FontSizeMd}"
        Foreground="{StaticResource TextBody}">

  <Border x:Name="JobShell"
          Background="{StaticResource PanelSurface}"
          BorderBrush="{StaticResource NeonBlueBorder}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusPanel}"
          Padding="{StaticResource PanelPadding}">
    <StackPanel Spacing="{StaticResource SpaceMd}">

      <SarilanMetin x:Name="TxtHeadline"
                 FontSize="{StaticResource FontSizeMd}"
                 TextWrapping="Wrap"
                 MaxLines="2"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding $self.Text}"/>

      <SarilanMetin x:Name="TxtTarget"
                 FontSize="{StaticResource FontSizeSm}"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource TextBody}" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <ProgressBar x:Name="Progress"
                   Minimum="0" Maximum="1"
                   Height="{StaticResource ProgressBarHeight}"/>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" x:Name="RowFacts">
        <SarilanMetin Grid.Column="0"
                   Text="{loc:Text main.output.stage}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   Margin="{StaticResource ChipMargin}"/>
        <SarilanMetin Grid.Column="1" x:Name="TxtStage"
                   FontSize="{StaticResource FontSizeSm}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding $self.Text}"/>
        <SarilanMetin Grid.Column="2"
                   Text="{loc:Text main.output.remaining}"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   Margin="{StaticResource ChipMargin}"/>
        <SarilanMetin Grid.Column="3" x:Name="TxtRemaining"
                   FontSize="{StaticResource FontSizeSm}"/>
      </Grid>

      <SarilanMetin x:Name="TxtNotice"
                 FontSize="{StaticResource FontSizeSm}"
                 Foreground="{StaticResource EmberBlaze}"
                 TextWrapping="Wrap"
                 MaxWidth="{StaticResource TipMaxWidth}"
                 IsVisible="False"/>

      <SarilanMetin x:Name="TxtMessage"
                 FontSize="{StaticResource FontSizeSm}"
                 TextWrapping="Wrap"
                 MaxWidth="{StaticResource TipMaxWidth}" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <StackPanel x:Name="OvershootPanel" Spacing="{StaticResource SpaceSm}" IsVisible="False">
        <SarilanMetin Text="{loc:Text main.retry.title}"
                   FontSize="{StaticResource FontSizeMd}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <SarilanMetin x:Name="TxtOvershoot"
                   FontSize="{StaticResource FontSizeSm}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource TipMaxWidth}"/>
        <SarilanMetin x:Name="TxtOvershootMeaning"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"
                   TextWrapping="Wrap"
                   MaxWidth="{StaticResource TipMaxWidth}"/>
        <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
          <Button Theme="{StaticResource GhostButton}" x:Name="BtnOvershootAccept"
                  auto:AutomationProperties.Name="{loc:Text main.retry.accept.name}"
                  Padding="{StaticResource ButtonPaddingSm}"/>
          <Button Theme="{StaticResource GhostButton}" x:Name="BtnOvershootStop"
                  Content="{loc:Text main.retry.stop}"
                  Padding="{StaticResource ButtonPaddingSm}"/>
        </WrapPanel>
      </StackPanel>

      <ScrollViewer x:Name="ActivePanel"
                    MaxHeight="{StaticResource DropDownMaxHeight}"
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="False">
        <StackPanel x:Name="ActiveList" Spacing="{StaticResource SpaceSm}"/>
      </ScrollViewer>

      <StackPanel x:Name="PendingPanel" Spacing="{StaticResource SpaceXs}" IsVisible="False">
        <SarilanMetin x:Name="TxtPending"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"/>
        <ScrollViewer MaxHeight="{StaticResource DropDownMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PendingList" Spacing="{StaticResource SpaceXs}"/>
        </ScrollViewer>
      </StackPanel>

      <Border x:Name="EditPanel" Theme="{StaticResource Panel}" IsVisible="False">
        <StackPanel Spacing="{StaticResource SpaceXs}">
          <SarilanMetin x:Name="TxtEditTitle"
                     FontSize="{StaticResource FontSizeSm}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <SarilanMetin Text="{loc:Text main.shrink-job.edit.target}"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextWrapping="Wrap"/>
          <TextBox x:Name="TxtEditTarget"
                   auto:AutomationProperties.Name="{loc:Text main.shrink-job.edit.target}"/>
          <ComboBox x:Name="CmbEditCodec"
                    auto:AutomationProperties.Name="{loc:Text main.shrink-job.edit}"
                    MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                    HorizontalAlignment="Stretch"/>
          <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceXs}">
            <Button Theme="{StaticResource GhostButton}" x:Name="BtnEditSave"
                    Content="{loc:Text main.shrink-job.edit.save}"
                    Padding="{StaticResource ButtonPaddingSm}"/>
            <Button Theme="{StaticResource GhostButton}" x:Name="BtnEditCancel"
                    Content="{loc:Text main.action.cancel}"
                    Padding="{StaticResource ButtonPaddingSm}"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <StackPanel x:Name="FailedPanel" Spacing="{StaticResource SpaceXs}" IsVisible="False">
        <SarilanMetin x:Name="TxtFailed"
                   FontSize="{StaticResource FontSizeSm}"
                   Foreground="{StaticResource TextBody}"/>
        <ScrollViewer MaxHeight="{StaticResource DropDownMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FailedList" Spacing="{StaticResource SpaceXs}"/>
        </ScrollViewer>
      </StackPanel>

      <StackPanel x:Name="QueueControls" Spacing="{StaticResource SpaceSm}">
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnPause"
                Content="{loc:Text main.shrink-job.pause}"
                Padding="{StaticResource ButtonPaddingSm}"/>
        <StackPanel Spacing="{StaticResource SpaceXs}">
          <SarilanMetin Text="{loc:Text main.shrink-job.when-done}"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextWrapping="Wrap"/>
          <ComboBox x:Name="CmbWhenDone"
                    auto:AutomationProperties.Name="{loc:Text main.shrink-job.when-done}"
                    MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
        <StackPanel Spacing="{StaticResource SpaceXs}">
          <SarilanMetin Text="{loc:Text main.shrink-job.start}"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextWrapping="Wrap"/>
          <ComboBox x:Name="CmbStartAt"
                    auto:AutomationProperties.Name="{loc:Text main.shrink-job.start}"
                    MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                    HorizontalAlignment="Stretch"/>
          <TextBox x:Name="TxtStartAt"
                   PlaceholderText="{loc:Text main.shrink-job.start.hint}"
                   auto:AutomationProperties.Name="{loc:Text main.shrink-job.start.hint}"/>
          <Button Theme="{StaticResource GhostButton}" x:Name="BtnSchedule"
                  Content="{loc:Text main.shrink-job.schedule}"
                  Padding="{StaticResource ButtonPaddingSm}"/>
          <SarilanMetin x:Name="TxtScheduleError"
                     Theme="{StaticResource StatusError}"
                     FontSize="{StaticResource FontSizeSm}"
                     TextWrapping="Wrap"
                     IsVisible="False"/>
        </StackPanel>
        <StackPanel x:Name="WatchPanel" Spacing="{StaticResource SpaceXs}" IsVisible="False">
          <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceXs}">
            <CheckBox x:Name="ChkWatch" Theme="{StaticResource CheckStyle}"
                      IsChecked="False"
                      VerticalAlignment="Center"
                      Content="{loc:Text main.shrink-job.watch}"
                      ToolTip.Tip="{loc:Text main.shrink-job.watch.hint}"/>
            <Button Theme="{StaticResource GhostButton}" x:Name="BtnWatchFolder"
                    Content="{loc:Text main.shrink-job.watch.choose}"
                    Padding="{StaticResource ButtonPaddingSm}"
                    VerticalAlignment="Center"/>
          </WrapPanel>
          <SarilanMetin x:Name="TxtWatchFolder"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextTrimming="CharacterEllipsis"/>
          <Grid x:Name="WatchWarning"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{StaticResource SpaceXs}"
                IsVisible="False">
            <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                  Stretch="Uniform" VerticalAlignment="Top"
                  Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
            <SarilanMetin Grid.Column="1" x:Name="TxtWatchWarning"
                       Theme="{StaticResource StatusWarning}"
                       FontSize="{StaticResource FontSizeSm}"
                       Text="{loc:Text main.shrink-job.watch.lost}"/>
          </Grid>
        </StackPanel>
      </StackPanel>

      <SarilanMetin x:Name="TxtPaused"
                 Text="{loc:Text main.shrink-job.paused}"
                 FontSize="{StaticResource FontSizeSm}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <Grid x:Name="CountdownRow"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{StaticResource SpaceMd}"
            IsVisible="False">
        <SarilanMetin Grid.Column="0"
                   x:Name="TxtCountdown"
                   FontSize="{StaticResource FontSizeSm}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Theme="{StaticResource GhostButton}" Grid.Column="1"
                x:Name="BtnCountdownCancel"
                Content="{loc:Text main.shrink-job.countdown.cancel}"
                Padding="{StaticResource ButtonPaddingSm}"
                VerticalAlignment="Center"/>
      </Grid>

      <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnOpenInApp"
                Content="{loc:Text main.shrink-job.open-in-app}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnReveal"
                Content="{loc:Text main.action.show-in-folder}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShare"
                Content="{loc:Text main.action.share}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShareCancel"
                Content="{loc:Text main.action.cancel-upload}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnShareRetry"
                auto:AutomationProperties.Name="{loc:Text settings.share.retry}"
                Padding="{StaticResource ButtonPaddingSm}"
                IsVisible="False"/>
        <Button Theme="{StaticResource GhostButton}" x:Name="BtnClose"
                Content="{loc:Text main.action.cancel}"
                Padding="{StaticResource ButtonPaddingSm}"/>
      </WrapPanel>

      <ProgressBar x:Name="ShareProgress" Maximum="1" Height="{StaticResource ProgressBarHeight}" IsVisible="False"/>

      <Grid x:Name="ShareLinkRow"
            IsVisible="False"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="{StaticResource SpaceMd}"
            RowSpacing="{StaticResource SpaceMd}">
        <TextBox Grid.Column="0"
                 x:Name="TxtShareLink"
                 IsReadOnly="True"
                 FontFamily="{StaticResource FontMono}"
                 VerticalAlignment="Center"/>
        <Button Theme="{StaticResource GhostButton}" Grid.Column="1"
                x:Name="BtnShareCopy"
                Content="{loc:Text main.action.copy}"
                Padding="{StaticResource ButtonPaddingSm}"
                VerticalAlignment="Center"/>
        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              RowDefinitions="Auto,Auto"
              RowSpacing="{StaticResource SpaceSm}"
              IsVisible="{Binding #QrShare.IsVisible}">
          <share:ShareQrCode HorizontalAlignment="Left"
                             x:Name="QrShare"
                             Link="{Binding #TxtShareLink.Text}"
                             ModuleSize="{StaticResource ShareQrModuleSize}"
                             auto:AutomationProperties.Name="{loc:Text main.share.qr}"
                             auto:AutomationProperties.HelpText="{loc:Text main.share.qr-hint}"/>
          <SarilanMetin Grid.Row="1"
                     Text="{loc:Text main.share.qr-hint}"
                     FontSize="{StaticResource FontSizeSm}"
                     Foreground="{StaticResource TextBody}"
                     TextWrapping="Wrap"/>
        </Grid>
      </Grid>

      <SarilanMetin x:Name="TxtShareStatus"
                 FontSize="{StaticResource FontSizeSm}"
                 Foreground="{StaticResource TextBody}"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

    </StackPanel>
  </Border>
</Window>
