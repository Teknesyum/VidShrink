<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VidShrink.App.App"
             Name="VidShrink"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Palette/Neon/Theme.axaml"/>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Theme.axaml"/>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Icons.axaml"/>
        <!-- T39: oynatıcıya ait belirteçler. Theme.axaml'dan sonra gelir, çünkü
             değerlerini oradaki belirteçlerden alır. -->
        <ResourceInclude Source="avares://VidShrink.App/Themes/Playback.axaml"/>
        <!-- 8b: kaydediciye ait belirteçler. Theme.axaml'dan sonra gelir, çünkü
             değerlerini oradaki belirteçlerden alır. -->
        <ResourceInclude Source="avares://VidShrink.App/Themes/Recorder.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://VidShrink.App/Themes/Controls.axaml"/>
    <!--
      Açılır pencere ve menü yerine süzülür. Hareketi azaltma açık pencerenin açılırları oynamaz.
    -->
    <Style Selector="Window:not(.reduced-motion) FlyoutPresenter, Window:not(.reduced-motion) MenuFlyoutPresenter">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="6"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!--
      İpucu balonu yerinde belirir, kaymaz: imlecin hemen altında açıldığı için dikey kayma
      metni gözün önünden çeker. Hareketi azaltma açık pencerede anında görünür.
    -->
    <Style Selector="Window:not(.reduced-motion) ToolTip">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TabControl.compact TabItem /template/ Path#TabIcon">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="Window:not(.reduced-motion) TabItem /template/ Border#TabIndicator">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionBase}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Path.chevron">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Path.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(180deg)"/>
    </Style>
    <Style Selector="Window:not(.reduced-motion) Path.chevron, Window:not(.reduced-motion) ComboBox /template/ Path#Arrow">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>

</Application>
