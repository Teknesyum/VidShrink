<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VidShrink.App.App"
             Name="VidShrink"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Palette/Neon/Theme.axaml"/>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Theme.axaml"/>
        <ResourceInclude Source="avares://VidShrink.App/Themes/Icons.axaml"/>
        <!-- T39: oynatıcıya ait belirteçler. Theme.axaml'dan sonra gelir, çünkü
             değerlerini oradaki belirteçlerden alır. -->
        <ResourceInclude Source="avares://VidShrink.App/Themes/Playback.axaml"/>
        <!-- 8b: kaydediciye ait belirteçler. Theme.axaml'dan sonra gelir, çünkü
             değerlerini oradaki belirteçlerden alır. -->
        <ResourceInclude Source="avares://VidShrink.App/Themes/Recorder.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://VidShrink.App/Themes/Controls.axaml"/>
    <!--
      Açılır pencere ve menü yerine süzülür. Hareketi azaltma açık pencerenin açılırları oynamaz.
    -->
    <Style Selector="Window:not(.reduced-motion) FlyoutPresenter, Window:not(.reduced-motion) MenuFlyoutPresenter">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionFast}" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="6"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>

</Application>
