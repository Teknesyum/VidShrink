# Satır sonları dosya türüne göre sabittir, klonlayan makinenin kabuğuna göre değil.
# CRLF satır sonlu bir kabuk betiği Linux ve macOS'ta "bad interpreter" ile düşer,
# bu yüzden .sh her yerde LF kalır.

* text=auto

*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.mp4  binary
