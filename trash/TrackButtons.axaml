<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             x:Class="VidShrink.App.Playback.TrackButtons">
  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
    <Button x:Name="BtnSubtitle"
            Content="{loc:Text player.subtitle.menu}"
            Theme="{StaticResource GhostButton}"
            VerticalAlignment="Center"
            auto:AutomationProperties.Name="{loc:Text player.subtitle.menu}"/>
    <Button x:Name="BtnAudio"
            Content="{loc:Text player.tracks.audio}"
            Theme="{StaticResource GhostButton}"
            VerticalAlignment="Center"
            auto:AutomationProperties.Name="{loc:Text player.tracks.audio}"/>
  </StackPanel>
</UserControl>
