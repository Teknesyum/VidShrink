<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:loc="clr-namespace:Teknesyum.Localization"
            Orientation="Horizontal" VerticalAlignment="Center"
            WindowChrome.IsHitTestVisibleInChrome="True">

  <StackPanel.Resources>
    <Style x:Key="SigChip" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
      <Setter Property="MinHeight" Value="{StaticResource TargetMin}"/>
      <Setter Property="MinWidth" Value="{StaticResource TargetMin}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SigLine" TargetType="Border">
      <Setter Property="Height" Value="{StaticResource FocusWidth}"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="0" ScaleY="1"/>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EOut}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0"
                                 Duration="{StaticResource TInstant}"
                                 EasingFunction="{StaticResource EIn}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SigText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </StackPanel.Resources>

  <Border Style="{StaticResource SigChip}"
          Margin="0,0,8,0" ToolTip="{loc:Str sig.supportTitle}">
    <Grid Background="Transparent">
    <StackPanel Orientation="Horizontal">
      <Canvas Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
        <Path Stroke="{StaticResource LabelSupportBrush}" StrokeThickness="2" StrokeLineJoin="Round"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M2 4.5 H8.5 V8 A2 2 0 0 1 6.5 10 H4 A2 2 0 0 1 2 8 Z
                    M8.5 5.5 H9.25 A1.25 1.25 0 0 1 9.25 8 H8.5
                    M4 1.25 V2.25 M6 1.25 V2.25"/>
      </Canvas>
      <TextBlock Style="{StaticResource SigText}">
        <Hyperlink NavigateUri="https://github.com/sponsors/Teknesyum"
                   TextDecorations="None" Foreground="{StaticResource LabelSupportBrush}" FontSize="{StaticResource LabelSupportSize}" FontWeight="{StaticResource LabelSupportWeight}"
                   RequestNavigate="OnSignatureNavigate">
          <Run Text="{loc:Str sig.support}"/>
        </Hyperlink>
      </TextBlock>
    </StackPanel>
    <Border Style="{StaticResource SigLine}" Background="{StaticResource LabelSupportBrush}"/>
    </Grid>
  </Border>

  <Border Style="{StaticResource SigChip}"
          ToolTip="{loc:Str sig.brandTitle}">
    <Grid Background="Transparent">
    <TextBlock Style="{StaticResource SigText}">
      <Hyperlink NavigateUri="https://github.com/Teknesyum"
                 TextDecorations="None" Foreground="{StaticResource LabelBrandBrush}" FontSize="{StaticResource LabelBrandSize}" FontWeight="{StaticResource LabelBrandWeight}"
                 RequestNavigate="OnSignatureNavigate">
        <Run Text="{loc:Str sig.brand}"/>
      </Hyperlink>
    </TextBlock>
    <Border Style="{StaticResource SigLine}" Background="{StaticResource LabelBrandBrush}"/>
    </Grid>
  </Border>
</StackPanel>

