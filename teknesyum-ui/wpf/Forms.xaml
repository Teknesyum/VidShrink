<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <StaticResource x:Key="TkInputMinHeight" ResourceKey="InputHeight"/>

  <Style x:Key="TkTextBox" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource TkInputMinHeight}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize2}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{StaticResource Renk1}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Renk1x30}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <!-- Varsayilan WPF hata anahati (kirmizi Adorner) KAPATILIR; palet disidir.
         Yerine asagidaki TkErrorTemplate cizer. -->
    <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource TkErrorTemplate}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- hover -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsEnabled" Value="True"/>
                <Condition Property="IsReadOnly" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </MultiTrigger>
            <!-- odak. Halkayi FocusVisualStyle cizer (Theme.xaml, cift katman,
                 gecissiz); burada yalnizca cerceve guclenir. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderDecorative}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Disabled}"/>
              <Setter Property="Foreground" Value="{StaticResource Disabled}"/>
              <Setter Property="Cursor" Value="No"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TkMonoTextBox" TargetType="TextBox" BasedOn="{StaticResource TkTextBox}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ======================================================================
       2 · Dogrulama hatasi
       ====================================================================== -->

  <ControlTemplate x:Key="TkErrorTemplate">
    <StackPanel Orientation="Vertical">
      <AdornedElementPlaceholder x:Name="ph"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Path Width="{StaticResource IconSize2}" Height="{StaticResource IconSize2}" Stretch="Uniform"
              Margin="0,1,8,0"
              AutomationProperties.IsOffscreenBehavior="Offscreen"
              Fill="{StaticResource DangerText}"
              Data="M8 1 L15 14 L1 14 Z M8 5.5 L8 10 M8 11.5 L8 12.5"/>
        <TextBlock Text="{Binding [0].ErrorContent}"
                   Foreground="{StaticResource DangerText}"
                   FontFamily="{StaticResource FontSans}"
                   FontSize="{StaticResource FontSize1}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </ControlTemplate>

  <Style x:Key="TkErrorText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DangerText}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSize1}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <!-- Metne glow verilmez (SKILL §2); tek istisna hero sayidir. -->
    <Setter Property="Effect" Value="{x:Null}"/>
  </Style>

  <!-- ======================================================================
       3 · Modal / diyalog - desktop.md'nin MessageBox yasaginin ikamesi
       ====================================================================== -->

  <StaticResource x:Key="TkModalMaxHeightRatio" ResourceKey="ModalMaxRatio"/>

  <Style x:Key="TkModalWindow" TargetType="Window">
    <Setter Property="Width" Value="{StaticResource ModalWidth}"/>
    <Setter Property="SizeToContent" Value="Height"/>
    <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
    <Setter Property="ShowInTaskbar" Value="False"/>
    <Setter Property="ResizeMode" Value="NoResize"/>
    <Setter Property="WindowStyle" Value="None"/>
    <Setter Property="AllowsTransparency" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
  </Style>

  <Style x:Key="TkModalPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform ScaleX="{StaticResource ScalePress}" ScaleY="{StaticResource ScalePress}"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Storyboard x:Key="TkModalEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="{StaticResource TBase}"
                     EasingFunction="{StaticResource EOut}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                     From="{StaticResource ScalePress}" To="1"
                     Duration="{StaticResource TBase}"
                     EasingFunction="{StaticResource EOut}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                     From="{StaticResource ScalePress}" To="1"
                     Duration="{StaticResource TBase}"
                     EasingFunction="{StaticResource EOut}"/>
  </Storyboard>

  <Storyboard x:Key="TkModalExit">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="{StaticResource TFast}"
                     EasingFunction="{StaticResource EIn}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                     To="{StaticResource ScalePress}"
                     Duration="{StaticResource TFast}"
                     EasingFunction="{StaticResource EIn}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                     To="{StaticResource ScalePress}"
                     Duration="{StaticResource TFast}"
                     EasingFunction="{StaticResource EIn}"/>
  </Storyboard>

  <SolidColorBrush x:Key="TkModalScrim" Color="#99000000"/>

  <Style x:Key="TkModalOverlay" TargetType="Grid">
    <Setter Property="Background" Value="{StaticResource TkModalScrim}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
    <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="None"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <sys:Boolean x:Key="TkModalConfirmScrimDismiss">False</sys:Boolean>
  <sys:Boolean x:Key="TkModalInfoScrimDismiss">True</sys:Boolean>

  <!-- ======================================================================
       4 · Toast
       ====================================================================== -->

  <sys:Int32 x:Key="TkToastMaxCount">3</sys:Int32>

  <Style x:Key="TkToastStack" TargetType="ItemsControl">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="{StaticResource PanelPadding}"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TkToast" TargetType="Border" BasedOn="{StaticResource Panel}">
    <Setter Property="Width" Value="{StaticResource ToastWidth}"/>
    <Setter Property="Margin" Value="0,12,0,0"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="TextElement.FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize1}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TranslateTransform X="{StaticResource EntryOffset}"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TkToastSuccess" TargetType="Border" BasedOn="{StaticResource TkToast}">
    <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
  </Style>
  <Style x:Key="TkToastWarning" TargetType="Border" BasedOn="{StaticResource TkToast}">
    <Setter Property="BorderBrush" Value="{StaticResource Warning50}"/>
  </Style>
  <Style x:Key="TkToastDanger" TargetType="Border" BasedOn="{StaticResource TkToast}">
    <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
  </Style>

  <Style x:Key="TkToastTitleSuccess" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Success}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TkToastTitleWarning" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TkToastTitleDanger" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DangerText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Kapat carpisi: hedef alan 24x24 (SKILL §5.3), simge 14.
       AutomationProperties.Name zorunlu: "Bildirimi kapat". -->
  <Style x:Key="TkToastClose" TargetType="Button">
    <Setter Property="Width" Value="{StaticResource TargetMin}"/>
    <Setter Property="Height" Value="{StaticResource TargetMin}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="Bildirimi kapat"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource Radius}">
            <Path x:Name="ic" Width="{StaticResource IconSize1}" Height="{StaticResource IconSize1}" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                  Data="M1 1 L13 13 M13 1 L1 13"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ic" Property="Stroke" Value="{StaticResource Renk1}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Storyboard x:Key="TkToastEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="{StaticResource TFast}"
                     EasingFunction="{StaticResource EOut}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                     From="{StaticResource EntryOffset}" To="0"
                     Duration="{StaticResource TFast}"
                     EasingFunction="{StaticResource EOut}"/>
  </Storyboard>

  <Storyboard x:Key="TkToastExit">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="{StaticResource TInstant}"
                     EasingFunction="{StaticResource EIn}"/>
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                     To="{StaticResource EntryOffset}"
                     Duration="{StaticResource TInstant}"
                     EasingFunction="{StaticResource EIn}"/>
  </Storyboard>

  <sys:Int32 x:Key="TkToastLifeMs">6000</sys:Int32>

  <Style x:Key="TkToastTimer" TargetType="Border">
    <Setter Property="Tag" Value="calisiyor"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Tag" Value="durdu"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Tag" Value="durdu"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
